<Window x:Class="JTSA.TomozotchiPlugin.TomozotchiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ともぞっち" Width="860" Height="620"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#FF303030">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF454545"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <!-- 標準のプルダウンは閉じた状態と一覧の背景が明るいため、文字色は既定（黒）のままにする -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#FF707070"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FF303030"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="#FF303030" Margin="0,0,0,-1"/>
                            <Border Grid.Row="1" Background="#FF303030" BorderBrush="#FF666666" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF4A4A4A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF454545"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="LightSeaGreen"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#FF80CBC4" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TabControl>
            <TabItem Header="ゲージ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="↑" Width="32" Height="28" Margin="0,0,4,4" Click="MoveUpButton_Click"/>
                            <Button Content="↓" Width="32" Height="28" Margin="0,0,12,4" Click="MoveDownButton_Click"/>
                            <Button Content="−1" Width="40" Height="28" Margin="0,0,4,4" Click="MinusButton_Click"/>
                            <Button Content="+1" Width="40" Height="28" Margin="0,0,12,4" Click="PlusButton_Click"/>
                            <TextBox x:Name="ValueTextBox" Width="48" Height="28" Margin="0,0,4,4" VerticalContentAlignment="Center"/>
                            <Button Content="値を設定" Width="72" Height="28" Margin="0,0,12,4" Click="SetValueButton_Click"/>
                            <Button Content="リセット" Width="72" Height="28" Margin="0,0,4,4" Click="ResetButton_Click"/>
                            <Button Content="全リセット" Width="80" Height="28" Margin="0,0,4,4" Click="ResetAllButton_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="StatsListBox" DisplayMemberPath="Label" FontSize="14"
                                 SelectionChanged="StatsListBox_SelectionChanged"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ゲージ定義" Foreground="White" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock Text="名前"/>
                            <TextBox x:Name="NameTextBox" Height="28" Margin="0,4,0,8"/>
                            <TextBlock Text="最大値"/>
                            <TextBox x:Name="MaxTextBox" Height="28" Margin="0,4,0,8"/>
                            <TextBlock Text="初期値（空なら最大値）"/>
                            <TextBox x:Name="InitialTextBox" Height="28" Margin="0,4,0,8"/>
                            <TextBlock Text="減少間隔（分・0 で減らない）"/>
                            <TextBox x:Name="IntervalTextBox" Height="28" Margin="0,4,0,8"/>
                            <TextBlock Text="マーク"/>
                            <TextBox x:Name="MarkTextBox" Height="28" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="追加" Width="72" Height="28" Margin="0,0,8,0" Click="AddStatButton_Click"/>
                                <Button Content="更新" Width="72" Height="28" Margin="0,0,8,0" Click="UpdateStatButton_Click"/>
                                <Button Content="削除" Width="72" Height="28" Click="RemoveStatButton_Click"/>
                            </StackPanel>

                            <TextBlock Text="プリセット" Foreground="White" FontSize="16" Margin="0,20,0,8"/>
                            <TextBlock Text="名前（入力して保存、選んで読み込み）" TextWrapping="Wrap"/>
                            <ComboBox x:Name="PresetComboBox" IsEditable="True" Height="28" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Content="保存" Width="64" Height="28" Margin="0,0,8,8" Click="SavePresetButton_Click"/>
                                <Button Content="読み込み" Width="72" Height="28" Margin="0,0,8,8" Click="LoadPresetButton_Click"/>
                                <Button Content="削除" Width="64" Height="28" Margin="0,0,8,8" Click="DeletePresetButton_Click"/>
                                <Button Content="ファイルから読み込み" Width="140" Height="28" Margin="0,0,8,8" Click="ImportButton_Click"/>
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="ファイルから読み込みでは tamagotchi-twitch の game_config.json や savedata の JSON を使えます。チャネポ割り当てを含むファイルなら割り当ても置き換えます。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="チャネポ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ActionsListBox" DisplayMemberPath="Label" Margin="0,0,12,0"
                             SelectionChanged="ActionsListBox_SelectionChanged"/>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="リワード"/>
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="一覧更新" Width="72" Height="28" Margin="8,0,0,0" Click="RefreshRewardsButton_Click"/>
                                <ComboBox x:Name="RewardComboBox" Height="28" DisplayMemberPath="Title" SelectedValuePath="Id"/>
                            </DockPanel>
                            <TextBlock Text="動作"/>
                            <ComboBox x:Name="ActionComboBox" Height="28" Margin="0,4,0,8" SelectionChanged="ActionComboBox_SelectionChanged">
                                <ComboBoxItem Content="ゲージを増減" Tag="modify"/>
                                <ComboBoxItem Content="ゲージを追加" Tag="addStat"/>
                                <ComboBoxItem Content="ゲージを削除" Tag="removeStat"/>
                            </ComboBox>
                            <StackPanel x:Name="TargetPanel">
                                <TextBlock Text="対象ゲージ（今ないゲージ名も入力できます）" TextWrapping="Wrap"/>
                                <ComboBox x:Name="TargetComboBox" IsEditable="True" Height="28" Margin="0,4,0,8"/>
                            </StackPanel>
                            <StackPanel x:Name="AmountPanel">
                                <TextBlock Text="増減量（マイナスで減少）"/>
                                <TextBox x:Name="AmountTextBox" Height="28" Margin="0,4,0,8"/>
                            </StackPanel>
                            <StackPanel x:Name="AddStatPanel">
                                <TextBlock Text="追加するゲージの名前"/>
                                <TextBox x:Name="AddNameTextBox" Height="28" Margin="0,4,0,8"/>
                                <TextBlock Text="最大値"/>
                                <TextBox x:Name="AddMaxTextBox" Height="28" Margin="0,4,0,8"/>
                                <TextBlock Text="初期値（空なら最大値）"/>
                                <TextBox x:Name="AddInitialTextBox" Height="28" Margin="0,4,0,8"/>
                                <TextBlock Text="減少間隔（分・0 で減らない）"/>
                                <TextBox x:Name="AddIntervalTextBox" Height="28" Margin="0,4,0,8"/>
                                <TextBlock Text="マーク"/>
                                <TextBox x:Name="AddMarkTextBox" Height="28" Margin="0,4,0,8"/>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="保存" Width="64" Height="28" Margin="0,0,8,8" Click="SaveActionButton_Click"/>
                                <Button Content="削除" Width="64" Height="28" Margin="0,0,8,8" Click="RemoveActionButton_Click"/>
                                <Button Content="テスト実行" Width="88" Height="28" Margin="0,0,8,8" Click="TestActionButton_Click"/>
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Text="1 つのリワードに割り当てられる動作は 1 つです。保存すると同じリワードの割り当ては置き換わります。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="表示">
                <StackPanel Margin="12" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="配信拡張（http://localhost:8026/expansion）の 1920×1080 上の位置と大きさです。OBS に別のソースを追加する必要はありません。"/>
                    <TextBlock Text="X"/>
                    <TextBox x:Name="OverlayXTextBox" Height="28" Margin="0,4,0,8"/>
                    <TextBlock Text="Y"/>
                    <TextBox x:Name="OverlayYTextBox" Height="28" Margin="0,4,0,8"/>
                    <TextBlock Text="幅"/>
                    <TextBox x:Name="OverlayWidthTextBox" Height="28" Margin="0,4,0,8"/>
                    <TextBlock Text="高さ"/>
                    <TextBox x:Name="OverlayHeightTextBox" Height="28" Margin="0,4,0,8"/>
                    <Button Content="適用" Width="80" Height="28" HorizontalAlignment="Left" Click="ApplyOverlayButton_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

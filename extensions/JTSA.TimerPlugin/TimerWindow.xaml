<Window x:Class="JTSA.TimerPlugin.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JTSA タイマー" Width="780" Height="365" MinWidth="780" MinHeight="365"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF303030" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF606060"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF454545"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF454545"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#FF4A4A4A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="/JTSA;component/Resources/jtsa.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPane" Margin="0,0,14,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TimeTextBlock" Text="05:00" Foreground="White"
                       FontFamily="Consolas" FontSize="72" FontWeight="Bold"
                       Margin="0" Padding="0" LineHeight="72"
                       LineStackingStrategy="BlockLineHeight"
                       HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="時間" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="MinutesTextBox" Text="5" Width="72" Height="30" FontSize="16"
                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="分" Foreground="White" VerticalAlignment="Center" Margin="6,0,12,0"/>
                    <Button x:Name="StartStopButton" Content="開始" Width="82" Height="30"
                            Margin="0,0,6,0" Click="StartStopButton_Click"/>
                    <Button Content="リセット" Width="82" Height="30" Click="ResetButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="終了音" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="CompletionSoundNameTextBlock" Text="標準音" Foreground="White"
                               Width="86" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button Content="変更" Width="48" Height="25" Margin="5,0,4,0"
                            Click="ChangeCompletionSoundButton_Click"/>
                    <Button Content="標準" Width="48" Height="25" Margin="0,0,4,0"
                            Click="UseDefaultCompletionSoundButton_Click"/>
                    <Button Content="試聴" Width="48" Height="25"
                            Click="PreviewCompletionSoundButton_Click"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text=""
                       Foreground="LightGray" HorizontalAlignment="Center" Margin="0,5,0,0"/>

            <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,8"
                    Background="#FF3A3A3A" BorderBrush="#FF606060" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="ShowInExpansionCheckBox" Content="配信拡張のブラウザソースに表示"
                              IsChecked="True" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,8"
                              Checked="ShowInExpansionCheckBox_Changed" Unchecked="ShowInExpansionCheckBox_Changed"/>
                    <TextBlock Text="表示位置・倍率" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,7">
                        <TextBlock Text="X" Width="18" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBox x:Name="OverlayXTextBox" Text="710" Width="48" Height="24" Margin="0,0,5,0"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 TextChanged="OverlayBoundsTextBox_TextChanged"/>
                        <Slider Width="135" Minimum="0" Maximum="1920" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,14,0"
                                Value="{Binding Text, ElementName=OverlayXTextBox, Mode=TwoWay}"/>
                        <TextBlock Text="Y" Width="18" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBox x:Name="OverlayYTextBox" Text="70" Width="48" Height="24" Margin="0,0,5,0"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 TextChanged="OverlayBoundsTextBox_TextChanged"/>
                        <Slider Width="135" Minimum="0" Maximum="1080" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Text, ElementName=OverlayYTextBox, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="倍率" Width="36" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBox x:Name="OverlayScaleTextBox" Text="100" Width="48" Height="24" Margin="0,0,5,0"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 TextChanged="OverlayBoundsTextBox_TextChanged"/>
                        <Slider Width="160" Minimum="25" Maximum="200" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Text, ElementName=OverlayScaleTextBox, Mode=TwoWay}"/>
                        <TextBlock Text="%" Foreground="LightGray" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Padding="10,8" Background="#FF3A3A3A"
                BorderBrush="#FF606060" BorderThickness="1"
                Height="{Binding ActualHeight, ElementName=LeftPane}"
                VerticalAlignment="Top">
            <ListBox ItemsSource="{Binding History}" Margin="0"
                     MouseDoubleClick="HistoryListBox_MouseDoubleClick"
                     Background="#FF303030" Foreground="White" BorderBrush="#FF555555"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="46"/>
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="22"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>

<Window x:Class="JTSA.TimerPlugin.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTSA タイマー" Width="460" Height="260" MinWidth="380" MinHeight="220"
        WindowStartupLocation="CenterOwner" Background="#FF303030">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TimeTextBlock" Text="05:00" Foreground="White"
                   FontFamily="Consolas" FontSize="72" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
            <TextBox x:Name="MinutesTextBox" Text="5" Width="56" Height="30" FontSize="16"
                     VerticalContentAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="分" Foreground="White" VerticalAlignment="Center" Margin="6,0,18,0"/>
            <Button Content="開始" Width="76" Height="30" Margin="0,0,6,0" Click="StartButton_Click"/>
            <Button Content="停止" Width="76" Height="30" Margin="0,0,6,0" Click="StopButton_Click"/>
            <Button Content="リセット" Width="76" Height="30" Click="ResetButton_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text="時間を設定して開始してください。"
                   Foreground="LightGray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        <CheckBox Grid.Row="3" x:Name="ShowInExpansionCheckBox" Content="配信拡張のブラウザソースに表示"
                  IsChecked="True" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"
                  Checked="ShowInExpansionCheckBox_Changed" Unchecked="ShowInExpansionCheckBox_Changed"/>
    </Grid>
</Window>

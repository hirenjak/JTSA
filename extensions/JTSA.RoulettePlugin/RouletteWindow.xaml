<Window x:Class="JTSA.RoulettePlugin.RouletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTSA ルーレット" Width="720" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FF303030">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="候補（1行に1件）" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="空行と前後の空白は除外されます。" Foreground="LightGray" Margin="0,3,0,8"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="EntriesTextBox" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Padding="8" FontSize="16" Foreground="White" Background="#FF454545"
                 BorderBrush="#FF707070" TextChanged="EntriesTextBox_TextChanged">候補1&#x0a;候補2&#x0a;候補3</TextBox>

        <Border Grid.Row="2" Margin="0,14,0,10" Padding="12" MinHeight="330"
                Background="#FF202020" BorderBrush="#FF777777" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="310" Height="310" HorizontalAlignment="Center">
                    <Canvas x:Name="WheelCanvas" Width="310" Height="310"
                            RenderTransformOrigin="0.5,0.5"/>
                    <Polygon Points="140,0 170,0 155,34" Fill="#FFFFD166"
                             Stroke="White" StrokeThickness="2" Panel.ZIndex="2"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock x:Name="ResultCaptionTextBlock" Text="抽選結果" Foreground="LightGray"
                               HorizontalAlignment="Center" FontSize="13"/>
                    <TextBlock x:Name="ResultTextBlock" Text="―" Foreground="#FFFFD166"
                               HorizontalAlignment="Center" FontSize="34" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="SpinButton" Content="ルーレット開始" Width="145" Height="36"
                    Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                    Click="SpinButton_Click"/>
            <Button Content="結果をクリア" Width="120" Height="36" Margin="8,0,0,0"
                    Foreground="White" Background="#FF565656" BorderBrush="#FF777777"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <CheckBox x:Name="ShowInExpansionCheckBox" Content="配信拡張のブラウザソースに表示"
                      IsChecked="True" Foreground="White"
                      Checked="ShowInExpansionCheckBox_Changed" Unchecked="ShowInExpansionCheckBox_Changed"/>
            <TextBlock x:Name="CandidateCountTextBlock" Foreground="LightGray" Margin="18,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

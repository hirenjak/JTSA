<Window x:Class="JTSA.RoulettePlugin.RouletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JTSA ルーレット" Width="720" Height="860" MinWidth="560" MinHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF303030" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#FF606060"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#FF505050"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF454545"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="PluginButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF565656"/>
                    <Setter Property="Foreground" Value="#FF303030"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PluginPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PluginButtonBaseStyle}">
            <Setter Property="Background" Value="#FF285653"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
        </Style>
        <Style x:Key="PluginSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PluginButtonBaseStyle}"/>
    </Window.Resources>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="#FF4A4A4A">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="/JTSA;component/Resources/jtsa.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="候補" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CandidateCountTextBlock" Foreground="LightGray" Margin="8,0,12,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8"
                Background="#FF3A3A3A" BorderBrush="#FF606060" BorderThickness="1">
        <StackPanel>
        <CheckBox x:Name="ShowInExpansionCheckBox" Content="配信拡張のブラウザソースに表示"
                  IsChecked="True" Foreground="White" Margin="0,0,0,8"
                  Checked="ShowInExpansionCheckBox_Changed" Unchecked="ShowInExpansionCheckBox_Changed"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="表示位置・倍率" Foreground="White" FontWeight="SemiBold"
                       Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock Text="X" Foreground="LightGray" VerticalAlignment="Center"/>
            <TextBox x:Name="OverlayXTextBox" Text="485" Width="42" Height="24" Margin="3,0,3,0"
                     VerticalContentAlignment="Center" TextAlignment="Right"
                     TextChanged="OverlayBoundsTextBox_TextChanged"/>
            <Slider Width="100" Minimum="0" Maximum="1920" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,7,0"
                    Value="{Binding Text, ElementName=OverlayXTextBox, Mode=TwoWay}"/>
            <TextBlock Text="Y" Foreground="LightGray" VerticalAlignment="Center"/>
            <TextBox x:Name="OverlayYTextBox" Text="40" Width="42" Height="24" Margin="3,0,3,0"
                     VerticalContentAlignment="Center" TextAlignment="Right"
                     TextChanged="OverlayBoundsTextBox_TextChanged"/>
            <Slider Width="100" Minimum="0" Maximum="1080" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,7,0"
                    Value="{Binding Text, ElementName=OverlayYTextBox, Mode=TwoWay}"/>
            <TextBlock Text="倍率" Foreground="LightGray" VerticalAlignment="Center"/>
            <TextBox x:Name="OverlayScaleTextBox" Text="100" Width="42" Height="24" Margin="3,0,3,0"
                     VerticalContentAlignment="Center" TextAlignment="Right"
                     TextChanged="OverlayBoundsTextBox_TextChanged"/>
            <Slider Width="130" Minimum="25" Maximum="200" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding Text, ElementName=OverlayScaleTextBox, Mode=TwoWay}"/>
            <TextBlock Text="%" Foreground="LightGray" Margin="3,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <DockPanel x:Name="CandidatesEditorPanel" Margin="0,0,12,0">
            <Button DockPanel.Dock="Bottom" Content="＋ 候補を追加" Height="32" Margin="0,6,0,0"
                    Style="{StaticResource PluginPrimaryButtonStyle}"
                    Click="AddCandidateButton_Click"/>
            <ListBox x:Name="CandidatesListBox" ItemsSource="{Binding Candidates}"
                     Background="#FF3A3A3A" BorderBrush="#FF707070" Padding="4"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" Padding="7,4" Foreground="White"
                                     Background="#FF454545" BorderBrush="#FF707070"
                                     TextChanged="CandidateTextBox_TextChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <TextBlock Text="重み" Foreground="LightGray" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                         Width="34" Padding="3,4" TextAlignment="Right"
                                         ToolTip="1以上の整数"
                                         TextChanged="CandidateWeightTextBox_TextChanged"/>
                                <TextBlock Text="{Binding ProbabilityText}" Foreground="#FF9FD8CF"
                                           FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="－" Margin="5,0,0,0"
                                    FontSize="18" Foreground="#FFFF6F78" Background="#FF454545"
                                    BorderBrush="#FF707070" ToolTip="この候補を削除"
                                    Tag="{Binding}" Click="RemoveCandidateButton_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Padding="10" Background="#FF3A3A3A"
                BorderBrush="#FF606060" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="保存リスト" Foreground="White" FontWeight="SemiBold"/>
                <ComboBox x:Name="SavedCandidateListComboBox" Height="28" Margin="0,7,0,0"
                          IsEditable="True" ItemsSource="{Binding SavedCandidateLists}"
                          DisplayMemberPath="Name"/>
                <Grid Margin="0,7,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="保存" Height="27" Margin="0,0,3,0"
                            Style="{StaticResource PluginPrimaryButtonStyle}"
                            Click="SaveCandidateListButton_Click"/>
                    <Button Grid.Column="1" Content="読込" Height="27" Margin="3,0"
                            Style="{StaticResource PluginSecondaryButtonStyle}"
                            Click="LoadCandidateListButton_Click"/>
                    <Button Grid.Column="2" Content="削除" Height="27" Margin="3,0,0,0"
                            Style="{StaticResource PluginSecondaryButtonStyle}"
                            Click="DeleteCandidateListButton_Click"/>
                </Grid>
                <Border Height="1" Background="#FF606060" Margin="0,0,0,12"/>
                <TextBlock Text="チャンネルポイント" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="交換時に候補へ自動追加" Foreground="LightGray" FontSize="11" Margin="0,3,0,8"/>
                <ComboBox x:Name="ChannelPointRewardComboBox" Height="28"
                          ItemsSource="{Binding ChannelPointRewards}"
                          DisplayMemberPath="Title" SelectedValuePath="Id"
                          SelectionChanged="ChannelPointRewardComboBox_SelectionChanged"
                          DropDownOpened="ChannelPointRewardComboBox_DropDownOpened"/>
                <TextBlock Text="通常報酬：ユーザー名&#x0a;入力付き報酬：入力テキスト"
                           Foreground="#FF9FD8CF" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,10" Padding="12" MinHeight="420"
                Background="#FF202020" BorderBrush="#FF777777" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="330"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Width="310" Height="310" HorizontalAlignment="Center">
                    <wv2:WebView2 x:Name="WheelBrowser" Width="310" Height="310"
                                  DefaultBackgroundColor="Transparent" IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Column="1" Margin="12,4,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ElapsedSpinTimeTextBlock" Text="残り時間 4.0 秒"
                                   Foreground="#FF9FD8CF" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="停止までの時間（秒）" Foreground="LightGray" FontSize="11"/>
                        <TextBox x:Name="SpinDurationSecondsTextBox" Text="4" Height="25" Margin="0,3,0,10"
                                 Padding="5,2" TextAlignment="Right"
                                 TextChanged="SpinTimingTextBox_TextChanged"/>
                        <Button x:Name="SpinButton" Content="ルーレット開始" Height="36"
                                Style="{StaticResource PluginPrimaryButtonStyle}"
                                Click="SpinButton_Click"/>
                        <Button x:Name="DeleteResultButton" Content="結果を削除"
                                Height="36" Margin="0,8,0,0" IsEnabled="False"
                                Style="{StaticResource PluginPrimaryButtonStyle}"
                                Click="DeleteResultButton_Click"/>
                        <Button x:Name="RestoreRemovedCandidateButton" Content="削除した項目を戻す"
                                Height="36" Margin="0,8,0,0" IsEnabled="False"
                                Style="{StaticResource PluginSecondaryButtonStyle}"
                                Click="RestoreRemovedCandidateButton_Click"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="結果をクリア" Height="36"
                            Style="{StaticResource PluginSecondaryButtonStyle}"
                            Click="ClearButton_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,4,8,0">
                    <TextBlock x:Name="ResultCaptionTextBlock" Text="" Foreground="LightGray"
                               HorizontalAlignment="Center" FontSize="13"/>
                    <TextBlock x:Name="ResultTextBlock" Text="―" Foreground="#FFFFD166"
                               HorizontalAlignment="Center" FontSize="34" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </Grid>
    </Border>
</Window>

<Window x:Class="JTSA.MultiPlatformPlugin.MultiPlatformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTSA 外部プラットフォーム連携" Width="320" Height="690" MinWidth="280" MinHeight="420"
        WindowStartupLocation="Manual" Background="#FF303030" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="#FFFAFAFA"/><Setter Property="Foreground" Value="#FF202020"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="#FFFAFAFA"/><Setter Property="Foreground" Value="#FF202020"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="外部プラットフォーム連携" FontSize="20" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="共通タイトル"/>
                <TextBox x:Name="TitleTextBox" MaxLength="100"/>
            </StackPanel>
            <Button Grid.Column="1" Content="JTSAから取り込む" VerticalAlignment="Center" Click="ImportButton_Click"/>
        </Grid>
        <TabControl Grid.Row="2" Background="#FF3A3A3A" Foreground="Black">
            <TabItem Header="YouTube">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Foreground="White" Text="アクセストークン（youtube または youtube.force-ssl 権限）"/>
                        <PasswordBox x:Name="YouTubeTokenBox"/>
                        <TextBlock Foreground="White" Text="配信ID（空欄なら現在配信中のライブを自動選択）"/>
                        <TextBox x:Name="YouTubeBroadcastIdBox"/>
                        <TextBlock Foreground="White" Text="カテゴリ"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="YouTubeCategoryComboBox" MinHeight="30" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" Background="White" Foreground="Black"/>
                            <Button Grid.Column="1" Content="一覧取得" Margin="6,0,0,0" Click="LoadYouTubeCategoriesButton_Click"/>
                        </Grid>
                        <TextBlock Foreground="White" Text="Live Chat ID（空欄なら現在配信中のライブから取得）"/>
                        <TextBox x:Name="YouTubeLiveChatIdBox"/>
                        <WrapPanel>
                            <Button Content="タイトル・カテゴリを反映" Click="UpdateYouTubeButton_Click"/>
                            <Button x:Name="YouTubeChatButton" Content="コメント取得を開始" Click="YouTubeChatButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Kick">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Foreground="White" Text="アクセストークン（channel:write 権限）"/>
                        <PasswordBox x:Name="KickTokenBox"/>
                        <TextBlock Foreground="White" Text="カテゴリ検索（3文字以上）"/>
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="KickCategorySearchBox" Margin="0"/>
                            <Button Grid.Column="1" Content="検索" Margin="6,0,0,0" Click="SearchKickCategoriesButton_Click"/>
                        </Grid>
                        <ComboBox x:Name="KickCategoryComboBox" MinHeight="30" Margin="0,0,0,10"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" Background="White" Foreground="Black"/>
                        <TextBlock Foreground="White" Text="チャンネル名（コメント取得用。URL末尾の名前）"/>
                        <TextBox x:Name="KickChannelSlugBox"/>
                        <WrapPanel>
                            <Button Content="タイトル・カテゴリを反映" Click="UpdateKickButton_Click"/>
                            <Button x:Name="KickChatButton" Content="コメント取得を開始" Click="KickChatButton_Click"/>
                        </WrapPanel>
                        <TextBlock Margin="4,12,4,0" Foreground="#FFFFCC66" TextWrapping="Wrap"
                                   Text="Kickのコメント取得は公開Webチャット接続を利用する簡易対応です。Kick側の仕様変更時は更新が必要になる場合があります。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="#FF222222">
            <TextBlock x:Name="StatusTextBlock" Text="準備完了" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="JTSA.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:JTSA.Controls"
        mc:Ignorable="d"
        Title="ChatOverlayWindow"
        Width="300" Height="320"
        MinWidth="220" MinHeight="160"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <controls:OverlayNameBrightnessConverter x:Key="OverlayNameBrightnessConverter"/>
    </Window.Resources>

    <Grid Background="Transparent">

        <!-- 少しだけ黒背景を付ける場合 -->
        <Border x:Name="WindowBackgroundBorder"
                Background="#44000000"
                CornerRadius="12"
                Padding="12"
                Margin="10">

            <ListBox x:Name="OverlayTwitchChatListBox"
                     ItemsSource="{Binding OverlayTwitchChatFormList}"
                     d:ItemsSource="{d:SampleData ItemCount = 3}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Stretch">
                            <StackPanel Margin="8, 4, 8, 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DataContext.IconColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="26" Height="28"
                                             Visibility="{Binding DataContext.ShowUserIcons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="{Binding HexColor, Converter={StaticResource OverlayNameBrightnessConverter}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        </Grid>

                                        <!-- メッセージ -->
                                        <controls:TwitchMessageRichTextBox 
                                            Grid.Row="1" Grid.Column="0" 
                                            MessageParts="{Binding MessageParts}"
                                            Foreground="{Binding MessageColor}" 
                                            FontSize="{Binding DataContext.OverlayFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            IsUndoEnabled="False"
                                            IsTabStop="False"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Hidden"/>
                                    </Grid>
                                </Grid>

                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="1" 
                                                Orientation="Vertical">
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Border>

        <!-- AllowsTransparency=True のウィンドウは標準枠でリサイズできないため、
             位置調整モード中だけ専用グリップを表示する。 -->
        <Thumb x:Name="ResizeGrip"
               Width="22" Height="22"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,4,4"
               Cursor="SizeNWSE"
               Visibility="Collapsed"
               DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 4,18 L 18,4 M 10,18 L 18,10 M 16,18 L 18,16"
                              Stroke="White"
                              StrokeThickness="2"
                              Opacity="0.9"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>

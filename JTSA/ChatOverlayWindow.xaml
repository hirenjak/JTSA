<Window x:Class="JTSA.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ChatOverlayWindow"
        Width="300"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Background="Transparent">

        <!-- 少しだけ黒背景を付ける場合 -->
        <Border x:Name="WindowBackgroundBorder"
                Background="#44000000"
                CornerRadius="12"
                Padding="12"
                Margin="10">

            <ListBox x:Name="OverlayTwitchChatListBox"
                     ItemsSource="{Binding OverlayTwitchChatFormList}"
                     d:ItemsSource="{d:SampleData ItemCount = 3}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Stretch">
                            <StackPanel Margin="8, 4, 8, 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="26" Height="28">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="{Binding ColorHex}"
                                                   FontSize="10" >
                                            </TextBlock>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White"
                                                   FontSize="10" >
                                            </TextBlock>
                                        </Grid>

                                        <!-- メッセージ -->
                                        <TextBox  Grid.Row="1" Grid.Column="0" 
                                              Text="{Binding Message}"
                                              IsReadOnly="True"
                                              BorderThickness="0"
                                              Background="Transparent" CaretBrush="Transparent"
                                              FocusVisualStyle="{x:Null}"
                                              AcceptsReturn="True"
                                              Padding="0" Margin="0"
                                              d:Text="Message"
                                              TextWrapping="Wrap"
                                              HorizontalAlignment="Stretch"
                                              Foreground="{Binding MessageColor}" 
                                              FontSize="12" >
                                        </TextBox>
                                    </Grid>
                                </Grid>

                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="1" 
                                                Orientation="Vertical">
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Border>
    </Grid>
</Window>

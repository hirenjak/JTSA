<Window x:Class="JTSA.StreamExpansionPlaceholderHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="チャット用プレースホルダー" Icon="Resources/jtsa.ico"
        Width="760" Height="600" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="#FF303030">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:CategoryStyleTitleBar/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">
     <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="チャット用プレースホルダー"/>
     <TextBlock Margin="0,8,0,16" Foreground="LightGray" TextWrapping="Wrap"
                Text="チャットやOBSテキストの本文に入力すると、トリガー受信時の情報へ自動的に置き換わります。"/>
     <ItemsControl ItemsSource="{Binding PlaceholderItems}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Grid Margin="0,0,0,7">
         <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent"
                  BorderThickness="0" Padding="0" IsReadOnly="True" Cursor="IBeam" Text="{Binding Token}"/>
         <TextBlock Grid.Column="1" Foreground="White" TextWrapping="Wrap" Text="{Binding Description}"/>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Margin="0,10,0,0" Foreground="LightGray" TextWrapping="Wrap"
                Text="※ 対応する情報がないトリガーや、Twitchから情報を取得できなかった場合は空文字になります。"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>

<Window x:Class="JTSA.PlaylistCategorySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カテゴリ一覧" Icon="Resources/jtsa.ico"
        Width="560" Height="620" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#FF404040">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="プレイリストへ追加" Width="130" Height="30"
                    Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                    IsDefault="True" Click="AddButton_Click"/>
        </StackPanel>

        <Border Padding="8" Background="#FF303030" BorderBrush="#FF606060"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="追加するカテゴリを選択" Foreground="White" Margin="4,0,0,6"/>
                <ListBox x:Name="CategoryListBox" Grid.Row="1"
                         ItemsSource="{Binding Categories}"
                         Background="#FF404040" BorderBrush="#FF606060"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="CategoryListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding BoxArtUrl}" Width="36" Height="48"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastUsedDate, StringFormat=最終使用日：{0}}" Foreground="LightGray" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#FF606060"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>

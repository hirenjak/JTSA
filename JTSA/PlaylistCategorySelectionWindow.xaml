<Window x:Class="JTSA.PlaylistCategorySelectionWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="カテゴリ一覧" Icon="Resources/jtsa.ico"
        Width="560" Height="620" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF303030">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#FF606060"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#FF505050"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#FF4A4A4A">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
        <Image Source="Resources/jtsa.ico" Width="16" Height="16" Margin="0,0,8,0"/>
        <TextBlock Text="カテゴリ一覧" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
        <Button Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
        <Button Content="&#xE8BB;" Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click"/>
       </StackPanel>
      </Grid>
    <DockPanel Grid.Row="1" Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="ConfirmButton" Content="プレイリストへ追加" Width="130" Height="30"
                    Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                    IsDefault="True" Click="AddButton_Click"/>
        </StackPanel>

        <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="InstructionTextBlock" Text="追加するカテゴリを選択" Foreground="White" Margin="4,0,0,6"/>
                <ListBox x:Name="CategoryListBox" Grid.Row="1"
                         Background="#FF404040" BorderBrush="#FF606060"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="CategoryListBox_MouseDoubleClick">
                    <ListBox.ItemsSource>
                        <CompositeCollection>
                            <ListBoxItem HorizontalContentAlignment="Stretch" Padding="4">
                                <Button Content="＋ カテゴリを追加" Height="30" Padding="8,0"
                                        HorizontalContentAlignment="Left"
                                        Background="#FF285653" BorderBrush="LightSeaGreen"
                                        BorderThickness="1" Foreground="White"
                                        Click="AddCategoryButton_Click"/>
                            </ListBoxItem>
                            <CollectionContainer x:Name="CategoriesContainer"/>
                        </CompositeCollection>
                    </ListBox.ItemsSource>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding BoxArtUrl}" Width="36" Height="48"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastUsedDate, StringFormat=最終使用日：{0}}" Foreground="LightGray" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#FF606060"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Grid>
    </DockPanel>
     </Grid>
    </Border>
</Window>

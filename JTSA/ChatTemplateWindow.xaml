<Window x:Class="JTSA.ChatTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:JTSA.Panels"
        Title="チャットテンプレート" Icon="Resources/jtsa.ico"
        Width="760" Height="500" MinWidth="650" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#FF404040">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="205"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="保存済みテンプレート" Foreground="White" Margin="0,0,0,6"/>
            <ListBox x:Name="TemplateListBox" Grid.Row="1" DisplayMemberPath="Name"
                     SelectionChanged="TemplateListBox_SelectionChanged"/>
            <Button Grid.Row="2" Content="新規作成" Height="28" Margin="0,8,0,0"
                    Click="NewButton_Click"/>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="名前" Foreground="White"/>
            <TextBox x:Name="TemplateNameTextBox" Grid.Row="1" Height="28" Margin="0,4,0,12" Padding="5"/>
            <TextBlock Grid.Row="2" Text="本文（タイトルタグをクリックすると挿入できます）" Foreground="White" TextWrapping="Wrap"/>
            <TextBox x:Name="TemplateTextBox" Grid.Row="3" Margin="0,4,0,0" Padding="6"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Foreground="LightGray" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="削除" Width="64" Height="28" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                <Button Content="保存" Width="64" Height="28" Margin="0,0,8,0" Click="SaveButton_Click"/>
                <Button Content="チャット欄へ挿入" Width="116" Height="28" Click="InsertButton_Click"
                        Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"/>
            </StackPanel>
        </Grid>
        <panels:TitleTagSidePanel x:Name="TemplateTitleTagPanel" Grid.Column="4"/>
    </Grid>
</Window>

<Window x:Class="JTSA.JapaneseCategoryNameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="日本語名編集" Icon="Resources/jtsa.ico"
        Width="420" Height="150" MinWidth="360" MinHeight="140"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" Background="#FF404040">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <controls:CategoryStyleTitleBar/>
 <Grid Grid.Row="1" Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock x:Name="CategoryNameTextBlock" Foreground="LightGray" TextWrapping="Wrap"/>
  <TextBox x:Name="JapaneseNameTextBox" Grid.Row="1" Height="28" Margin="0,10,0,0"
           Padding="5" VerticalContentAlignment="Center"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
   <Button Content="キャンセル" Width="80" Height="26" Margin="0,0,8,0" IsCancel="True"/>
   <Button Content="保存" Width="80" Height="26" IsDefault="True"
           Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
           Click="SaveButton_Click"/>
  </StackPanel>
 </Grid>
 </Grid>
 </Border>
</Window>

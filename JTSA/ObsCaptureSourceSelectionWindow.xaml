<Window x:Class="JTSA.ObsCaptureSourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="キャプチャソース登録" Icon="Resources/jtsa.ico"
        Width="560" Height="520" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#FF404040">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF285653"/><Setter Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <controls:CategoryStyleTitleBar/>
 <DockPanel Grid.Row="1" Margin="10">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
   <Button Content="選択したソースを登録" Width="160" Height="30" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterButton_Click"/>
  </StackPanel>
  <Border Padding="12" Background="#FF303030" BorderBrush="#FF606060" BorderThickness="1" CornerRadius="3">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="一覧を更新" Width="96" Height="26" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/><TextBlock Text="キャプチャソース登録" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Grid.Row="1" Text="OBSから登録するキャプチャソースを選択してください。ダブルクリックでも登録できます。" Foreground="#FFBDBDBD" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ListBox x:Name="SourceListBox" Grid.Row="2" Background="#FF404040" BorderBrush="#FF606060" HorizontalContentAlignment="Stretch" MouseDoubleClick="SourceListBox_MouseDoubleClick">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBackground" Background="#FF474747" BorderBrush="#FF606060" BorderThickness="0,0,0,1" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#FF505656"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#FF344D4B"/><Setter TargetName="ItemBackground" Property="BorderBrush" Value="LightSeaGreen"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Source.InputName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Foreground="LightGray" FontSize="10" Margin="0,3,0,0"><Run Text="{Binding ObsDisplayName, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Source.TypeName, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
 </DockPanel>
 </Grid>
 </Border>
</Window>

<Window x:Class="JTSA.ObsCaptureSourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="キャプチャソース登録" Icon="Resources/jtsa.ico"
        Width="560" Height="520" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#FF404040">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <controls:CategoryStyleTitleBar/>
 <DockPanel Grid.Row="1" Margin="10">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
   <Button Content="登録" Width="90" Height="30" IsDefault="True" Click="RegisterButton_Click"/>
  </StackPanel>
  <Border Padding="8" Background="#FF303030" BorderBrush="#FF606060" BorderThickness="1" CornerRadius="0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,0,8"><Button DockPanel.Dock="Right" Content="一覧を更新" Width="90" Height="24" Click="RefreshButton_Click"/><TextBlock Text="登録するキャプチャソースを選択" Foreground="White" VerticalAlignment="Center"/></DockPanel>
    <ListBox x:Name="SourceListBox" Grid.Row="1" Background="#FF404040" BorderBrush="#FF606060"
             DisplayMemberPath="DisplayName" MouseDoubleClick="SourceListBox_MouseDoubleClick"/>
   </Grid>
  </Border>
 </DockPanel>
 </Grid>
 </Border>
</Window>

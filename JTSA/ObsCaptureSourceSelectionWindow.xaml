<Window x:Class="JTSA.ObsCaptureSourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャプチャソース登録" Icon="Resources/jtsa.ico"
        Width="560" Height="520" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#FF404040">
 <DockPanel Margin="10">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
   <Button Content="登録" Width="90" Height="30" IsDefault="True" Click="RegisterButton_Click"/>
  </StackPanel>
  <Border Padding="8" Background="#FF303030" BorderBrush="#FF606060" BorderThickness="1" CornerRadius="6">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,0,8"><Button DockPanel.Dock="Right" Content="一覧を更新" Width="90" Height="24" Click="RefreshButton_Click"/><TextBlock Text="登録するキャプチャソースを選択" Foreground="White" VerticalAlignment="Center"/></DockPanel>
    <ListBox x:Name="SourceListBox" Grid.Row="1" Background="#FF404040" BorderBrush="#FF606060"
             DisplayMemberPath="DisplayName" MouseDoubleClick="SourceListBox_MouseDoubleClick"/>
   </Grid>
  </Border>
 </DockPanel>
</Window>

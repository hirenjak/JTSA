<Window x:Class="JTSA.AppRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリを登録" Icon="Resources/jtsa.ico" Width="640" Height="680"
        MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="#FF303030">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="再読込" Width="80" Height="26" Click="ReloadButton_Click"/>
            <StackPanel>
                <TextBlock Text="起動中アプリ" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="配置するウィンドウを一覧から選び、タイトルで識別します。同じ chrome が複数あるときはタイトルを編集するか「含む」にしてください。" Foreground="LightGray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="RunningAppListBox" Grid.Row="1" ItemsSource="{Binding RunningApps}" Background="#FF404040" BorderBrush="#FF666666" HorizontalContentAlignment="Stretch" MouseDoubleClick="RunningAppListBox_MouseDoubleClick" SelectionChanged="RunningAppListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WindowTitle}" Foreground="LightGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="選択" Foreground="#FF91D8CD" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Path" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="36"/>
            <Button DockPanel.Dock="Right" Content="参照..." Width="80" Height="26" Margin="8,0,0,0" Click="BrowsePathButton_Click"/>
            <TextBox x:Name="AppPathTextBox" Height="26" VerticalContentAlignment="Center" Background="#FF505050" Foreground="White" BorderBrush="#FF777777"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="プロセス" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                <TextBox x:Name="WindowProcessNameTextBox" Height="26" VerticalContentAlignment="Center"
                         Background="#FF505050" Foreground="White" BorderBrush="#FF777777"
                         ToolTip="起動中判定とウィンドウ検索に使うプロセス名。サーバーなど UI が無い場合はタスクマネージャーに出る本体名を入れてください。"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="タイトル" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                <TextBox x:Name="WindowTitleTextBox" Height="26" VerticalContentAlignment="Center"
                         Background="#FF505050" Foreground="White" BorderBrush="#FF777777"
                         ToolTip="空欄のままだと配置・最小化の対象を特定しません。"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="ポート" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                <TextBox x:Name="ListenPortTextBox" Height="26" VerticalContentAlignment="Center"
                         Background="#FF505050" Foreground="White" BorderBrush="#FF777777"
                         ToolTip="待ち受けポート。停止時に LISTENING の PID を終了し、起動中判定にも使います。空欄なら使いません。"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="一致" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                <ComboBox x:Name="TitleMatchModeComboBox" Height="26" Width="160" HorizontalAlignment="Left"
                          Background="#FF505050" Foreground="Black" BorderBrush="#FF777777" SelectedIndex="0">
                    <ComboBoxItem Content="タイトル完全一致"/>
                    <ComboBoxItem Content="タイトルを含む"/>
                </ComboBox>
            </DockPanel>
            <TextBlock Margin="64,4,0,0" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"
                       Text="タイトルが空のときは位置合わせをしません。ポートを入れると、その LISTEN で起動中判定と停止をします。複数ヒットした場合は操作しません。"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="登録" Width="90" Height="30" IsDefault="True" Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="JTSA.AppRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリを登録" Icon="Resources/jtsa.ico" Width="620" Height="600"
        MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="#FF303030">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="再読込" Width="80" Height="26" Click="ReloadButton_Click"/>
            <StackPanel>
                <TextBlock Text="起動中アプリ" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="登録するアプリを選択するか、起動ファイルの Path を直接指定してください。" Foreground="LightGray" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="RunningAppListBox" Grid.Row="1" ItemsSource="{Binding RunningApps}" Background="#FF404040" BorderBrush="#FF666666" HorizontalContentAlignment="Stretch" MouseDoubleClick="RunningAppListBox_MouseDoubleClick" SelectionChanged="RunningAppListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WindowTitle}" Foreground="LightGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="選択" Foreground="#FF91D8CD" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Path" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="36"/>
            <Button DockPanel.Dock="Right" Content="参照..." Width="80" Height="26" Margin="8,0,0,0" Click="BrowsePathButton_Click"/>
            <TextBox x:Name="AppPathTextBox" Height="26" VerticalContentAlignment="Center" Background="#FF505050" Foreground="White" BorderBrush="#FF777777"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="登録" Width="90" Height="30" IsDefault="True" Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns:panels="clr-namespace:JTSA.Panels"
        x:Class="JTSA.MainWindow"
        x:Name="MainWindowRoot"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JTSA"
        Title="JakTwtchStreamerAssistant"
        Icon="Resources/jtsa.ico"
        Height="700" Width="1120"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MainCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF606060"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF4A4A4A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="Resources/jtsa.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title, ElementName=MainWindowRoot}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource MainCaptionButtonStyle}" Click="MainMinimizeButton_Click"/>
                <Button Content="&#xE922;" Style="{StaticResource MainCaptionButtonStyle}" Click="MainMaximizeButton_Click"/>
                <Button Content="&#xE8BB;" Style="{StaticResource MainCaptionButtonStyle}" Click="MainCloseButton_Click"/>
            </StackPanel>
        </Grid>

    <Grid
        Grid.Row="1"
        Background="#FF404040"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ログ出力用テキストボックス -->
        <StackPanel
            Grid.Row="0"
            Width="Auto" HorizontalAlignment="Stretch">
            <TextBlock 
                Grid.Column="0" Grid.Row="0" 
                VerticalAlignment="Top" 
                Height="Auto" Width="Auto" 
                x:Name="StatusTextBlock"
                Foreground="Red" Background="DimGray" TextAlignment="Left"/>
        </StackPanel>

        <!--  -->
        <Grid 
            Grid.Row="1" 
            Margin="8,4,8,0" 
            Width="Auto" Height="72">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition x:Name="CategoryHeaderColumn" Width="180"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition x:Name="TitleHeaderColumn" Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Column ="0" x:Name="SetTitleButton"
                    HorizontalAlignment="Stretch"
                    Padding="0"
                    Margin="0,1,2,3"
                    Background="#FF565656"
                    BorderBrush="#FF777777"
                    Foreground="White"
                    Click="SendTitleButton_Click">
                    <TextBlock Text="Twitch&#x0a;反映"
                               FontSize="10"
                               TextAlignment="Center"
                               LineHeight="11">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>

                <Button Grid.Row="1" Content="X告知" 
                    Margin="0,1,2,3"
                    Background="#FF565656"
                    BorderBrush="#FF777777"
                    Foreground="White"
                    Click="TweetButton_Click"/>
            </Grid>

            <Grid Grid.Column="2" >
                <StackPanel Grid.Column="0" Grid.Row="0"
                        Margin="2,4,8,4"
                        Background="Transparent">
                    <Image x:Name="SelectCategoryBoxArt"
                       Width="45" Height="60"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TwitchSettingStatusTextBlock"
                               Text="設定未反映"
                               Foreground="#FFFF6B6B"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTip="Twitchへの反映状態"
                               MouseLeftButtonDown="TwitchSettingStatusTextBlock_MouseLeftButtonDown"
                               MouseLeftButtonUp="TwitchSettingStatusTextBlock_MouseLeftButtonUp"/>
                    <Button Grid.Column="1" x:Name="GetTitleButton" Content="Twitch設定読込"
                        Width="88" Height="22"
                        Margin="6,0,0,0"
                        FontSize="11"
                        Background="#FF565656"
                        BorderBrush="#FF777777"
                        BorderThickness="1"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="GetTitleButton_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="SelectCategoryNameTextBlock" 
                       TextWrapping="Wrap" Padding="2" Margin="8,0,8,0" 
                       Foreground="Black" FontSize="9" Background="DarkGray" 
                       MouseLeftButtonDown="SelectCategpryNameTextBlock_MouseLeftButtonDown">
                </TextBlock>
                <TextBlock Grid.Row="2" x:Name="SteamUrlTextBlock"
                           Margin="8,1,8,0" Height="16"
                           Foreground="Black" FontSize="8" Background="DarkGray"/>
            </Grid>

            <Grid Grid.Column="3" Margin="0, 0, 0, 4"
                    VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="反映されるタイトル"
                               Foreground="LightGray"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <Label Grid.Column="1" x:Name="TitleWordNum"
                           Content="0/140"
                           Padding="0"
                           Foreground="White"/>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="CurrentTitleTextBlock" 
                       Padding="2, 2, 2, 2"
                       TextWrapping="Wrap" Foreground="Black" FontSize="12" Background="DarkGray" 
                       MouseLeftButtonDown="CurrentTitleTextBlock_MouseLeftButtonDown">
                </TextBlock>
            </Grid>

            <!-- ヘッダー：現在の配信状態 -->
            <Grid Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid x:Name="StreamStatusGrid" Margin="8,4,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StreamStatusIndicator" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StreamStatusTextBlock" Text="配信状態を確認中..." Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="ヘルプ"
                                Width="42" Height="22" Padding="0"
                                Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"
                                Foreground="White" Click="OpenHelpWindowButton_Click"/>
                        <Button Content="設定"
                                Width="38" Height="22" Margin="4,0,0,0" Padding="0"
                                Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"
                                Foreground="White" Click="OpenSettingsWindowButton_Click"/>
                        <Button Content="パッチノート"
                                Width="68" Height="22" Margin="4,0,0,0" Padding="0"
                                Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"
                                Foreground="White" Click="OpenPatchNotesWindowButton_Click"/>
                        <Button Content="AppLog"
                                Width="48" Height="22" Margin="4,0,0,0" Padding="0"
                                Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"
                                Foreground="White" Click="OpenAppLogWindowButton_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="1" x:Name="StreamMetricsGrid" Margin="0,0,104,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StreamDurationLabel" Text="配信時間" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="StreamDurationTextBlock" Text="--:--:--" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" x:Name="ViewerCountLabel" Text="視聴者数" Foreground="LightGray" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ViewerCountTextBlock" Text="-- 人" Foreground="White"
                                       Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                       ToolTip="クリックで視聴者数の表示／非表示を切り替え"
                                       MouseLeftButtonDown="ViewerCountTextBlock_MouseLeftButtonDown"/>
                            <TextBlock x:Name="ViewerCountUpdateCountdownTextBlock" Text="次回更新 --:--"
                                       Foreground="DarkGray" FontSize="10" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ObsStreamButton" Content="OBS 配信開始" Width="96" Height="26"
                                IsEnabled="True" Click="ObsStreamButton_Click" ToolTip="OBSの配信を開始">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Green"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF5C8A5C"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#FF565656"/>
                                            <Setter Property="Foreground" Value="#FF303030"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- シーン切替欄の開閉／SteamURL -->
        <Grid
            Grid.Row="2"
            Height="22"
            Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Margin="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="選択アカウント"
                           Foreground="LightGray"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetAccountComboBox"
                          Width="150" Height="22"
                          Padding="4,0"
                          Background="#FF565656"
                          Foreground="White"
                          BorderBrush="#FF777777"
                          BorderThickness="1"
                          DisplayMemberPath="UserName"
                          SelectedValuePath="Id"
                          SelectionChanged="TargetAccountComboBox_SelectionChanged"
                          ToolTip="操作対象のTwitchアカウント">
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False"
                                              Foreground="White"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#FF565656"
                                                    BorderBrush="#FF777777"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Margin="6,0,2,0"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="White"
                                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                    <TextBlock Grid.Column="1" Text="▼"
                                                               Foreground="White" FontSize="9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0,1,0,0"
                                            Background="#FF565656"
                                            BorderBrush="#FF777777"
                                            BorderThickness="1">
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#FF565656"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF707070"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF464646"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="LightSeaGreen"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#FF707070"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF464646"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>

            <Button x:Name="ObsSceneShortcutToggleButton"
                    Grid.Column="1" Content="ショートカット ☰"
                    Width="90" Height="22" Margin="8,0,0,0"
                    Padding="0" FontSize="11" VerticalAlignment="Center"
                    Foreground="White" Background="#FF565656"
                    BorderBrush="#FF777777" BorderThickness="1" Cursor="Hand"
                    Click="ObsSceneShortcutToggleButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AccordionHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Content="OBSキャプチャ設定" Width="110" Height="22"
                    Margin="8,0,0,0" Padding="6,0" HorizontalAlignment="Left"
                    Foreground="White" Background="#FF285653"
                    BorderBrush="LightSeaGreen" BorderThickness="1"
                    ToolTip="現在のカテゴリに対するOBSキャプチャ先を設定します"
                    Click="OpenCurrentCategoryObsCaptureButton_Click"/>
            <Button x:Name="LaunchSteamGameButton" Grid.Column="2"
                    Content="ゲーム起動" Width="88" Height="22"
                    Padding="6,0" HorizontalAlignment="Right"
                    IsEnabled="False"
                    ToolTip="選択中のゲームをSteam経由で起動します"
                    Click="LaunchSteamGameButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#FF285653"/>
                        <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF565656"/>
                                <Setter Property="Foreground" Value="#FF303030"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 配信中にすぐ押せるOBSシーン・ソースショートカット -->
        <Border x:Name="ObsShortcutPanel" Grid.Row="3" Margin="8,0,8,4"
                Padding="8,7"
                Background="#FF464646"
                BorderBrush="#FF555555"
                BorderThickness="1"
                CornerRadius="0">
        <Grid>
         <Grid.Resources>
            <Style x:Key="ObsShortcutButtonBaseStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF565656"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF777777"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ShortcutButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ShortcutButtonBorder" Property="Background" Value="#FF686868"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ShortcutButtonBorder" Property="Background" Value="#FF303030"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ObsSceneShortcutButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ObsShortcutButtonBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrentScene}" Value="True">
                        <Setter Property="Background" Value="#FF464646"/>
                        <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FF565656"/>
                        <Setter Property="Foreground" Value="#FF303030"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ObsSourceShortcutButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ObsShortcutButtonBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                        <Setter Property="Background" Value="#FF464646"/>
                        <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FF565656"/>
                        <Setter Property="Foreground" Value="#FF303030"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
         </Grid.Resources>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="ObsSceneShortcutPanel" Grid.Column="0" Margin="0,0,6,0" Background="#FF4C4C4C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="8,2,9,2">
                <TextBlock Text="シーン選択" Foreground="#FFD0D0D0"
                           TextAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                <Button Content="設定" Height="19" Margin="0,3,0,0" Padding="7,0"
                        Foreground="White" Background="#FF565656" BorderBrush="#FF777777"
                        Click="OpenObsSceneSwitchWindowButton_Click"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <TextBlock x:Name="ObsSceneShortcutEmptyTextBlock" IsHitTestVisible="False"
                           Text="OBSタブ ＞ シーン切替タブにてシーンの登録ができます"
                           Foreground="LightGray" VerticalAlignment="Center" Margin="6,0"/>
                <ScrollViewer x:Name="ObsSceneShortcutScrollViewer" Panel.ZIndex="1" IsHitTestVisible="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="MainObsSceneShortcutItemsControl">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding ShortcutDisplayName}" Tag="{Binding}" Style="{StaticResource ObsSceneShortcutButtonStyle}" Margin="2,1" MinWidth="96" Height="22" FontSize="10" Click="ObsSceneShortcutButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="SubObsSceneShortcutItemsControl">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding ShortcutDisplayName}" Tag="{Binding}" Style="{StaticResource ObsSceneShortcutButtonStyle}" Margin="2,1" MinWidth="96" Height="22" FontSize="10" Click="ObsSceneShortcutButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="ObsSourceShortcutPanel" Grid.Column="1" Margin="6,0,0,0" Background="#FF4C4C4C">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="8,2,9,2">
                <TextBlock Text="ソース表示" Foreground="#FFD0D0D0"
                           TextAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                <Button Content="設定" Height="19" Margin="0,3,0,0" Padding="7,0"
                        Foreground="White" Background="#FF565656" BorderBrush="#FF777777"
                        Click="OpenObsSourceSwitchWindowButton_Click"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <TextBlock x:Name="ObsSourceShortcutEmptyTextBlock" IsHitTestVisible="False" Text="OBSタブ ＞ ソース切替タブにてソースの登録ができます" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0"/>
                <ScrollViewer x:Name="ObsSourceShortcutScrollViewer" Panel.ZIndex="1" IsHitTestVisible="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="MainObsSourceShortcutItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding ShortcutDisplayName}" Tag="{Binding}" Style="{StaticResource ObsSourceShortcutButtonStyle}" Margin="2,1" MinWidth="96" Height="22" FontSize="10" Click="ObsSourceShortcutButton_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <ItemsControl x:Name="SubObsSourceShortcutItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding ShortcutDisplayName}" Tag="{Binding}" Style="{StaticResource ObsSourceShortcutButtonStyle}" Margin="2,1" MinWidth="96" Height="22" FontSize="10" Click="ObsSourceShortcutButton_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
        </Border>

        <Grid 
            Grid.Row="4"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="238*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabControl" Grid.Row="1" Width="Auto" Margin="8"
                        Background="#FF404040"
                        Grid.ColumnSpan="2">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="64"/>
                        <Setter Property="Height" Value="23"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#FF565656"/>
                        <Setter Property="BorderBrush" Value="#FF777777"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="MainTabHeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF303030"/>
                                            <Setter Property="BorderBrush" Value="#FF666666"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:SplitTabPanel Grid.Row="0" IsItemsHost="True"
                                                    KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="配信概要">
                    <Grid >
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="290" />
                                </Grid.ColumnDefinitions>

                                <!--メインUI-->
                                <DockPanel 
                                    Grid.Column="0" 
                                    Name="MainDockPanel"
                                    Margin="8, 0, 0, 0"
                                    MinWidth="560" Width="Auto">

                                    <Grid DockPanel.Dock="Top"
                                          Margin="4,4,0,0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="タイトル本文編集：${title}の中身"/>
                                            <TextBox x:Name="TitleEditTextBox"
                                                     Height="48" HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Top" Text=""
                                                     TextWrapping="Wrap"
                                                     TextChanged="TitleEditTextBox_TextChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="プレースホルダー配置※下のタイトルタグをクリックでカーソル位置に挿入"/>
                                            <TextBox x:Name="TitlePlaceholderTextBox"
                                                     Height="48" HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Top" Text="${title}"
                                                     TextWrapping="Wrap"
                                                     TextChanged="TitlePlaceholderTextBox_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border DockPanel.Dock="Top" Margin="4,6,0,0" Padding="8"
                                            MinHeight="44"
                                            Background="#FF303030" BorderBrush="#FF606060"
                                            BorderThickness="1" CornerRadius="5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Content="フレンド選択"
                                                    Width="96" Height="28" Margin="0,0,8,0"
                                                    Foreground="White" Background="#FF285653"
                                                    BorderBrush="LightSeaGreen" BorderThickness="1"
                                                    Click="OverviewSelectFriendsButton_Click"/>
                                            <ItemsControl ItemsSource="{Binding SelectedFriendFormList, ElementName=FriendPanel}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FF505050"
                                                                CornerRadius="12" Margin="2" Padding="8,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center"/>
                                                                <Button Tag="{Binding}" Content="×" Width="18" Height="18"
                                                                        Margin="5,0,0,0" Padding="0"
                                                                        Foreground="#FFFF8A91" Background="Transparent"
                                                                        BorderThickness="0" Click="OverviewRemoveFriendButton_Click"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>

                                    <Grid 
                                        Margin="0, 4, 0, 0" 
                                        Height="Auto" >
                                        
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="280"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Label 
                                            Grid.Row="0" Grid.Column="0" 
                                            Content="送信履歴 ※クリックで現在の編集領域に反映"
                                            Margin="4,0,0,0" Padding="0"
                                            Foreground="White"
                                            VerticalContentAlignment="Bottom"/>
                                        
                                        <ListBox 
                                            Grid.Row="1" Grid.Column="0" 
                                            x:Name="TitleTextLogListBox" 
                                            ItemsSource="{Binding TitleTextFormList}" 
                                            Background="#FF404040"
                                            Margin="4,3,4,8"
                                            Width="Auto" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Stretch" 
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                            SelectionChanged="TitleTextLogListBox_SelectionChanged">
                                            
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding CategoryBoxArtUrl}" Grid.Column="0" Width="36" Height="48" Margin="0,0,8,0"/>

                                                            <StackPanel Grid.Column="1" Margin="8,0,28,0">
                                                                <TextBlock Text="{Binding Content}" Grid.Column="0" Width="Auto" Foreground="White" FontSize="16" TextWrapping="Wrap"></TextBlock>
                                                                <TextBlock Text="{Binding TitlePlaceholder, StringFormat=テンプレート：{0}}"
                                                                           Foreground="LightGray" FontSize="11" TextWrapping="Wrap"/>

                                                                <Grid Margin="0" Height="Auto">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding CategoryName}" Width="Auto" Grid.Column="0" Foreground="White" FontSize="10" VerticalAlignment="Center"></TextBlock>
                                                                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8, 0, 0, 0">
                                                                        <Label Margin="0" VerticalAlignment="Bottom" Foreground="LightGray" FontSize="10">最終使用日：</Label>
                                                                        <TextBlock Text="{Binding LastUsedDate}"  Name="LastUsedDate" Height="20" VerticalAlignment="Bottom" Margin="0" Foreground="LightGray" TextWrapping="Wrap"></TextBlock>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Width="20" Height="20"
                                                                    Margin="0,2,4,0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Background="Transparent"
                                                                    Foreground="#FFFF6F78"
                                                                    BorderThickness="0"
                                                                    FontSize="16"
                                                                    Click="TitleTextLogDeleteButton_Click">
                                                                <TextBlock Text="×"
                                                                           Padding="0,0,0,3"
                                                                           TextAlignment="Center"
                                                                           Foreground="#FFFF6F78"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                        <Border Width="Auto" Height="2" Background="White"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Grid Grid.RowSpan="2" Grid.Column="1" Margin="4,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="タイトルタグ" Foreground="White" FontSize="12"
                                                       VerticalAlignment="Bottom"/>
                                            <panels:TitleTagSidePanel Grid.Row="1"
                                                                      x:Name="TitleTagSidePanel"
                                                                      Margin="0,3,0,0"
                                                                      Visibility="Visible"/>
                                        </Grid>
                                    </Grid>
                                </DockPanel>

                                <!-- サイドパネル（カテゴリ一覧） -->
                                <Grid Grid.Column="1" Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Label Foreground="White" Padding="0" Margin="0"
                                               Content="カテゴリ一覧 ※クリックで設定"
                                               VerticalAlignment="Bottom"/>
                                        <Button Content="カテゴリ設定" Width="76" Height="22" Padding="0"
                                                Margin="0,0,0,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#FF565656" BorderBrush="#FF777777"
                                                BorderThickness="1" Foreground="White"
                                                Click="OpenCategorySettingsButton_Click"/>
                                    </Grid>

                                    <ListBox Grid.Row="1" Margin="0,3,0,0"
                                                 x:Name="OverviewCategoryListBox"
                                                 Background="#FF404040"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 SelectionChanged="OverviewCategoryListBox_SelectionChanged">
                                            <ListBox.ItemsSource>
                                                <CompositeCollection>
                                                    <ListBoxItem HorizontalContentAlignment="Stretch" Padding="4">
                                                        <Button Content="＋ カテゴリを追加"
                                                                Height="30" Padding="8,0"
                                                                HorizontalContentAlignment="Left"
                                                                Background="#FF285653" BorderBrush="LightSeaGreen"
                                                                BorderThickness="1" Foreground="White"
                                                                Click="OverviewAddCategoryButton_Click"/>
                                                    </ListBoxItem>
                                                    <CollectionContainer Collection="{Binding Source={x:Reference CategoryPanel}, Path=CategoryFormList}"/>
                                                </CompositeCollection>
                                            </ListBox.ItemsSource>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid Margin="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding BoxArtUrl}" Width="36" Height="48"/>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding LastUsedDate, StringFormat=最終使用日：{0}}" Foreground="LightGray" FontSize="10"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border Height="1" Background="White"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                </Grid>

                            </Grid>
                        </Grid>

                        <!-- 読込画面 -->
                        <Grid Name="LoadScreen" Background="Gray" Height="Auto" Width="Auto" Margin="0, 0, 0, 0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" x:Name="LoadPanelTextBlock" Foreground="White" FontSize="56">Loading Now...</TextBlock>
                                <StackPanel Name="LoadSubPanel" Visibility="Visible">
                                    <!-- ユーザー名はアクセストークンから特定するため入力不要 -->
                                    <TextBlock Text="OAuth認証ボタンをクリックするとブラウザで認証画面が開きます"
                                               HorizontalAlignment="Center"
                                               Foreground="White" FontSize="20"/>
                                    <TextBlock Text="その後下のテキストボックスに表示される認証コードを認証画面に入力"
                                               HorizontalAlignment="Center"
                                               Foreground="White" FontSize="20"/>
                                    <Button DockPanel.Dock="Right" x:Name="OAuthButton" Content="OAuth認証"
                                            Width="112" Height="36" 
                                            FontSize="20"
                                            Margin="0, 24, 0, 0" 
                                            VerticalAlignment="Center" 
                                            Click="OAuthButton_Click"/>

                                    <TextBlock Text="以下の認証コードをブラウザの認証画面に入力してください" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" FontSize="20" 
                                               Margin="0, 8, 0, 0"/>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <TextBox x:Name="LoadPanelSubTextBox" Foreground="White" FontSize="20" Background="#FF4A4747" BorderBrush="White" TextAlignment="Center" IsReadOnly="True" Width="200" Height="Auto"></TextBox>
                                        <Button FontSize="18" Padding="4, 0, 4, 0"  Content="Copy" Click="TokenCodeCopyButton_Click" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="プレイリスト">
                    <panels:PlayingGamePanel x:Name="PlayingGamePanel"/>
                </TabItem>
                
                <TabItem Header="チャット">
                    <panels:ChatPanel x:Name="ChatPanel"/>
                </TabItem>

                <TabItem x:Name="ChatStatisticsTabItem"
                         Header="統計"
                         Visibility="Collapsed">
                    <panels:ChatStatisticsPanel x:Name="ChatStatisticsPanel"
                                                CloseRequested="ChatStatisticsPanel_CloseRequested"/>
                </TabItem>

                <TabItem x:Name="CalendarTabItem" Header="カレンダー">
                    <panels:CalendarPanel x:Name="CalendarPanel"/>
                </TabItem>

                <TabItem Header="レイド">
                    <panels:RaidPanel x:Name="RaidPanel"/>
                </TabItem>

                <TabItem Header="フレンド" Visibility="Collapsed">
                    <panels:FriendPanel x:Name="FriendPanel"/>
                </TabItem>

                <TabItem Header="カテゴリ" Visibility="Collapsed">
                    <panels:CategoryPanel x:Name="CategoryPanel"/>
                </TabItem>

                <TabItem Header="CP">
                    <panels:ChannelPointPanel x:Name="ChannelPointPanel"/>
                </TabItem>

                <TabItem Header="配信拡張">
                    <panels:StereamExpansionPanel x:Name="StereamExpansionPanel"/>
                </TabItem>

                <TabItem Header="外部アプリ">
                    <panels:AppArrangePanel x:Name="AppArrangePanel"/>
                </TabItem>
                
                <TabItem Header="OBS">
                    <panels:ObsSettingPanel x:Name="ObsSettingPanel"/>
                </TabItem>

                <TabItem Header="Tips" controls:SplitTabPanel.IsRightAligned="True">
                    <panels:ObsTipsPanel/>
                </TabItem>

            </TabControl>

            <!-- Window表示用パネルの待避ホスト。タブには表示しない。 -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed">
                <ContentControl x:Name="HelpPanelHost">
                    <panels:HelpPanel x:Name="HelpPanel"/>
                </ContentControl>
                <ContentControl x:Name="SettingsPanelHost">
                    <panels:SettingPanel x:Name="SettingPanel"/>
                </ContentControl>
                <ContentControl x:Name="PatchNotesPanelHost">
                    <panels:PatchNotePanel x:Name="PatchNotePanel"/>
                </ContentControl>
                <ContentControl x:Name="AppLogPanelHost">
                    <panels:AppLogPanel x:Name="AppLogPanel"/>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- アカウント切替中はウィンドウ全体の操作をブロックする。 -->
        <Grid x:Name="AccountSwitchLoadingOverlay"
              Grid.RowSpan="5"
              Panel.ZIndex="1000"
              Background="#B0202020"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32,24"
                    CornerRadius="10"
                    Background="#EE303030"
                    BorderBrush="#FF707070"
                    BorderThickness="1">
                <StackPanel Width="280">
                    <TextBlock x:Name="BlockingLoadingTitleTextBlock"
                               Text="アカウントを切り替えています…"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <ProgressBar Height="8"
                                 Margin="0,20,0,0"
                                 IsIndeterminate="True"/>
                    <TextBlock x:Name="BlockingLoadingDetailTextBlock"
                               Text="チャット接続と関連データを読み込み中"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="LightGray"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Grid>
    </Border>
</Window>


<Window xmlns:panels="clr-namespace:JTSA.Panels"
        x:Class="JTSA.MainWindow"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JTSA"
        Title="JakTwtchStreamerAssistant"
        Icon="Resources/jtsa.ico"
        Height="700" Width="1100">

    <Grid
        Background="#FF404040"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ログ出力用テキストボックス -->
        <StackPanel
            Grid.Row="0"
            Width="Auto" HorizontalAlignment="Stretch">
            <TextBlock 
                Grid.Column="0" Grid.Row="0" 
                VerticalAlignment="Top" 
                Height="Auto" Width="Auto" 
                x:Name="StatusTextBlock"
                Foreground="Red" Background="DimGray" TextAlignment="Left"/>
        </StackPanel>

        <!--  -->
        <Grid 
            Grid.Row="1" 
            Margin="8, -2, 8, 0" 
            Width="Auto" Height="72">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition x:Name="CategoryHeaderColumn" Width="160"/>
                <ColumnDefinition x:Name="TitleHeaderColumn" Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Margin="0, 4, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Column ="0" x:Name="SetTitleButton" Content="送信" 
                    HorizontalAlignment="Stretch"
                    Margin="2, 2, 2, 4"
                    Click="SendTitleButton_Click"/>

                <Button Grid.Row="1" Content="X告知" 
                    Margin="2, 2, 2, 4"
                    Click="TweetButton_Click"/>
            </Grid>

            <Grid Grid.Column="1" >
                <StackPanel Grid.Column="0" Grid.Row="0"
                        Margin="8, 8, 8, 4"
                        Background="Black">
                    <Image x:Name="SelectCategoryBoxArt"
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" Margin="-8, 12, 0, 4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                  Margin="8, 0, 8, 0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="SelectCategoryIdTextBlock" 
                       Padding="2, 2, 2, 2" 
                       Foreground="Black" FontSize="12" Background="DarkGray">
                    </TextBlock>
                    <Button Grid.Column="1" x:Name="GetTitleButton" Content="設定取得" 
                        Height="24" Margin="8, 0, 0, 0" 
                        VerticalAlignment="Center"
                        Click="GetTitleButton_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="SelectCategoryNameTextBlock" 
                       TextWrapping="Wrap" Padding="2, 2, 2, 2" Margin="8, 8, 8, 0" 
                       Foreground="Black" FontSize="9" Background="DarkGray" 
                       MouseLeftButtonDown="SelectCategpryNameTextBlock_MouseLeftButtonDown">
                </TextBlock>
            </Grid>

            <Grid Grid.Column="3" Margin="0, 0, 0, 4"
                    VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" x:Name="TitleWordNum"
                   Content="0/140"
                   Padding="0, 0, 0, 0"
                   Foreground="White" />

                <TextBlock Grid.Row="1" x:Name="CurrentTitleTextBlock" 
                       Padding="2, 2, 2, 2"
                       TextWrapping="Wrap" Foreground="Black" FontSize="12" Background="DarkGray" 
                       MouseLeftButtonDown="CurrentTitleTextBlock_MouseLeftButtonDown">
                </TextBlock>
            </Grid>

            <!-- ヘッダー：現在の配信状態 -->
            <Grid Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid x:Name="StreamStatusGrid" Margin="8,4,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StreamStatusIndicator" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StreamStatusTextBlock" Text="配信状態を確認中..." Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="送信先" Foreground="LightGray" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TargetAccountComboBox" Width="150"
                                  DisplayMemberPath="UserName" SelectedValuePath="Id"
                                  SelectionChanged="TargetAccountComboBox_SelectionChanged"
                                  ToolTip="設定の送信先アカウント"/>
                    </StackPanel>
                    <Grid Grid.Row="1" x:Name="StreamMetricsGrid" Margin="0,0,104,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StreamDurationLabel" Text="配信時間" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="StreamDurationTextBlock" Text="--:--:--" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" x:Name="ViewerCountLabel" Text="視聴者数" Foreground="LightGray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewerCountTextBlock" Text="-- 人" Foreground="White"
                                   Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                   ToolTip="クリックで視聴者数の表示／非表示を切り替え"
                                   MouseLeftButtonDown="ViewerCountTextBlock_MouseLeftButtonDown"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ObsStreamButton" Content="OBS 配信開始" Width="96" Height="26"
                                IsEnabled="True" Click="ObsStreamButton_Click" ToolTip="OBSの配信を開始"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- StemaURL -->
        <Grid
            Grid.Row="2"
            Margin="8, 0, 8, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Column="0" Content="SteamURL"
                Foreground="White" />
            <TextBlock 
                Grid.Column="1"
                x:Name="SteamUrlTextBlock" 
                Margin="8, 0, 0, 0"
                Height="16"
                Foreground="Black" FontSize="8" Background="DarkGray" >
            </TextBlock>
        </Grid>

        <Grid 
            Grid.Row="3"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="238*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabControl" Grid.Row="1" Width="Auto" Margin="0, 8, 0, 0" Background="#FF404040" Grid.ColumnSpan="2">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:SplitTabPanel Grid.Row="0" IsItemsHost="True"
                                                    KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="配信概要">
                    <Grid >
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <!--メインUI-->
                                <DockPanel 
                                    Grid.Column="0" 
                                    Name="MainDockPanel"
                                    Margin="8, 0, 0, 0"
                                    MinWidth="560" Width="Auto">

                                    <Grid DockPanel.Dock="Top"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="タイトル編集"/>
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="配信タイトルの本文"/>
                                            <TextBox x:Name="TitleEditTextBox"
                                                     Height="48" HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Top" Text=""
                                                     TextWrapping="Wrap"
                                                     TextChanged="TitleEditTextBox_TextChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="タイトルプレースホルダーの組み合わせ"/>
                                            <Label Margin="0" Padding="0"
                                                   Foreground="White" Content="${title}：左のタイトル / ${friend}：フレンド / ${date}：今日の日付"/>
                                            <TextBox x:Name="TitlePlaceholderTextBox"
                                                     Height="48" HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Top" Text="${title}"
                                                     TextWrapping="Wrap"
                                                     TextChanged="TitlePlaceholderTextBox_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid 
                                        Margin="0, 4, 0, 0" 
                                        Height="Auto" >
                                        
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="280"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Label 
                                            Grid.Row="0" Grid.Column="0" 
                                            Content="タイトルログ ※クリックでタイトル編集にコピー"
                                            Margin="0, 0, 0, 0" Padding="0, 0, 0, 0"
                                            Foreground="White"
                                            VerticalContentAlignment="Bottom"/>
                                        
                                        <ListBox 
                                            Grid.Row="1" Grid.Column="0" 
                                            x:Name="TitleTextLogListBox" 
                                            ItemsSource="{Binding TitleTextFormList}" 
                                            Background="LightGray"
                                            Width="Auto" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Stretch" 
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                            SelectionChanged="TitleTextLogListBox_SelectionChanged">
                                            
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding CategoryBoxArtUrl}" Grid.Column="0" Width="36" Height="48" Margin="0,0,8,0"/>

                                                            <StackPanel Grid.Column="1" Margin="8, 0, 8, 0">
                                                                <TextBlock Text="{Binding Content}" Grid.Column="0" Width="Auto" Foreground="Black" FontSize="16" TextWrapping="Wrap"></TextBlock>
                                                                <TextBlock Text="{Binding TitlePlaceholder, StringFormat=テンプレート：{0}}"
                                                                           Foreground="DimGray" FontSize="11" TextWrapping="Wrap"/>

                                                                <Grid Margin="0" Height="Auto">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding CategoryName}" Width="Auto" Grid.Column="0" Foreground="Black" FontSize="10" VerticalAlignment="Center"></TextBlock>
                                                                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8, 0, 0, 0">
                                                                        <Label Margin="0" VerticalAlignment="Bottom" Foreground="Black" FontSize="10">最終使用日：</Label>
                                                                        <TextBlock Text="{Binding LastUsedDate}"  Name="LastUsedDate" Height="20" VerticalAlignment="Bottom" Margin="0" Foreground="Black" TextWrapping="Wrap"></TextBlock>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="削除" Width="64" Height="20" Margin="8, 0, 0, 0" VerticalAlignment="Center" Click="TitleTextLogDeleteButton_Click"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border Width="Auto" Height="2" Background="White"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Label 
                                            Grid.Row="0" Grid.Column="1" 
                                            Margin="4, 0, 0, 0" 
                                            Foreground="White" 
                                            Content="カテゴリ一覧 ※ダブルクリックで選択"
                                            VerticalAlignment="Bottom"/>
                                        
                                        <ListBox Grid.Row="1" Grid.Column="1"
                                                 Margin="4, 0, 0, 0"
                                                 ItemsSource="{Binding CategoryFormList, ElementName=CategoryPanel}"
                                                 x:Name="OverviewCategoryListBox"
                                                 Background="#FF404040"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 MouseDoubleClick="OverviewCategoryListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid Margin="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding BoxArtUrl}" Width="36" Height="48"/>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding LastUsedDate, StringFormat=最終使用日：{0}}" Foreground="LightGray" FontSize="10"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border Height="1" Background="White"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </DockPanel>
                                
                                <!-- サイドパネル（タイトルテキストタグ／カテゴリ検索） -->
                                <Grid Grid.Column="1" Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <panels:TitleTagSidePanel Grid.Row="0" x:Name="TitleTagSidePanel" Visibility="Visible"/>
                                    <panels:CategorySearchPanel Grid.Row="1"
                                                                x:Name="OverviewCategorySearchPanel"
                                                                AddToPlaylistOnSelect="False"/>
                                </Grid>

                            </Grid>
                        </Grid>

                        <!-- 読込画面 -->
                        <Grid Name="LoadScreen" Background="Gray" Height="Auto" Width="Auto" Margin="0, 0, 0, 0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" x:Name="LoadPanelTextBlock" Foreground="White" FontSize="56">Loading Now...</TextBlock>
                                <StackPanel Name="LoadSubPanel" Visibility="Visible">
                                    <!-- ユーザー名はアクセストークンから特定するため入力不要 -->
                                    <TextBlock Text="OAuth認証ボタンをクリックするとブラウザで認証画面が開きます"
                                               HorizontalAlignment="Center"
                                               Foreground="White" FontSize="20"/>
                                    <TextBlock Text="その後下のテキストボックスに表示される認証コードを認証画面に入力"
                                               HorizontalAlignment="Center"
                                               Foreground="White" FontSize="20"/>
                                    <Button DockPanel.Dock="Right" x:Name="OAuthButton" Content="OAuth認証"
                                            Width="112" Height="36" 
                                            FontSize="20"
                                            Margin="0, 24, 0, 0" 
                                            VerticalAlignment="Center" 
                                            Click="OAuthButton_Click"/>

                                    <TextBlock Text="以下の認証コードをブラウザの認証画面に入力してください" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" FontSize="20" 
                                               Margin="0, 8, 0, 0"/>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <TextBox x:Name="LoadPanelSubTextBox" Foreground="White" FontSize="20" Background="#FF4A4747" BorderBrush="White" TextAlignment="Center" IsReadOnly="True" Width="200" Height="Auto"></TextBox>
                                        <Button FontSize="18" Padding="4, 0, 4, 0"  Content="Copy" Click="TokenCodeCopyButton_Click" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="プレイリスト">
                    <panels:PlayingGamePanel x:Name="PlayingGamePanel"/>
                </TabItem>
                
                <TabItem Header="チャット">
                    <panels:ChatPanel x:Name="ChatPanel"/>
                </TabItem>

                <TabItem x:Name="ChatStatisticsTabItem"
                         Header="チャット統計"
                         Visibility="Collapsed">
                    <panels:ChatStatisticsPanel x:Name="ChatStatisticsPanel"
                                                CloseRequested="ChatStatisticsPanel_CloseRequested"/>
                </TabItem>

                <TabItem Header="レイド">
                    <panels:RaidPanel x:Name="RaidPanel"/>
                </TabItem>

                <TabItem Header="フレンド">
                    <panels:FriendPanel x:Name="FriendPanel"/>
                </TabItem>

                <TabItem Header="カテゴリ">
                    <panels:CategoryPanel x:Name="CategoryPanel"/>
                </TabItem>

                <TabItem Header="CP">
                    <panels:ChannelPointPanel x:Name="ChannelPointPanel"/>
                </TabItem>

                <TabItem Header="配信拡張">
                    <panels:StereamExpansionPanel x:Name="StereamExpansionPanel"/>
                </TabItem>

                <TabItem Header="外部アプリ">
                    <panels:AppArrangePanel x:Name="AppArrangePanel"/>
                </TabItem>

                <TabItem Header="パッチノート" controls:SplitTabPanel.IsRightAligned="True">
                    <panels:PatchNotePanel x:Name="PatchNotePanel"/>
                </TabItem>

                <TabItem Header="OBS" controls:SplitTabPanel.IsRightAligned="True">
                    <panels:ObsSettingPanel x:Name="ObsSettingPanel"/>
                </TabItem>

                <TabItem Header="Setting" controls:SplitTabPanel.IsRightAligned="True">
                    <panels:SettingPanel x:Name="SettingPanel"/>
                </TabItem>

                <TabItem Header="AppLog" controls:SplitTabPanel.IsRightAligned="True">
                    <panels:AppLogPanel x:Name="AppLogPanel"/>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>
</Window>

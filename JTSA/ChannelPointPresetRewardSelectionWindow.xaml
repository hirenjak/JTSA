<Window x:Class="JTSA.ChannelPointPresetRewardSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPを登録" Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF404040"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusTextBlock" Text="CP一覧を読み込んでいます…" Foreground="White"
                   FontSize="16" Margin="0,0,0,10"/>
        <ListBox x:Name="RewardListBox" Grid.Row="1" ItemsSource="{Binding Choices}"
                 Background="#FF383838" BorderBrush="#FF606060"
                 IsEnabled="False"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Reward.Title}"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Reward.Cost, StringFormat={}{0} CP}"
                                   Foreground="LightGray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="RegisterButton" Content="登録" Width="90" Height="28"
                    IsDefault="True" IsEnabled="False" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

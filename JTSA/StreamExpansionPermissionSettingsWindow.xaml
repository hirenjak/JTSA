<Window x:Class="JTSA.StreamExpansionPermissionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="実行権限設定" Icon="Resources/jtsa.ico"
        Width="560" Height="230" MinWidth="520" MinHeight="220"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF303030">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:CategoryStyleTitleBar/>
   <DockPanel Grid.Row="1" Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
     <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"
             Foreground="White" Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"/>
     <Button Content="反映" Width="90" Height="30" IsDefault="True"
             Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
             Click="ApplyButton_Click"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="コメントから実行できるユーザー" Foreground="White" FontWeight="Bold"/>
     <TextBlock Text="何も選択しない場合は配信者のみ実行できます。" Foreground="LightGray" FontSize="11" Margin="0,4,0,12"/>
     <WrapPanel Margin="8,0,0,0">
      <CheckBox Content="全員" Foreground="White" Margin="0,0,22,0" IsChecked="{Binding ChatPermissionEveryone}"/>
      <CheckBox Content="モデレーター" Foreground="White" Margin="0,0,22,0" IsChecked="{Binding ChatPermissionModerator}"/>
      <CheckBox Content="VIP" Foreground="White" Margin="0,0,22,0" IsChecked="{Binding ChatPermissionVip}"/>
      <CheckBox Content="サブスク" Foreground="White" IsChecked="{Binding ChatPermissionSubscriber}"/>
     </WrapPanel>
    </StackPanel>
   </DockPanel>
  </Grid>
 </Border>
</Window>

<Window x:Class="JTSA.CategorySearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:JTSA.Panels"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="カテゴリ検索" Icon="Resources/jtsa.ico"
        Width="480" Height="600" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#FF303030">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
     <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:CategoryStyleTitleBar/>
      <DockPanel Grid.Row="1" Margin="10">
       <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                   HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0"
                Click="CancelButton_Click"/>
        <Button x:Name="AddButton" Content="カテゴリを追加" Width="120" Height="30"
                Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                BorderThickness="1" IsDefault="True" Click="AddButton_Click"/>
       </StackPanel>
       <panels:CategorySearchPanel x:Name="SearchPanel"/>
      </DockPanel>
     </Grid>
    </Border>
</Window>

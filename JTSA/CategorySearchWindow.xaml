<Window x:Class="JTSA.CategorySearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:JTSA.Panels"
        Title="カテゴリ検索" Icon="Resources/jtsa.ico"
        Width="620" Height="600" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#FF404040">
    <Border Margin="10" Padding="10" Background="#FF303030"
            BorderBrush="#FF606060" BorderThickness="1" CornerRadius="6">
        <panels:CategorySearchPanel x:Name="SearchPanel"/>
    </Border>
</Window>

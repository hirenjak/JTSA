<Window x:Class="JTSA.Utility.RemotePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="スマホパネル" Icon="../Resources/jtsa.ico"
        Width="480" Height="690" MinWidth="440" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="CanResize" Background="#FF303030">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF285653"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF404040"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:CategoryStyleTitleBar/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="スマホパネル" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,7,0,16" Foreground="LightGray" TextWrapping="Wrap"
                               Text="同じWi-Fiのスマホでチャット表示とToDo管理ができます。サーバーを起動し、QRコードを読み取ってください。"/>

                    <TextBlock Text="接続先" Margin="0,0,0,5" Foreground="LightGray"/>
                    <ComboBox x:Name="NetworkAddressesComboBox"
                              DisplayMemberPath="Label"
                              SelectionChanged="NetworkAddressesComboBox_SelectionChanged"/>

                    <Border Margin="0,14,0,12" Padding="12" Background="#FF404040"
                            BorderBrush="#FF555555" BorderThickness="1">
                        <Image x:Name="QrImage" Width="260" Height="260"
                               Stretch="Uniform" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="接続コード" HorizontalAlignment="Center" Foreground="LightGray"/>
                    <TextBlock x:Name="PairingCodeTextBlock" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,2,0,5"/>
                    <Button x:Name="RegeneratePinButton" Content="接続コードを再生成"
                            HorizontalAlignment="Center" Height="26" Padding="10,0"
                            Margin="0,0,0,12" Click="RegeneratePinButton_Click"/>

                    <TextBlock Text="URL" Margin="0,0,0,5" Foreground="LightGray"/>
                    <TextBox x:Name="AddressTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="38"/>

                    <Border Margin="0,12,0,12" Padding="10,8" Background="#FF404040"
                            BorderBrush="#FF555555" BorderThickness="1">
                        <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="サーバー起動" Style="{StaticResource PrimaryButtonStyle}"
                                Click="StartButton_Click"/>
                        <Button Content="停止" Margin="8,0,0,0" Click="StopButton_Click"/>
                        <Button Content="URLをコピー" Margin="8,0,0,0" Click="CopyButton_Click"/>
                    </StackPanel>

                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="JTSA起動時にサーバーを自動起動"
                              Margin="0,16,0,0"
                              Checked="AutoStartCheckBox_Checked"
                              Unchecked="AutoStartCheckBox_Unchecked"/>
                    <TextBlock Margin="0,10,0,0" Foreground="LightGray" TextWrapping="Wrap"
                               Text="この画面を閉じてもサーバーは動作を続けます。接続できない場合は、WindowsファイアウォールやセキュリティソフトでJTSAのプライベートネットワーク通信を許可してください。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

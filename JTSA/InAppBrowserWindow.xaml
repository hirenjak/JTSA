<Window x:Class="JTSA.InAppBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ブラウザ" Icon="Resources/jtsa.ico"
        Width="900" Height="700" MinWidth="320" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF404040">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF505050"/><Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF606060"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF454545"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF888888"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <controls:CategoryStyleTitleBar/>
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="←" Style="{StaticResource NavigationButtonStyle}" Click="BackButton_Click"/>
                <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Style="{StaticResource NavigationButtonStyle}" Click="ForwardButton_Click"/>
                <Button Grid.Column="2" Content="↻" Style="{StaticResource NavigationButtonStyle}" Click="ReloadButton_Click"/>
                <TextBox x:Name="AddressTextBox" Grid.Column="3" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6,3"
                         Background="#FF4A4747" Foreground="White" BorderBrush="#FF666666" BorderThickness="1"/>
            </Grid>
            <Border Grid.Row="2" Margin="1,0,1,1" Background="White"><wv2:WebView2 x:Name="Browser"/></Border>
        </Grid>
    </Border>
</Window>

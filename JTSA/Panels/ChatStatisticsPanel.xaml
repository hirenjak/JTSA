<UserControl x:Class="JTSA.Panels.ChatStatisticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF404040">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="チャットユーザー統計"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Margin="12,0"
                        Background="#FF606060"/>
                <TextBlock x:Name="PeriodTextBlock"
                           Text="保存済みデータを集計中..."
                           Foreground="LightGray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Margin="0,0,34,0"
                    Width="68"
                    Height="26"
                    VerticalAlignment="Center"
                    Content="更新"
                    Click="ReloadButton_Click"/>
            <Button Grid.Column="1"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="LightGray"
                    FontSize="15"
                    Content="✕"
                    ToolTip="閉じる"
                    Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FF303030" BorderBrush="#FF606060"
                    BorderThickness="1" CornerRadius="6" Padding="1">
            <DataGrid x:Name="UserStatisticsDataGrid"
                      ItemsSource="{Binding UserStatistics}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="#FF303030"
                      Foreground="White"
                      BorderThickness="0"
                      RowBackground="#FF303030"
                      AlternatingRowBackground="#FF383838"
                      HorizontalGridLinesBrush="#FF505050"
                      SelectionChanged="UserStatisticsDataGrid_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF242424"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#FF505050"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="順位" Binding="{Binding RankText}" Width="70"/>
                    <DataGridTextColumn Header="ユーザー名" Binding="{Binding DisplayName}" Width="2*"/>
                    <DataGridTextColumn Header="ログインID" Binding="{Binding LoginId}" Width="120"/>
                    <DataGridTextColumn Header="発言数" Binding="{Binding ChatCountText}" Width="75"/>
                    <DataGridTextColumn Header="配信数" Binding="{Binding ActiveDaysText}" Width="75"/>
                    <DataGridTextColumn Header="初回記録日" Binding="{Binding FirstChatDateText}" Width="95"/>
                    <DataGridTextColumn Header="最終記録日" Binding="{Binding LastChatDateText}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="#FF303030" BorderBrush="#FF606060"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CalendarUserNameTextBlock" Text="ユーザーを選択"
                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="チャット記録日"
                                   Margin="0,3,0,0" Foreground="LightGray" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,8,0,8" Padding="7"
                            Background="#FF242424" BorderBrush="#FF505050"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="28" Height="24" Content="‹" FontSize="16"
                                        Background="#FF303030" Foreground="White"
                                        BorderBrush="#FF505050" Click="PreviousMonthButton_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="CalendarMonthTextBlock" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <Button Margin="8,0,0,0" Padding="6,1" Height="24" Content="今日"
                                            FontSize="11"
                                            Background="Transparent" Foreground="LightSeaGreen"
                                            BorderBrush="LightSeaGreen" Click="TodayButton_Click"/>
                                </StackPanel>
                                <Button Grid.Column="2" Width="28" Height="24" Content="›" FontSize="16"
                                        Background="#FF303030" Foreground="White"
                                        BorderBrush="#FF505050" Click="NextMonthButton_Click"/>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DayCell" Margin="1.5" Padding="4"
                                                Background="#FF303030" BorderBrush="Transparent"
                                                BorderThickness="1" CornerRadius="5"
                                                ToolTip="{Binding ToolTipText}">
                                            <Grid>
                                                <TextBlock x:Name="DayNumber" Text="{Binding Day}" FontSize="11"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Foreground="#FFE8E8E8" FontWeight="SemiBold"/>
                                                <Border x:Name="StreamBadge" Visibility="Collapsed"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="3,1" Background="#FFB04A7A" CornerRadius="3">
                                                    <TextBlock Text="{Binding StreamCountText}"
                                                               Foreground="White" FontSize="8"/>
                                                </Border>
                                                <TextBlock x:Name="ActivityCount" Visibility="Collapsed"
                                                           Text="{Binding ChatCountText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter TargetName="DayCell" Property="Opacity" Value="0.28"/>
                                                <Setter TargetName="DayCell" Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="DayCell" Property="BorderBrush" Value="LightSeaGreen"/>
                                                <Setter TargetName="DayCell" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSunday}" Value="True">
                                                <Setter TargetName="DayNumber" Property="Foreground" Value="#FFFF8585"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                                                <Setter TargetName="DayNumber" Property="Foreground" Value="#FF7DBBFF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasActivity}" Value="True">
                                                <Setter TargetName="DayCell" Property="Background" Value="#FF285653"/>
                                                <Setter TargetName="DayCell" Property="BorderBrush" Value="LightSeaGreen"/>
                                                <Setter TargetName="ActivityCount" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasStreams}" Value="True">
                                                <Setter TargetName="StreamBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="緑色の日付はチャット記録あり"
                                   Foreground="LightGray" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="CalendarMonthSummaryTextBlock"
                                   Text="-" Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

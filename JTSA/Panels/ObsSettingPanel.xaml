<UserControl x:Class="JTSA.Panels.ObsSettingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="ObsSettingPanel_Loaded">
 <Grid Margin="12" Background="#FF404040"><TabControl Background="#FF404040" BorderBrush="#FF707070">
  <TabItem Header="ソース文言変更"><ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
   <TextBlock Text="OBSテキストソースの文言変更" Foreground="White" FontSize="22" FontWeight="Bold"/>
   <DockPanel Margin="0,4,0,14"><TextBlock Foreground="LightGray" VerticalAlignment="Center" Text="カードごとに変更するOBSテキストソースを指定します。"/><Button DockPanel.Dock="Right" Content="＋ 変更対象を追加" Width="140" Height="28" Click="AddTextSourceCardButton_Click"/></DockPanel>
   <ItemsControl x:Name="TextSourceCardsItemsControl">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Expander Margin="0,0,0,8" IsExpanded="True" Foreground="White">
      <Expander.Header>
       <DockPanel MinWidth="360">
        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White"/>
        <TextBlock Margin="12,0,0,0" Text="{Binding Status}" Foreground="LightGreen" FontSize="11"/>
       </DockPanel>
      </Expander.Header>
      <Border Padding="9" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="3">
      <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel LastChildFill="False"><Button DockPanel.Dock="Right" Content="削除" Width="50" Height="24" Margin="6,0,0,0" Tag="{Binding}" Click="RemoveTextSourceCardButton_Click"/><TextBlock DockPanel.Dock="Left" Text="カード名称" Width="76" Foreground="White" VerticalAlignment="Center"/><TextBox DockPanel.Dock="Left" Width="220" Height="24" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" LostFocus="CardDisplayName_LostFocus" Tag="{Binding}"/><Button DockPanel.Dock="Left" Content="{Binding ActionButtonText}" Width="96" Height="24" Margin="8,0,0,0" Tag="{Binding}" Click="ApplySourceCardButton_Click"/><TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Text="{Binding Status}" Foreground="LightGreen" VerticalAlignment="Center" FontSize="11"/></DockPanel>
       <Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="接続先OBS" Foreground="LightGray" FontSize="11"/><ComboBox Height="24" Margin="0,2,0,0" Padding="3,0" Tag="{Binding}" SelectedIndex="{Binding ObsSelectedIndex}" SelectionChanged="CardObs_SelectionChanged"><ComboBoxItem Content="メインOBS" Tag="main"/><ComboBoxItem Content="サブOBS" Tag="sub"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="選択シーン" Foreground="LightGray" FontSize="11"/><ComboBox Height="24" Margin="0,2,0,0" Padding="3,0" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" Tag="{Binding}" SelectionChanged="CardScene_SelectionChanged"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="選択ソース" Foreground="LightGray" FontSize="11"/><ComboBox Height="24" Margin="0,2,0,0" Padding="3,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Tag="{Binding}" SelectionChanged="CardSource_SelectionChanged"/></StackPanel>
       </Grid>
       <StackPanel Grid.Row="2" Margin="0,5,0,4"><TextBlock Text="テキスト内容" Foreground="LightGray" FontSize="11"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTextLoaded}" MinHeight="68" MaxHeight="100" Margin="0,2,0,0" Padding="5" Background="#FFE0E0E0" Foreground="Black" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
      </Grid>
      </Border>
     </Expander>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="プレースホルダー">
   <ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
     <TextBlock Text="OBSテキストソース用プレースホルダー" Foreground="White" FontSize="22" FontWeight="Bold"/>
     <TextBlock Margin="0,6,0,14" Foreground="LightGray" TextWrapping="Wrap"
                Text="配信拡張のOBSテキストソース変更で以下を入力すると、トリガー受信時の情報へ自動的に置き換わります。"/>
     <Border Padding="12" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="3">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
       </Grid.RowDefinitions>
       <TextBox Grid.Row="0" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_user}"/>
       <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーの表示名（チャット・初回チャット時）"/>
       <TextBox Grid.Row="1" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_login}"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーのログイン名（チャット・初回チャット時）"/>
       <TextBox Grid.Row="2" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_user}"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの表示名（レイド時）"/>
       <TextBox Grid.Row="3" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_title}"/>
       <TextBlock Grid.Row="3" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信タイトル（レイド時）"/>
       <TextBox Grid.Row="4" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_category}"/>
       <TextBlock Grid.Row="4" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信カテゴリ（レイド時）"/>
       <TextBox Grid.Row="5" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_type}"/>
       <TextBlock Grid.Row="5" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="発火したトリガーの種類"/>
       <TextBox Grid.Row="6" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_value}"/>
       <TextBlock Grid.Row="6" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="コメント本文、ユーザー名、報酬ID、Bits数などのトリガー値"/>
       <TextBox Grid.Row="7" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_obs}"/>
       <TextBlock Grid.Row="7" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信開始イベントの発火元OBS（main / sub）"/>
       <TextBox Grid.Row="8" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_title}"/>
       <TextBlock Grid.Row="8" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信タイトル"/>
       <TextBox Grid.Row="9" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category}"/>
       <TextBlock Grid.Row="9" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ"/>
       <TextBox Grid.Row="10" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{channel_point_input}"/>
       <TextBlock Grid.Row="10" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャンネルポイントの入力文言、またはチャットのトリガーコメントより後ろの文言"/>
       <TextBox Grid.Row="11" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category_ja}"/>
       <TextBlock Grid.Row="11" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ名（日本語。未取得時はTwitchカテゴリ名）"/>
       <TextBox Grid.Row="12" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_bits_users}"/>
       <TextBlock Grid.Row="12" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のビッツユーザーと累計Bits（多い順・改行区切り）"/>
       <TextBox Grid.Row="13" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_subscribe_users}"/>
       <TextBlock Grid.Row="13" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のサブスク月数・Tier、またはサブギフ数・Tier（改行区切り）"/>
       <TextBox Grid.Row="14" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_raid_users}"/>
       <TextBlock Grid.Row="14" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のレイドユーザーと累計視聴者数（多い順・改行区切り）"/>
       <TextBox Grid.Row="15" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_follow_users}"/>
       <TextBlock Grid.Row="15" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のフォローユーザー（新しい順・改行区切り）"/>
      </Grid>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem x:Name="SceneSwitchTab" Header="シーン切替" IsVisibleChanged="SceneSwitchTab_IsVisibleChanged">
   <Grid Background="#FF404040" Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="OBSシーン切替" Foreground="White" FontSize="22" FontWeight="Bold"/>
    <DockPanel Grid.Row="1" Margin="0,10,0,12">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
      <Button Content="両方の一覧を更新" Width="120" Height="26" Click="RefreshScenesButton_Click"/>
      <ComboBox x:Name="SceneSelectionComboBox" Width="240" Height="26" Margin="12,0,0,0" DisplayMemberPath="DisplayName"/>
      <Button Content="＋ 切替ボタンを追加" Width="130" Height="26" Margin="8,0,0,0" Click="AddSceneSwitchPresetButton_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="現在のシーン：" Foreground="LightGray"/>
      <TextBlock x:Name="CurrentProgramSceneTextBlock" Text="未取得" Foreground="LightGreen" FontWeight="Bold"/>
     </StackPanel>
    </DockPanel>
    <Border Grid.Row="2" Padding="12" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="3">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="SceneSwitchStatusTextBlock" Text="シーン一覧を読み込んでください" Foreground="LightGray" Margin="0,0,0,10"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <StackPanel>
       <StackPanel x:Name="MainSceneSwitchPresetPanel"><TextBlock Text="メインOBS" Foreground="#FFAEDCFA" FontWeight="Bold" Margin="5,4,5,1"/>
       <ItemsControl x:Name="MainSceneSwitchPresetsItemsControl">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="240" Margin="5" Padding="7" BorderThickness="2" CornerRadius="3"
                 Tag="{Binding}" AllowDrop="True" Cursor="SizeAll"
                 PreviewMouseLeftButtonDown="ScenePresetCard_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ScenePresetCard_PreviewMouseMove"
                 Drop="ScenePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentScene}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding ObsDisplayName, StringFormat=操作するOBS：{0}}" Foreground="LightGray" FontWeight="Bold" Margin="3,2,3,5" FontSize="11"/>
           <Button Grid.Row="1" Content="{Binding SceneName}" Tag="{Binding}" Click="SwitchSceneButton_Click" Height="36" Padding="8" FontSize="13" Cursor="Hand" ToolTip="このシーンへ切り替え"/>
           <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSceneSwitchPresetButton_Click" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="登録を削除"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></StackPanel>
       <StackPanel x:Name="SubSceneSwitchPresetPanel"><TextBlock Text="サブOBS" Foreground="#FFE1B5F4" FontWeight="Bold" Margin="5,8,5,1"/>
       <ItemsControl x:Name="SubSceneSwitchPresetsItemsControl">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="240" Margin="5" Padding="7" BorderThickness="2" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="ScenePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="ScenePresetCard_PreviewMouseMove" Drop="ScenePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentScene}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding ObsDisplayName, StringFormat=操作するOBS：{0}}" Foreground="LightGray" FontWeight="Bold" Margin="3,2,3,5" FontSize="11"/><Button Grid.Row="1" Content="{Binding SceneName}" Tag="{Binding}" Click="SwitchSceneButton_Click" Height="36" Padding="8" FontSize="13" Cursor="Hand" ToolTip="このシーンへ切り替え"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSceneSwitchPresetButton_Click" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="登録を削除"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>
  </TabItem>
  <TabItem x:Name="SourceSwitchTab" Header="ソース切替" IsVisibleChanged="SourceSwitchTab_IsVisibleChanged">
   <Grid Background="#FF404040" Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="OBSソース表示切替" Foreground="White" FontSize="22" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,12">
     <Button Content="両方の一覧を更新" Width="120" Height="26" Click="RefreshSourcesButton_Click"/>
     <ComboBox x:Name="SourceSceneSelectionComboBox" Width="220" Height="26" Margin="12,0,0,0" DisplayMemberPath="DisplayName" SelectionChanged="SourceSceneSelectionComboBox_SelectionChanged"/>
     <ComboBox x:Name="SourceSelectionComboBox" Width="220" Height="26" Margin="8,0,0,0" DisplayMemberPath="SourceName"/>
     <Button Content="＋ 切替ボタンを追加" Width="130" Height="26" Margin="8,0,0,0" Click="AddSourceSwitchPresetButton_Click"/>
    </StackPanel>
    <Border Grid.Row="2" Padding="12" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="3">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="SourceSwitchStatusTextBlock" Text="シーンとソースの一覧を読み込んでください" Foreground="LightGray" Margin="0,0,0,10"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
       <StackPanel x:Name="MainSourceSwitchPresetPanel"><TextBlock Text="メインOBS" Foreground="#FFAEDCFA" FontWeight="Bold" Margin="5,4,5,1"/>
        <ItemsControl x:Name="MainSourceSwitchPresetsItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="260" Margin="5" Padding="7" BorderThickness="2" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="SourcePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="SourcePresetCard_PreviewMouseMove" Drop="SourcePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding SceneName, StringFormat=シーン：{0}}" Foreground="LightGray" FontSize="11" Margin="3,2,3,5"/><Button Grid.Row="1" Content="{Binding SourceName}" Tag="{Binding}" Click="ToggleSourceButton_Click" Height="36" Padding="8"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSourceSwitchPresetButton_Click" Width="24" Height="24"/></Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
       <StackPanel x:Name="SubSourceSwitchPresetPanel"><TextBlock Text="サブOBS" Foreground="#FFE1B5F4" FontWeight="Bold" Margin="5,8,5,1"/>
        <ItemsControl x:Name="SubSourceSwitchPresetsItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="260" Margin="5" Padding="7" BorderThickness="2" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="SourcePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="SourcePresetCard_PreviewMouseMove" Drop="SourcePresetCard_Drop"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding SceneName, StringFormat=シーン：{0}}" Foreground="LightGray" FontSize="11" Margin="3,2,3,5"/><Button Grid.Row="1" Content="{Binding SourceName}" Tag="{Binding}" Click="ToggleSourceButton_Click" Height="36" Padding="8"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSourceSwitchPresetButton_Click" Width="24" Height="24"/></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </StackPanel></ScrollViewer>
     </Grid>
    </Border>
   </Grid>
  </TabItem>
  <TabItem x:Name="ObsSettingsTab" Header="OBS設定"><ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
   <StackPanel x:Name="ObsConnectionSettingsSection">
   <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Left"><TextBlock Text="OBS連携設定" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Margin="0,4,0,0" Foreground="LightGray" Text="各PCのOBSにTwitchアカウントを割り当てます。送信先アカウントに応じて右上ボタンの操作OBSが切り替わります。"/></StackPanel><CheckBox x:Name="ObsAutoConnectCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Content="起動時に登録済みのOBSへ自動接続" Foreground="White" Click="ObsAutoConnectCheckBox_Click"/></DockPanel>
   <Border Padding="10" Margin="0,0,0,8" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="220"/><ColumnDefinition Width="72"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <TextBlock Grid.RowSpan="2" Text="メインOBS" TextAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="URL" Foreground="LightGray" VerticalAlignment="Center"/><TextBox x:Name="ObsUrlTextBox" Grid.Column="2" Margin="3" Padding="5"/><TextBlock Grid.Column="3" Text="パスワード" Foreground="LightGray" VerticalAlignment="Center"/><PasswordBox x:Name="ObsPasswordBox" Grid.Column="4" Margin="3" Padding="5"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="アカウント" Foreground="LightGray" VerticalAlignment="Center"/><ComboBox x:Name="MainTwitchAccountComboBox" Grid.Row="1" Grid.Column="2" Margin="3" Padding="3" DisplayMemberPath="UserName" SelectedValuePath="Id"/><Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="保存・接続テスト" Margin="3" Width="150" HorizontalAlignment="Left" Click="SaveAndTestButton_Click"/><TextBlock x:Name="ObsConnectionStatusTextBlock" Grid.Row="1" Grid.Column="5" Margin="8,0" Foreground="LightGray" VerticalAlignment="Center" Text="未確認"/>
   </Grid></Border>
   <Button x:Name="AddSubObsButton" Content="＋ サブOBSを追加" Width="140" Height="28" HorizontalAlignment="Left" Margin="0,0,0,10" Click="AddSubObsButton_Click"/>
   <Border x:Name="SubObsSettingBorder" Padding="10" Margin="0,0,0,14" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="220"/><ColumnDefinition Width="72"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <TextBlock Grid.RowSpan="2" Text="サブOBS" TextAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="URL" Foreground="LightGray" VerticalAlignment="Center"/><TextBox x:Name="SubObsUrlTextBox" Grid.Column="2" Margin="3" Padding="5"/><TextBlock Grid.Column="3" Text="パスワード" Foreground="LightGray" VerticalAlignment="Center"/><PasswordBox x:Name="SubObsPasswordBox" Grid.Column="4" Margin="3" Padding="5"/><Button Grid.Column="5" Content="削除" Width="56" Height="24" HorizontalAlignment="Right" Click="RemoveSubObsButton_Click"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="アカウント" Foreground="LightGray" VerticalAlignment="Center"/><ComboBox x:Name="SubTwitchAccountComboBox" Grid.Row="1" Grid.Column="2" Margin="3" Padding="3" DisplayMemberPath="UserName" SelectedValuePath="Id"/><Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="保存・接続テスト" Margin="3" Width="150" HorizontalAlignment="Left" Click="SaveAndTestSubButton_Click"/><TextBlock x:Name="SubObsConnectionStatusTextBlock" Grid.Row="1" Grid.Column="5" Margin="8,0" Foreground="LightGray" VerticalAlignment="Center" Text="未確認"/>
   </Grid></Border>
   </StackPanel>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Tips">
   <ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">

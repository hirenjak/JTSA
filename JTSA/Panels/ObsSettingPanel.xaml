<UserControl x:Class="JTSA.Panels.ObsSettingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="ObsSettingPanel_Loaded" Background="#FF404040">
 <UserControl.Resources>
  <Style x:Key="ObsNavigationTabStyle" TargetType="TabItem">
   <Setter Property="Width" Value="148"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,2"/>
   <Setter Property="Foreground" Value="#FFD0D0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavBackground" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF454B4B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF344D4B"/><Setter TargetName="NavBackground" Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ObsSectionTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="ObsPaneTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="ObsDescriptionStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFBDBDBD"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ObsFieldLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFC8C8C8"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
  <Style x:Key="ObsCardStyle" TargetType="Border"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#FF474747"/><Setter Property="BorderBrush" Value="#FF666666"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/></Style>
  <Style x:Key="ObsPrimaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF285653"/><Setter Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="ObsSecondaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="ObsDangerButtonStyle" TargetType="Button"><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="9,0"/><Setter Property="Foreground" Value="#FFFF9A9F"/><Setter Property="Background" Value="#FF4A3839"/><Setter Property="BorderBrush" Value="#FF815052"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
 </UserControl.Resources>
 <Grid Margin="8,4,8,8" Background="#FF303030"><TabControl x:Name="ObsSettingsTabControl" TabStripPlacement="Left" ItemContainerStyle="{StaticResource ObsNavigationTabStyle}" Background="#FF383838" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <TabItem x:Name="ObsSettingsTab" Header="接続設定" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ScrollViewer Background="#FF383838" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><Grid Margin="14,12" HorizontalAlignment="Stretch">
   <StackPanel x:Name="ObsConnectionSettingsSection" HorizontalAlignment="Stretch">
   <TextBlock Text="OBS連携設定" Style="{StaticResource ObsSectionTitleStyle}"/>
   <TextBlock Margin="0,3,0,10" Style="{StaticResource ObsDescriptionStyle}" Text="各PCのOBSにTwitchアカウントを割り当てます。選択アカウントに応じて、メイン画面から操作するOBSが切り替わります。"/>
   <Border Margin="0,0,0,8" Padding="10,5,10,10" Style="{StaticResource ObsCardStyle}" HorizontalAlignment="Stretch"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" VerticalAlignment="Center"><Button Content="保存/接続" Width="88" Height="24" Margin="0,0,10,0" Style="{StaticResource ObsPrimaryButtonStyle}" Click="SaveAndTestButton_Click"/><TextBlock Text="メインOBS" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Margin="10,0,0,0" Padding="7,2" Background="#FF363636" BorderBrush="#FF5E5E5E" BorderThickness="1" CornerRadius="8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="MainObsStatusIndicator" Width="7" Height="7" Margin="0,0,6,0" Fill="#FF9A9A9A" VerticalAlignment="Center"/><TextBlock x:Name="ObsConnectionStatusTextBlock" Foreground="#FFC8C8C8" FontSize="11" Text="未確認"/></StackPanel></Border></StackPanel>
    <CheckBox x:Name="MainObsAutoConnectCheckBox" Grid.Column="4" Content="起動時に自動接続" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" Click="MainObsAutoConnectCheckBox_Click"/>
    <StackPanel Grid.Row="1"><TextBlock Text="WebSocket URL" Style="{StaticResource ObsFieldLabelStyle}"/><TextBox x:Name="ObsUrlTextBox" Height="25" Padding="5,2"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="パスワード" Style="{StaticResource ObsFieldLabelStyle}"/><PasswordBox x:Name="ObsPasswordBox" Height="25" Padding="5,2"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="Twitchアカウント" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox x:Name="MainTwitchAccountComboBox" Height="25" Padding="3,0" DisplayMemberPath="UserName" SelectedValuePath="Id"/></StackPanel>
   </Grid></Border>
   <Button x:Name="AddSubObsButton" Content="＋ サブOBSを追加" Width="132" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddSubObsButton_Click"/>
   <Border x:Name="SubObsSettingBorder" Margin="0,0,0,10" Padding="10,5,10,10" Style="{StaticResource ObsCardStyle}" HorizontalAlignment="Stretch"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" VerticalAlignment="Center"><Button Content="保存/接続" Width="88" Height="24" Margin="0,0,10,0" Style="{StaticResource ObsPrimaryButtonStyle}" Click="SaveAndTestSubButton_Click"/><TextBlock Text="サブOBS" Foreground="#FFE1B5F4" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Margin="10,0,0,0" Padding="7,2" Background="#FF363636" BorderBrush="#FF5E5E5E" BorderThickness="1" CornerRadius="8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="SubObsStatusIndicator" Width="7" Height="7" Margin="0,0,6,0" Fill="#FF9A9A9A" VerticalAlignment="Center"/><TextBlock x:Name="SubObsConnectionStatusTextBlock" Foreground="#FFC8C8C8" FontSize="11" Text="未確認"/></StackPanel></Border></StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="SubObsAutoConnectCheckBox" Content="起動時に自動接続" Foreground="White" VerticalAlignment="Center" Margin="0,0,9,0" Click="SubObsAutoConnectCheckBox_Click"/><Button Content="削除" Width="52" Style="{StaticResource ObsDangerButtonStyle}" Click="RemoveSubObsButton_Click"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="WebSocket URL" Style="{StaticResource ObsFieldLabelStyle}"/><TextBox x:Name="SubObsUrlTextBox" Height="25" Padding="5,2"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="パスワード" Style="{StaticResource ObsFieldLabelStyle}"/><PasswordBox x:Name="SubObsPasswordBox" Height="25" Padding="5,2"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="Twitchアカウント" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox x:Name="SubTwitchAccountComboBox" Height="25" Padding="3,0" DisplayMemberPath="UserName" SelectedValuePath="Id"/></StackPanel>
   </Grid></Border>
   <TextBlock Text="OBSブラウザソース追加" Style="{StaticResource ObsSectionTitleStyle}" Margin="0,8,0,3"/>
   <TextBlock Text="追加先のOBSとシーンを選択して、追加するソースのボタンを押してください。" Style="{StaticResource ObsDescriptionStyle}" Margin="0,0,0,10"/>
   <Border Style="{StaticResource ObsCardStyle}" HorizontalAlignment="Stretch"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="追加先OBS" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox x:Name="BrowserSourceObsComboBox" Height="25" Padding="3,0" SelectionChanged="BrowserSourceObsComboBox_SelectionChanged"><ComboBoxItem Content="メインOBS" Tag="main"/><ComboBoxItem Content="サブOBS" Tag="sub"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="追加先シーン" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox x:Name="BrowserSourceSceneComboBox" Height="25" Padding="3,0"/></StackPanel>
    <TextBlock x:Name="BrowserSourceStatusTextBlock" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource ObsDescriptionStyle}"/>
    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
     <Button Content="チャット表示を追加" Tag="0" Margin="0,0,6,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
     <Button Content="ToDo一覧を追加" Tag="1" Margin="0,0,6,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
     <Button Content="参加一覧を追加" Tag="2" Margin="0,0,6,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
     <Button Content="ゲームプレイリストを追加" Tag="3" Margin="0,0,6,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
     <Button Content="配信拡張画像を追加" Tag="4" Margin="0,0,6,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
     <Button Content="配信拡張クリップを追加" Tag="5" Margin="0,0,0,6" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddBrowserSourceButton_Click"/>
    </WrapPanel>
   </Grid></Border>
   </StackPanel>
  </Grid></ScrollViewer></TabItem>
  <TabItem Header="文言変更" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="380"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="文言変更一覧" Style="{StaticResource ObsSectionTitleStyle}" Margin="0,0,0,8"/>
     <Border Grid.Row="1" BorderBrush="#FF606060" BorderThickness="1"><DockPanel>
     <Button DockPanel.Dock="Bottom" Content="＋ 変更対象を追加" Height="30" Margin="4" HorizontalContentAlignment="Left" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddTextSourceCardButton_Click"/>
     <ListBox x:Name="TextSourceCardsItemsControl" Background="#FF404040" BorderThickness="0" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBackground" Background="#FF474747" BorderBrush="#FF606060" BorderThickness="0,0,0,1" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#FF505656"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#FF344D4B"/><Setter TargetName="ItemBackground" Property="BorderBrush" Value="LightSeaGreen"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="#FF8FE3A1" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Tag="{Binding}" Width="20" Height="20" Margin="8,0,0,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0" FontSize="16" Content="×" ToolTip="この文言変更設定を削除" Click="RemoveTextSourceCardButton_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     </DockPanel></Border>
    </Grid>
    <Grid Grid.Column="2"><Grid>
     <TextBlock Text="左の一覧から設定を選択してください。" Foreground="#FFBDBDBD" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=TextSourceCardsItemsControl}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <ContentControl Content="{Binding SelectedItem, ElementName=TextSourceCardsItemsControl}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl.ContentTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><TextBlock Text="設定内容" Style="{StaticResource ObsSectionTitleStyle}"/></DockPanel>
      <Grid Grid.Row="1" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Grid><TextBlock Text="{Binding DisplayName}" MaxWidth="220" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayNameEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Width="220" Height="24" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayNameEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid><Button Grid.Column="1" Content="{Binding DisplayNameEditButtonText}" Width="30" Height="24" Margin="2,0,0,0" Foreground="White" Tag="{Binding}" ToolTip="表示名を編集" Click="CardDisplayNameEditButton_Click"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="Content" Value="✓"><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style></Button.Style></Button></Grid>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="{Binding ActionButtonText}" Style="{StaticResource ObsPrimaryButtonStyle}" Tag="{Binding}" Click="ApplySourceCardButton_Click"/><TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Status}" Foreground="#FF8FE3A1" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid>
      <Grid Grid.Row="3" Margin="0,12,0,0">
       <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTargetEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="接続先OBS" Style="{StaticResource ObsFieldLabelStyle}"/><TextBlock Text="{Binding ObsDisplayName}" Foreground="White" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="シーン" Style="{StaticResource ObsFieldLabelStyle}"/><TextBlock Text="{Binding SelectedScene}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="ソース" Style="{StaticResource ObsFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedSource}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="編集" Width="44" Margin="8,0,0,0" Style="{StaticResource ObsSecondaryButtonStyle}" Tag="{Binding}" Click="EditSourceCardButton_Click"/></Grid></StackPanel>
       </Grid>
       <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTargetEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="接続先OBS" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox Height="24" Padding="3,0" Tag="{Binding}" SelectedIndex="{Binding ObsSelectedIndex, Mode=OneWay}" SelectionChanged="CardObs_SelectionChanged"><ComboBoxItem Content="メインOBS" Tag="main"/><ComboBoxItem Content="サブOBS" Tag="sub"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="シーン" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox Height="24" Padding="3,0" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene, Mode=OneWay}" Tag="{Binding}" SelectionChanged="CardScene_SelectionChanged"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="ソース" Style="{StaticResource ObsFieldLabelStyle}"/><ComboBox Height="24" Padding="3,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=OneWay}" Tag="{Binding}" SelectionChanged="CardSource_SelectionChanged"/></StackPanel>
       </Grid>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="テキスト内容" Style="{StaticResource ObsFieldLabelStyle}"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTextLoaded}" MinHeight="120" Padding="6" Background="White" Foreground="Black" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
     </Grid></DataTemplate></ContentControl.ContentTemplate></ContentControl>
    </Grid></Grid>
   </Grid>
  </TabItem>
  <TabItem Header="プレースホルダー" Visibility="Collapsed">
   <ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
     <TextBlock Text="OBSテキストソース用プレースホルダー" Foreground="White" FontSize="22" FontWeight="Bold"/>
     <TextBlock Margin="0,6,0,14" Foreground="LightGray" TextWrapping="Wrap"
                Text="配信拡張のOBSテキストソース変更で以下を入力すると、トリガー受信時の情報へ自動的に置き換わります。"/>
     <Border Padding="12" Background="#FF4A4747" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="3">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
       </Grid.RowDefinitions>
       <TextBox Grid.Row="0" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_user}"/>
       <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーの表示名（チャット・初回チャット時）"/>
       <TextBox Grid.Row="1" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_login}"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーのログイン名（チャット・初回チャット時）"/>
       <TextBox Grid.Row="2" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_user}"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの表示名（レイド時）"/>
       <TextBox Grid.Row="3" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_title}"/>
       <TextBlock Grid.Row="3" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信タイトル（レイド時）"/>
       <TextBox Grid.Row="4" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_category}"/>
       <TextBlock Grid.Row="4" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信カテゴリ（レイド時）"/>
       <TextBox Grid.Row="5" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_type}"/>
       <TextBlock Grid.Row="5" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="発火したトリガーの種類"/>
       <TextBox Grid.Row="6" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_value}"/>
       <TextBlock Grid.Row="6" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="コメント本文、ユーザー名、報酬ID、Bits数などのトリガー値"/>
       <TextBox Grid.Row="7" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_obs}"/>
       <TextBlock Grid.Row="7" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信開始イベントの発火元OBS（main / sub）"/>
       <TextBox Grid.Row="8" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_title}"/>
       <TextBlock Grid.Row="8" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信タイトル"/>
       <TextBox Grid.Row="9" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category}"/>
       <TextBlock Grid.Row="9" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ"/>
       <TextBox Grid.Row="10" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{channel_point_input}"/>
       <TextBlock Grid.Row="10" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャンネルポイントの入力文言、またはチャットのトリガーコメントより後ろの文言"/>
       <TextBox Grid.Row="11" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category_ja}"/>
       <TextBlock Grid.Row="11" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ名（日本語。未取得時はTwitchカテゴリ名）"/>
       <TextBox Grid.Row="12" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_bits_users}"/>
       <TextBlock Grid.Row="12" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のビッツユーザーと累計Bits（多い順・改行区切り）"/>
       <TextBox Grid.Row="13" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_subscribe_users}"/>
       <TextBlock Grid.Row="13" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のサブスク月数・Tier、またはサブギフ数・Tier（改行区切り）"/>
       <TextBox Grid.Row="14" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_raid_users}"/>
       <TextBlock Grid.Row="14" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のレイドユーザーと累計視聴者数（多い順・改行区切り）"/>
       <TextBox Grid.Row="15" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_follow_users}"/>
       <TextBlock Grid.Row="15" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のフォローユーザー（新しい順・改行区切り）"/>
      </Grid>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem x:Name="SceneSwitchTab" Header="シーン切替" Visibility="Collapsed" IsVisibleChanged="SceneSwitchTab_IsVisibleChanged">
   <Grid Background="#FF383838" Margin="14,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="OBSシーン切替" Style="{StaticResource ObsSectionTitleStyle}"/>
    <DockPanel Grid.Row="1" Margin="0,6,0,6">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
      <Button Content="両方の一覧を更新" Width="110" Height="24" Style="{StaticResource ObsSecondaryButtonStyle}" Click="RefreshScenesButton_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="現在のシーン：" Foreground="LightGray"/>
      <TextBlock x:Name="CurrentProgramSceneTextBlock" Text="未取得" Foreground="LightGreen" FontWeight="Bold"/>
     </StackPanel>
    </DockPanel>
    <Border Grid.Row="2" Padding="8" Background="#FF404040" BorderBrush="#FF606060" BorderThickness="1">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="SceneSwitchStatusTextBlock" Text="シーン一覧を読み込んでください" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <StackPanel>
       <StackPanel x:Name="MainSceneSwitchPresetPanel"><TextBlock Text="メインOBS" Foreground="#FFAEDCFA" FontWeight="Bold" FontSize="11" Margin="3,2,3,1"/>
       <ItemsControl x:Name="MainSceneSwitchPresetsItemsControl">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="220" Margin="3" Padding="4" BorderThickness="1" CornerRadius="3"
                 Tag="{Binding}" AllowDrop="True" Cursor="SizeAll"
                 PreviewMouseLeftButtonDown="ScenePresetCard_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ScenePresetCard_PreviewMouseMove"
                 Drop="ScenePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentScene}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding ObsDisplayName, StringFormat=操作するOBS：{0}}" Foreground="LightGray" FontWeight="Bold" Margin="2,0,2,3" FontSize="10"/>
           <Grid Grid.Row="1" Margin="2,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示名" Foreground="LightGray" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" Height="22" Padding="4,1" Tag="{Binding}" Text="{Binding ButtonDisplayName, UpdateSourceTrigger=PropertyChanged}" LostFocus="SceneSwitchDisplayNameTextBox_LostFocus" ToolTip="上部のシーン選択に表示するボタン名"/></Grid>
           <Button Grid.Row="2" Content="{Binding SceneName}" Tag="{Binding}" Click="SwitchSceneButton_Click" Height="28" Padding="5" FontSize="12" Style="{StaticResource ObsSecondaryButtonStyle}" ToolTip="このシーンへ切り替え"/>
           <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSceneSwitchPresetButton_Click" Width="20" Height="20" Padding="0" Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="登録を削除"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></StackPanel>
       <StackPanel x:Name="SubSceneSwitchPresetPanel"><TextBlock Text="サブOBS" Foreground="#FFE1B5F4" FontWeight="Bold" FontSize="11" Margin="3,4,3,1"/>
       <ItemsControl x:Name="SubSceneSwitchPresetsItemsControl">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="220" Margin="3" Padding="4" BorderThickness="1" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="ScenePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="ScenePresetCard_PreviewMouseMove" Drop="ScenePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentScene}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding ObsDisplayName, StringFormat=操作するOBS：{0}}" Foreground="LightGray" FontWeight="Bold" Margin="2,0,2,3" FontSize="10"/><Grid Grid.Row="1" Margin="2,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示名" Foreground="LightGray" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" Height="22" Padding="4,1" Tag="{Binding}" Text="{Binding ButtonDisplayName, UpdateSourceTrigger=PropertyChanged}" LostFocus="SceneSwitchDisplayNameTextBox_LostFocus" ToolTip="上部のシーン選択に表示するボタン名"/></Grid><Button Grid.Row="2" Content="{Binding SceneName}" Tag="{Binding}" Click="SwitchSceneButton_Click" Height="28" Padding="5" FontSize="12" Style="{StaticResource ObsSecondaryButtonStyle}" ToolTip="このシーンへ切り替え"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSceneSwitchPresetButton_Click" Width="20" Height="20" Padding="0" Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="登録を削除"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0" HorizontalAlignment="Left">
     <ComboBox x:Name="SceneSelectionComboBox" Width="240" Height="24" DisplayMemberPath="DisplayName"/>
     <Button Content="＋ 切替ボタンを追加" Width="128" Height="24" Margin="6,0,0,0" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddSceneSwitchPresetButton_Click"/>
    </StackPanel>
   </Grid>
  </TabItem>
  <TabItem x:Name="SourceSwitchTab" Header="ソース切替" Visibility="Collapsed" IsVisibleChanged="SourceSwitchTab_IsVisibleChanged">
   <Grid Background="#FF383838" Margin="14,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="OBSソース表示切替" Style="{StaticResource ObsSectionTitleStyle}"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
     <Button Content="両方の一覧を更新" Width="110" Height="24" Style="{StaticResource ObsSecondaryButtonStyle}" Click="RefreshSourcesButton_Click"/>
    </StackPanel>
    <Border Grid.Row="2" Padding="8" Background="#FF404040" BorderBrush="#FF606060" BorderThickness="1">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="SourceSwitchStatusTextBlock" Text="シーンとソースの一覧を読み込んでください" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
       <StackPanel x:Name="MainSourceSwitchPresetPanel"><TextBlock Text="メインOBS" Foreground="#FFAEDCFA" FontWeight="Bold" FontSize="11" Margin="3,2,3,1"/>
        <ItemsControl x:Name="MainSourceSwitchPresetsItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="220" Margin="3" Padding="4" BorderThickness="1" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="SourcePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="SourcePresetCard_PreviewMouseMove" Drop="SourcePresetCard_Drop">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding DetailText}" Foreground="LightGray" FontSize="10" Margin="2,0,2,3" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="1" Margin="2,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示名" Foreground="LightGray" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" Height="22" Padding="4,1" Tag="{Binding}" Text="{Binding ButtonDisplayName, UpdateSourceTrigger=PropertyChanged}" LostFocus="SourceSwitchDisplayNameTextBox_LostFocus" ToolTip="上部のソース表示に表示するボタン名"/></Grid><Button Grid.Row="2" Content="{Binding SourceName}" Tag="{Binding}" Click="ToggleSourceButton_Click" Height="28" Padding="5" Style="{StaticResource ObsSecondaryButtonStyle}"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSourceSwitchPresetButton_Click" Width="20" Height="20" Padding="0" Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0"/></Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
       <StackPanel x:Name="SubSourceSwitchPresetPanel"><TextBlock Text="サブOBS" Foreground="#FFE1B5F4" FontWeight="Bold" FontSize="11" Margin="3,4,3,1"/>
        <ItemsControl x:Name="SubSourceSwitchPresetsItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="220" Margin="3" Padding="4" BorderThickness="1" CornerRadius="3" Tag="{Binding}" AllowDrop="True" Cursor="SizeAll" PreviewMouseLeftButtonDown="SourcePresetCard_PreviewMouseLeftButtonDown" PreviewMouseMove="SourcePresetCard_PreviewMouseMove" Drop="SourcePresetCard_Drop"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF555555"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="True"><Setter Property="Background" Value="#FF315F3B"/><Setter Property="BorderBrush" Value="#FF72D68A"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding DetailText}" Foreground="LightGray" FontSize="10" Margin="2,0,2,3" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="1" Margin="2,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示名" Foreground="LightGray" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" Height="22" Padding="4,1" Tag="{Binding}" Text="{Binding ButtonDisplayName, UpdateSourceTrigger=PropertyChanged}" LostFocus="SourceSwitchDisplayNameTextBox_LostFocus" ToolTip="上部のソース表示に表示するボタン名"/></Grid><Button Grid.Row="2" Content="{Binding SourceName}" Tag="{Binding}" Click="ToggleSourceButton_Click" Height="28" Padding="5" Style="{StaticResource ObsSecondaryButtonStyle}"/><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSourceSwitchPresetButton_Click" Width="20" Height="20" Padding="0" Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0"/></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </StackPanel></ScrollViewer>
     </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0" HorizontalAlignment="Left">
     <ComboBox x:Name="SourceSceneSelectionComboBox" Width="210" Height="24" DisplayMemberPath="DisplayName" SelectionChanged="SourceSceneSelectionComboBox_SelectionChanged"/>
     <ComboBox x:Name="SourceSelectionComboBox" Width="210" Height="24" Margin="6,0,0,0" DisplayMemberPath="DisplayName"/>
     <Button Content="＋ 切替ボタンを追加" Width="128" Height="24" Margin="6,0,0,0" Style="{StaticResource ObsPrimaryButtonStyle}" Click="AddSourceSwitchPresetButton_Click"/>
    </StackPanel>
   </Grid>
  </TabItem>
  <TabItem x:Name="CaptureDestinationTab" Header="キャプチャ先変更" Visibility="Collapsed"
           IsVisibleChanged="CaptureDestinationTab_IsVisibleChanged">
   <Grid Background="#FF383838" Margin="14,12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Padding="0" Background="Transparent" BorderThickness="0">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="1"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0">
       <StackPanel Orientation="Horizontal">
         <Image x:Name="SelectedCaptureCategoryBoxArt" Width="45" Height="60" Stretch="Uniform"/>
         <TextBlock x:Name="SelectedCaptureCategoryTextBlock" Margin="10,0,0,0" Foreground="White" FontWeight="Bold" Text="未選択" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
       </StackPanel>
       <Border Grid.Column="1" Background="#FF606060"/>
       <Grid Grid.Column="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
         <TextBlock x:Name="SelectedCaptureSourceTextBlock" Foreground="White" FontWeight="Bold" Text="下の一覧からソースを選択してください"/>
         <TextBlock x:Name="SelectedCaptureTypeTextBlock" Margin="0,2,0,0" Foreground="LightGray"/>
         <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock x:Name="SelectedCaptureDestinationTextBlock" Foreground="White" FontWeight="Bold"
                     Text="キャプチャ先：未設定" VerticalAlignment="Center"/>
          <Button Content="×" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                  Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0" FontSize="16"
                  ToolTip="設定中のキャプチャ先を解除します" Click="ClearCaptureDestinationButton_Click"/>
         </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="反映して閉じる" Width="120" Margin="16,0,0,0"
                VerticalAlignment="Top" Style="{StaticResource ObsPrimaryButtonStyle}"
                Click="ApplyCaptureDestinationAndCloseButton_Click"/>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="58*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="キャプチャソース一覧" Style="{StaticResource ObsPaneTitleStyle}" Margin="0,0,0,8"/>
       <Border Grid.Row="1" Background="#FF404040" BorderBrush="#FF606060" BorderThickness="1">
        <DockPanel>
         <Button DockPanel.Dock="Top" Content="＋ キャプチャソースを登録" Height="34" Margin="0,0,0,1"
                 HorizontalContentAlignment="Left" FontWeight="SemiBold" Style="{StaticResource ObsPrimaryButtonStyle}"
                 Click="RegisterCaptureSourceButton_Click"/>
         <StackPanel DockPanel.Dock="Top">
          <Grid Margin="9,4,4,4" Height="36">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <RadioButton x:Name="NoCaptureSourceRadioButton" Grid.Column="0" Margin="2,0,8,0"
                        VerticalAlignment="Center" GroupName="CaptureSourceSelection"
                        Checked="NoCaptureSourceRadioButton_Checked"/>
           <TextBlock Grid.Column="1" Text="未選択" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
          </Grid>
          <Border Height="1" Background="White"/>
         </StackPanel>
       <ListBox x:Name="CaptureSourcesListBox" Background="#FF404040" BorderThickness="0"
                HorizontalContentAlignment="Stretch" BorderBrush="#FF606060"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="CaptureSourcesListBox_SelectionChanged">
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
         <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <RadioButton Grid.Column="0" Margin="2,0,8,0" VerticalAlignment="Center" GroupName="CaptureSourceSelection"
                       IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
          <StackPanel Grid.Column="1">
           <TextBlock Text="{Binding Source.InputName, Mode=OneWay}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
           <TextBlock Foreground="LightGray" FontSize="10"><Run Text="{Binding ObsDisplayName, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Source.TypeName, Mode=OneWay}"/></TextBlock>
          </StackPanel>
          <Button Grid.Column="2" Width="20" Height="20" Margin="8,0,0,0" Padding="0"
                  VerticalAlignment="Center" Background="Transparent" Foreground="#FFFF6F78"
                  BorderThickness="0" FontSize="16" ToolTip="登録から削除"
                  Tag="{Binding}" Click="DeleteCaptureSourceButton_Click">
           <TextBlock Text="×" Padding="0,0,0,3" TextAlignment="Center" Foreground="#FFFF6F78"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
         </Grid>
         <Border Height="1" Background="White"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
        </DockPanel>
       </Border>
      </Grid>
     </Border>
     <Border Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="4,0,4,8">
        <Button DockPanel.Dock="Right" Content="再取得" Width="70" Style="{StaticResource ObsSecondaryButtonStyle}"
                Click="RefreshCaptureDestinationsButton_Click"/>
        <TextBlock Text="キャプチャ先一覧" Style="{StaticResource ObsPaneTitleStyle}" VerticalAlignment="Center"/>
       </DockPanel>
       <ListBox x:Name="CaptureDestinationListBox" Grid.Row="1" Background="#FF404040"
                HorizontalContentAlignment="Stretch" BorderBrush="#FF606060"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedValuePath="Value" IsEnabled="False"
                SelectionChanged="CaptureDestinationListBox_SelectionChanged">
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
         <Grid Margin="4"><TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="White" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
         <Border Height="1" Background="White"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
     </Grid>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="Tips" Visibility="Collapsed">
   <ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
     <TextBlock Text="Tips" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Margin="0,10,0,0" Foreground="LightGray" TextWrapping="Wrap">
      <Hyperlink NavigateUri="https://reactive.fugi.tech/library"
                 RequestNavigate="TipsLink_RequestNavigate"
                 Foreground="DeepSkyBlue">Reactive Library</Hyperlink>
      <Run Text=" ：Discordの同室に居る人を自動的にOBSに表示するサービス"/>
     </TextBlock>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
 </TabControl>
 <ContentControl x:Name="StandaloneSwitchContentHost" Visibility="Collapsed"/>
 </Grid>

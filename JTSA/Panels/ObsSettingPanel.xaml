<UserControl x:Class="JTSA.Panels.ObsSettingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="OBS連携設定" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,16" Foreground="LightGray" TextWrapping="Wrap"
                       Text="OBSの［ツール → WebSocketサーバー設定］でサーバーを有効にして、同じ接続情報を入力してください。"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="WebSocket URL" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="ObsUrlTextBox" Grid.Column="1" Margin="4" Padding="6"/>
                <Label Grid.Row="1" Content="パスワード" Foreground="White" VerticalAlignment="Center"/>
                <PasswordBox x:Name="ObsPasswordBox" Grid.Row="1" Grid.Column="1" Margin="4" Padding="6"/>
                <CheckBox x:Name="ObsAutoConnectCheckBox" Grid.Row="2" Grid.Column="1" Margin="4,10"
                          Content="起動時に自動接続する" Foreground="White"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="150,10,0,0">
                <Button Content="保存して接続テスト" Width="160" Height="30" Click="SaveAndTestButton_Click"/>
                <TextBlock x:Name="ObsConnectionStatusTextBlock" Margin="12,0" Foreground="LightGray" VerticalAlignment="Center" Text="未確認"/>
            </StackPanel>

            <Border Margin="0,20,0,14" Height="1" Background="Gray"/>
            <TextBlock Text="OBSブラウザソース" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,10" Foreground="LightGray" Text="OBSのブラウザソースに、用途に応じて以下のURLを設定してください。"/>
            <TextBlock Text="チャット表示" Foreground="White"/>
            <TextBox Text="http://localhost:8026/chat" Margin="0,4,0,10" Padding="6" IsReadOnly="True"/>
            <TextBlock Text="ゲームプレイリスト表示" Foreground="White"/>
            <TextBox Text="http://localhost:8026/obs" Margin="0,4,0,10" Padding="6" IsReadOnly="True"/>
            <TextBlock Text="配信拡張画像出力" Foreground="White"/>
            <TextBox Text="http://localhost:8026/expansion" Margin="0,4,0,4" Padding="6" IsReadOnly="True"/>
            <TextBlock Foreground="LightGray" Text="背景は透明です。画像はトリガー実行時に5秒間表示されます。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

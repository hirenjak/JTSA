<UserControl x:Class="JTSA.Panels.StereamExpansionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF404040">

    <!-- メインレイアウト -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 実装一覧 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button
                Content="＋"
                Click="AddButton_Click"/>

            <ListBox
                Grid.Row="1"
                x:Name="StreamExpansionListBox"
                ItemsSource="{Binding HeaderFormList}"
                SelectedItem="{Binding SelectedHeader, Mode=TwoWay}"
                SelectionChanged="HeaderSelectionChanged"
                Background="#FF404040"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock
                                Text="{Binding HeaderName}"
                                FontSize="20"
                                Foreground="White"/>

                            <Button
                                Content="削除"
                                Click="DeleteHeaderButton_Click"/>

                            <Border
                                Width="Auto" Height="2"
                                Margin="0,4,0,0"
                                Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 実装内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- トリガー内容 -->
            <Grid Grid.Row="0" DataContext="{Binding SelectedHeader}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Height="Auto">
                        <Label
                            Content="実装名："
                            Foreground="White"
                            VerticalAlignment="Center"/>

                        <TextBox
                            Width="240"
                            Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button
                            Content="保存"
                            Click="SaveButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="Auto">
                        <Label Content="有効化：" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center"/>

                        <Label Content="レイド時：" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsRaid}" VerticalAlignment="Center"/>

                        <Label Content="サブスク時：" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsSubscribe}" VerticalAlignment="Center"/>

                        <Label Content="ビッツ時：" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsBits}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="24">
                        <Label Content="トリガーコメント：" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox
                            Width="240"
                            Text="{Binding TriggerComment, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="24">
                        <Label Content="トリガーチャンネルポイント：" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox
                            Width="240"
                            ItemsSource="{Binding DataContext.ChannelPointFormList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="RewardId"
                            SelectedValue="{Binding TriggerChannelPointId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 実行内容 -->
            <Grid Grid.Row="1">
                <TabControl>
                    <TabItem Header="音声・画像・チャット">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button
                                Content="＋"
                                Click="AddItemButton_Click"/>

                            <ListBox
                                Grid.Row="1"
                                x:Name="FileExeItemListBox"
                                ItemsSource="{Binding ItemFormList}"
                                d:ItemsSource="{d:SampleData ItemCount = 3}"
                                Background="#FF404040"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="種類：" Foreground="White" VerticalAlignment="Center"/>

                                                <Label Content="重み：" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBox Width="48" Height="18" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>

                                                <TextBlock
                                                    Text="{Binding ProbabilityText}"
                                                    Margin="6,0,0,0"
                                                    Foreground="White"
                                                    VerticalAlignment="Center"/>

                                                <Button
                                                    Content="削除"
                                                    Margin="8,0,0,0"
                                                    Click="DeleteItemButton_Click"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="画像"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsImage}"/>
                                                
                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Image"
                                                    IsEnabled="{Binding IsImage}"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    IsEnabled="{Binding IsImage}"
                                                    Text="{Binding ImageContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="音声"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsAudio}"/>

                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Audio"
                                                    IsEnabled="{Binding IsAudio}"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    IsEnabled="{Binding IsAudio}"
                                                    Text="{Binding AudioContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="72,2,0,2"
                                                IsEnabled="{Binding IsAudio}">

                                                <Label
                                                    Content="音量："
                                                    Foreground="White"
                                                    Padding="0"
                                                    VerticalAlignment="Center"/>

                                                <Slider
                                                    Width="160"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    TickFrequency="5"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding AudioVolume, Mode=TwoWay}"/>

                                                <TextBlock
                                                    Width="44"
                                                    Margin="6,0,0,0"
                                                    Foreground="White"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding AudioVolume, StringFormat={}{0}%}"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="チャット"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsChat}"/>

                                                <TextBox
                                                    Grid.Column="1"
                                                    IsEnabled="{Binding IsChat}"
                                                    Text="{Binding ChatContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <Border
                                                Width="Auto" Height="2"
                                                Margin="0,4,0,0"
                                                Background="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Twitchコマンド">
                        <Grid>
                            <Label>チャットを選択するとTwitchへ送信します</Label>
                        </Grid>
                    </TabItem>

                    <TabItem Header="OBS実行">
                        <Grid>
                            <StackPanel>
                                <Label Content="OBSのブラウザソースに以下のURLを設定してください。"/>
                                <TextBox IsReadOnly="True" Text="http://localhost:8026/expansion"/>
                                <Label Content="背景は透明です。画像はトリガー実行時に5秒間表示されます。"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <TextBlock
                    x:Name="StatusText"
                    Foreground="LightGreen"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="JTSA.Panels.StereamExpansionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF404040">

    <!-- メインレイアウト -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 実装一覧 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button
                Content="＋"
                Click="AddButton_Click"/>

            <ListBox
                Grid.Row="1"
                x:Name="StreamExpansionListBox"
                ItemsSource="{Binding HeaderFormList}"
                d:ItemsSource="{d:SampleData ItemCount = 3}"
                SelectedItem="{Binding SelectedHeader, Mode=TwoWay}"
                SelectionChanged="HeaderSelectionChanged"
                Background="#FF404040"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <TextBlock
                                    Text="{Binding HeaderName}"
                                    FontSize="20"
                                    Foreground="White"/>

                                <!-- 削除ボタン -->
                                <Button 
                                    Grid.Column="1" Grid.Row="0" 
                                    FontSize="16"
                                    Width="20" Height="20" 
                                    Margin="0, 0, 0, 0" 
                                    Background="IndianRed"
                                    HorizontalAlignment="Right"
                                    Click="DeleteHeaderButton_Click">

                                    <TextBlock 
                                        Text="×"
                                        Padding="0, 0, 0, 3"
                                        TextAlignment="Center"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <Border
                                Width="Auto" Height="2"
                                Margin="0,4,0,0"
                                Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 実装内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- トリガー内容 -->
            <Grid Grid.Row="0" DataContext="{Binding SelectedHeader}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Height="Auto">
                        <Label
                            Content="実装名："
                            Foreground="White"
                            VerticalAlignment="Center"/>

                        <TextBox
                            Width="240" Height="20"
                            FontSize="12" 
                            Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button
                            Content="保存"
                            Click="SaveButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="Auto">

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="16, 0, 0, 0">
                            
                            <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center"/>
                            <Label Content="有効化" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="24, 0, 0, 0">
                            
                            <CheckBox IsChecked="{Binding IsRaid}" VerticalAlignment="Center"/>
                            <Label Content="レイド起動" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="24, 0, 0, 0">
                            
                            <CheckBox IsChecked="{Binding IsSubscribe}" VerticalAlignment="Center"/>
                            <Label Content="サブスク起動" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="24, 0, 0, 0">
                            <CheckBox IsChecked="{Binding IsBits}" VerticalAlignment="Center"/>
                            <Label Content="ビッツ起動" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="24">
                        <Label 
                            Content="トリガーコメント：" 
                            Width="150"
                            Foreground="White" 
                            VerticalAlignment="Center"/>
                        
                        <TextBox
                            Width="240" Height="20"
                            FontSize="12" 
                            Text="{Binding TriggerComment, UpdateSourceTrigger=PropertyChanged}"/>
                        
                    </StackPanel>

                    <StackPanel 
                        Orientation="Horizontal" 
                        Margin="0, 4, 0, 0"
                        Height="24">
                        <Label 
                            Content="トリガーチャンネルポイント：" 
                            Width="150"
                            Foreground="White" 
                            VerticalAlignment="Center"/>
                        
                        <ComboBox
                            Width="240" Height="20"
                            FontSize="12"
                            ItemsSource="{Binding DataContext.ChannelPointFormList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="RewardId"
                            SelectedValue="{Binding TriggerChannelPointId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 実行内容 -->
            <Grid Grid.Row="1">
                <TabControl>
                    <TabItem Header="音声・画像・チャット">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button
                                Content="＋"
                                Click="AddItemButton_Click"/>

                            <ListBox
                                Grid.Row="1"
                                x:Name="FileExeItemListBox"
                                ItemsSource="{Binding ItemFormList}"
                                d:ItemsSource="{d:SampleData ItemCount = 3}"
                                Background="#FF404040"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">

                                                    <Label Content="重み：" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBox 
                                                        Width="48" Height="18" 
                                                        Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock
                                                        Text="{Binding ProbabilityText}"
                                                        d:Text="(100%)"
                                                        Margin="6,0,0,0"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"/>

                                                </StackPanel>

                                                <!-- 削除ボタン -->
                                                <Button Grid.Column="1" Grid.Row="0" 
                                                    FontSize="16"
                                                    Width="20" Height="20" 
                                                    Margin="0, 0, 0, 0" 
                                                    Background="IndianRed"
                                                    HorizontalAlignment="Right"
                                                    Click="DeleteItemButton_Click">

                                                    <TextBlock Text="×"
                                                        Padding="0, 0, 0, 3"
                                                        TextAlignment="Center"
                                                        Foreground="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    </TextBlock>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="画像"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsImage}"/>

                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Image"
                                                    IsEnabled="{Binding IsImage}"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="4, 0, 0, 0"
                                                    Height="20"
                                                    FontSize="12"
                                                    IsEnabled="{Binding IsImage}"
                                                    Text="{Binding ImageContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <Grid
                                                Margin="0, 4, 0, 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="音声"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsAudio}"/>

                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Audio"
                                                    IsEnabled="{Binding IsAudio}"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="4, 0, 0, 0"
                                                    Height="20"
                                                    FontSize="12"
                                                    IsEnabled="{Binding IsAudio}"
                                                    Text="{Binding AudioContent, UpdateSourceTrigger=PropertyChanged}"/>


                                                <StackPanel
                                                    Grid.Column="3"
                                                    Margin="4, 0, 0, 0"
                                                    Orientation="Horizontal"
                                                    IsEnabled="{Binding IsAudio}">

                                                    <Label
                                                        Content="音量："
                                                        Foreground="White"
                                                        Padding="0"
                                                        VerticalAlignment="Center"/>

                                                    <Slider
                                                        Width="70"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding AudioVolume, Mode=TwoWay}"/>

                                                    <TextBlock
                                                        Width="44"
                                                        Margin="6,0,0,0"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding AudioVolume, StringFormat={}{0}%}"
                                                        d:Text="100%"/>

                                                </StackPanel>
                                            </Grid>

                                            <Grid
                                                Margin="0, 4, 0, 0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Content="チャット"
                                                    Foreground="White"
                                                    IsChecked="{Binding IsChat}"/>

                                                <TextBox
                                                    Grid.Column="1"
                                                    Height="20"
                                                    FontSize="12"
                                                    IsEnabled="{Binding IsChat}"
                                                    Text="{Binding ChatContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <Border
                                                Width="Auto" Height="2"
                                                Margin="0,4,0,0"
                                                Background="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Twitchコマンド">
                        <StackPanel
                            Background="#FF404040">
                            
                            <Label 
                                Content="Twitchコマンド実行"
                                FontSize="20"
                                Foreground="White"/>

                            <StackPanel
                                Orientation="Horizontal"
                                Margin="16, 0, 0, 0">

                                <CheckBox 
                                    IsChecked="{Binding SelectedHeader.DoShoutout, Mode=TwoWay}" 
                                    VerticalAlignment="Center"/>
                                
                                <Label 
                                    Content="Shoutout" 
                                    Foreground="White" 
                                    VerticalAlignment="Center"/>
                                
                            </StackPanel>
                        </StackPanel>

                    </TabItem>

                    <TabItem Header="OBS実行">
                        <Grid
                            Background="#FF404040">

                            <StackPanel>
                                <Label 
                                    Content="※未実装！！！"
                                    FontSize="20"
                                    Foreground="White"/>

                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

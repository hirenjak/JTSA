<UserControl x:Class="JTSA.Panels.StereamExpansionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF404040">

    <UserControl.Resources>
        <Style x:Key="ExpansionTestButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ExpansionHeaderTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF464646"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpansionTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#FF404040"/>
            <Setter Property="BorderBrush" Value="#FF606060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    CornerRadius="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- メインレイアウト -->
    <Grid Margin="8,4,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 実装一覧 -->
        <Grid Grid.Column="0">
          <Border Background="#FF404040" BorderBrush="#FF606060" BorderThickness="1">
           <DockPanel>
            <Button DockPanel.Dock="Top"
                Content="＋ 一覧を追加" Height="30" Margin="0,0,0,1" Padding="8,0"
                HorizontalContentAlignment="Left" Foreground="White"
                Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
                Click="AddButton_Click"/>
            <ListBox
                x:Name="StreamExpansionListBox"
                ItemsSource="{Binding HeaderFormList}"
                d:ItemsSource="{d:SampleData ItemCount = 3}"
                SelectedItem="{Binding SelectedHeader, Mode=TwoWay}"
                SelectionChanged="HeaderSelectionChanged"
                Background="#FF404040"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="チェックが入っている機能だけ有効になります"
                                    IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Click="ActiveCheckBox_Click"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding HeaderName}"
                                        FontSize="20"
                                        Foreground="White"/>
                                    <TextBlock
                                        Text="{Binding TriggerSummary}"
                                        FontSize="11"
                                        Foreground="LightGray"
                                        Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- 削除ボタン -->
                                <Button 
                                    Grid.Column="2" Grid.Row="0" 
                                    FontSize="16"
                                    Width="20" Height="20" 
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#FFFF6F78"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="DeleteHeaderButton_Click">

                                    <TextBlock 
                                        Text="×"
                                        Padding="0, 0, 0, 3"
                                        TextAlignment="Center"
                                        Foreground="#FFFF6F78"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <Border
                                Width="Auto" Height="2"
                                Margin="0,4,0,0"
                                Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
           </DockPanel>
          </Border>
        </Grid>

        <!-- 実装内容 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- トリガー内容 -->
            <Grid Grid.Row="0" DataContext="{Binding SelectedHeader}">
                <Grid Margin="0,0,8,4">
                    <StackPanel>
                    <Grid Height="44">
                        <StackPanel>
                            <TextBlock Text="実装名" Foreground="White" FontSize="11"/>
                            <TextBox Height="20" FontSize="12"
                                     Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid MinHeight="32" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="実行権限設定" Width="140" Height="28"
                                HorizontalAlignment="Left" Foreground="White"
                                Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
                                Click="OpenExecutionPermissionSettingsButton_Click"/>
                        <ItemsControl Grid.Column="1" Margin="10,0,0,0"
                                      ItemsSource="{Binding ExecutionPermissionItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF505050" CornerRadius="12" Margin="2" Padding="8,3">
                                        <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="2" Content="チャット内コマンドヘルプ" Width="170" Height="28"
                                Margin="10,0,0,0" Foreground="White" Background="#FF565656"
                                BorderBrush="#FF777777" BorderThickness="1"
                                Click="OpenPlaceholderHelpButton_Click"/>
                    </Grid>

                    <Grid MinHeight="32" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="実行タイミング設定" Width="140" Height="28"
                                HorizontalAlignment="Left" Foreground="White"
                                Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
                                Click="OpenTriggerSettingsButton_Click"/>
                        <ItemsControl Grid.Column="1" Margin="10,0,0,0"
                                      ItemsSource="{Binding ExecutionTimingItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF505050" CornerRadius="12" Margin="2" Padding="8,3">
                                        <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 実行内容 -->
            <Grid Grid.Row="1">
                <TabControl x:Name="ImplementationTabControl" Style="{StaticResource ExpansionTabControlStyle}"
                            ItemContainerStyle="{StaticResource ExpansionHeaderTabStyle}">
                    <TabItem Header="音声・画像・チャット">
                        <Grid>
                          <Border Background="#FF404040" BorderBrush="#FF606060" BorderThickness="1">
                           <DockPanel>
                            <Button DockPanel.Dock="Top"
                                Content="＋ 機能を追加" Height="30" Margin="0,0,0,1" Padding="8,0"
                                HorizontalContentAlignment="Left" Foreground="White"
                                Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
                                Click="AddItemButton_Click"/>
                            <ListBox
                                x:Name="FileExeItemListBox"
                                ItemsSource="{Binding ItemFormList}"
                                d:ItemsSource="{d:SampleData ItemCount = 3}"
                                Background="#FF404040"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="24"/>
                                                    <RowDefinition Height="24"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.RowSpan="2" Width="78" Height="48" HorizontalAlignment="Left"
                                                        Background="#FF333333" BorderBrush="#FF666666" BorderThickness="1">
                                                    <Image Source="{Binding ImageContent}" Stretch="Uniform"
                                                           ToolTip="{Binding ImageContent}"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Grid.Row="0" Margin="6,0,28,0"
                                                           Text="{Binding ChatContent, StringFormat=チャット：{0}}"
                                                           Foreground="LightGray" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ChatContent}"/>

                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="6,2,0,0">
                                                    <Button Content="画像テスト" Width="76" Height="22"
                                                            Style="{StaticResource ExpansionTestButtonStyle}"
                                                            IsEnabled="{Binding IsImageConfigured}"
                                                            Click="TestImageButton_Click"/>
                                                    <Button Content="音声テスト" Width="76" Height="22"
                                                            Margin="4,0,0,0"
                                                            Style="{StaticResource ExpansionTestButtonStyle}"
                                                            IsEnabled="{Binding IsAudioConfigured}"
                                                            Click="TestAudioButton_Click"/>
                                                    <Button Content="OBS実行テスト" Width="90" Height="22" Margin="4,0,0,0"
                                                            Click="TestObsExecutionButton_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ExpansionTestButtonStyle}">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ObsTextForms.Count}" Value="0">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <!-- 削除ボタン -->
                                                <Button Grid.Column="1" Grid.Row="0"
                                                    FontSize="16"
                                                    Width="20" Height="20" 
                                                    Margin="0" Padding="0"
                                                    Background="Transparent"
                                                    Foreground="#FFFF6F78"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Click="DeleteItemButton_Click">

                                                    <TextBlock Text="×"
                                                        Padding="0, 0, 0, 3"
                                                        TextAlignment="Center"
                                                        Foreground="#FFFF6F78"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    </TextBlock>
                                                </Button>
                                            </Grid>

                                            <StackPanel Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Center">
                                                <TextBlock Text="重み：" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBox Width="32" Height="20" VerticalContentAlignment="Center"
                                                         Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Width="16" Height="20" Margin="2,0,0,0">
                                                    <Button Height="10" Padding="0,0,0,2" FontSize="7"
                                                            Tag="{Binding}" Click="IncreaseWeightButton_Click">
                                                        <TextBlock Text="▲" Margin="0,-1,0,0"/>
                                                    </Button>
                                                    <Button Content="▼" Height="10" Padding="0,0,0,1" FontSize="7"
                                                            Tag="{Binding}" Click="DecreaseWeightButton_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProbabilityText}" Margin="6,0,0,0"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Content="画像設定 ☰" Width="90" Height="22"
                                                    Margin="4,0,0,0" Padding="0" FontSize="11" HorizontalAlignment="Left"
                                                    Foreground="White"
                                                    BorderThickness="1" Cursor="Hand"
                                                    Tag="{Binding}" Click="ImageSettingsToggleButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#FF565656"/>
                                                        <Setter Property="BorderBrush" Value="#FF777777"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImageSettingsExpanded}" Value="True">
                                                                <Setter Property="Background" Value="#FF353535"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsImageConfigured}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FF00B7C3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="0" SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="音声設定 ☰" Width="90" Height="22" Margin="4,0,0,0"
                                                    Padding="0" FontSize="11" Foreground="White"
                                                    BorderThickness="1" Cursor="Hand"
                                                    Tag="{Binding}" Click="AudioSettingsToggleButton_Click">
                                                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsAudioSettingsExpanded}" Value="True"><Setter Property="Background" Value="#FF353535"/></DataTrigger><DataTrigger Binding="{Binding IsAudioConfigured}" Value="True"><Setter Property="BorderBrush" Value="#FF00B7C3"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="チャット設定 ☰" Width="90" Height="22" Margin="4,0,0,0"
                                                    Padding="0" FontSize="11" Foreground="White"
                                                    BorderThickness="1" Cursor="Hand"
                                                    Tag="{Binding}" Click="ChatSettingsToggleButton_Click">
                                                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsChatSettingsExpanded}" Value="True"><Setter Property="Background" Value="#FF353535"/></DataTrigger><DataTrigger Binding="{Binding IsChatConfigured}" Value="True"><Setter Property="BorderBrush" Value="#FF00B7C3"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="Twitchコマンド ☰" Width="90" Height="22" Margin="4,0,0,0"
                                                    Padding="0" FontSize="11" Foreground="White" BorderThickness="1" Cursor="Hand"
                                                    Click="TwitchSettingsToggleButton_Click">
                                                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Style.Triggers><DataTrigger Binding="{Binding IsTwitchSettingsExpanded}" Value="True"><Setter Property="Background" Value="#FF353535"/></DataTrigger><DataTrigger Binding="{Binding SelectedHeader.DoShoutout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="BorderBrush" Value="#FF00B7C3"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="OBS実行 ☰" Width="90" Height="22" Margin="4,0,0,0"
                                                    Padding="0" FontSize="11" Foreground="White" BorderThickness="1" Cursor="Hand"
                                                    Click="ObsSettingsToggleButton_Click">
                                                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF00B7C3"/><Style.Triggers><DataTrigger Binding="{Binding ObsTextForms.Count}" Value="0"><Setter Property="BorderBrush" Value="#FF777777"/></DataTrigger><DataTrigger Binding="{Binding IsObsSettingsExpanded}" Value="True"><Setter Property="Background" Value="#FF353535"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            </StackPanel>
                                            <Border Padding="8,7" Background="#FF464646" BorderBrush="#FF555555"
                                                    BorderThickness="1" CornerRadius="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImageSettingsExpanded}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="画像" Foreground="White" VerticalAlignment="Center"/>

                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Image"
                                                    Height="20" VerticalAlignment="Top"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="4, 0, 0, 0"
                                                    Height="20"
                                                    VerticalAlignment="Top"
                                                    FontSize="12"
                                                    Text="{Binding ImageContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <Grid Margin="72,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/><ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="42"/><ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="28"/><ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="28"/><ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="幅" Foreground="LightGray" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Height="20" Text="{Binding ImageWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="1～1920px"/>
                                                <TextBlock Grid.Column="2" Text="高さ" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBox Grid.Column="3" Height="20" Text="{Binding ImageHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="1～1080px"/>
                                                <TextBlock Grid.Column="4" Text="X" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBox Grid.Column="5" Height="20" Text="{Binding ImageX, UpdateSourceTrigger=PropertyChanged}" ToolTip="左上を0としたX座標"/>
                                                <TextBlock Grid.Column="6" Text="Y" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBox Grid.Column="7" Height="20" Text="{Binding ImageY, UpdateSourceTrigger=PropertyChanged}" ToolTip="左上を0としたY座標"/>
                                                <CheckBox Grid.Column="8" Content="ランダム位置" Foreground="White" Margin="10,0,0,0" IsChecked="{Binding IsImageRandomPosition}" ToolTip="表示のたびに1920×1080内の収まる位置をランダムに決めます"/>
                                            </Grid>
                                            </StackPanel>
                                            </Border>
                                            </StackPanel>
                                            <Border Padding="8,7" Background="#FF464646"
                                                    BorderBrush="#FF555555" BorderThickness="1" CornerRadius="0">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsAudioSettingsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <Grid
                                                Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="音声" Foreground="White" VerticalAlignment="Center"/>

                                                <Button
                                                    Content="選択"
                                                    Grid.Column="1"
                                                    Tag="Audio"
                                                    Click="SelectFileButton_Click"/>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="4, 0, 0, 0"
                                                    Height="20"
                                                    FontSize="12"
                                                    Text="{Binding AudioContent, UpdateSourceTrigger=PropertyChanged}"/>


                                                <StackPanel
                                                    Grid.Column="3"
                                                    Margin="4, 0, 0, 0"
                                                    Orientation="Horizontal"
                                                    IsEnabled="{Binding IsAudioConfigured}">

                                                    <Label
                                                        Content="音量："
                                                        Foreground="White"
                                                        Padding="0"
                                                        VerticalAlignment="Center"/>

                                                    <Slider
                                                        Width="70"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding AudioVolume, Mode=TwoWay}"/>

                                                    <TextBlock
                                                        Width="44"
                                                        Margin="6,0,0,0"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding AudioVolume, StringFormat={}{0}%}"
                                                        d:Text="100%"/>

                                                </StackPanel>
                                            </Grid>
                                            </Border>

                                            <Border Padding="8,7" Background="#FF464646" BorderBrush="#FF555555" BorderThickness="1">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTwitchSettingsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <CheckBox Content="Shoutout（Raid時のみ対応）" Foreground="White"
                                                          IsChecked="{Binding SelectedHeader.DoShoutout, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                                            </Border>

                                            <Border Padding="8,7" Background="#FF464646" BorderBrush="#FF555555" BorderThickness="1">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsObsSettingsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <StackPanel>
                                                    <Button Content="＋ ソース変更" Width="112" Height="24" HorizontalAlignment="Left" Tag="{Binding}" Click="AddObsTextButton_Click"/>
                                                    <ItemsControl ItemsSource="{Binding ObsTextForms}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Border BorderBrush="#FF666666" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,4"><Button Content="一覧取得" Width="72" Height="22" Click="ReloadObsCandidatesButton_Click"/><Button DockPanel.Dock="Right" Content="削除" Width="52" Height="22" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Click="DeleteObsTextButton_Click"/></DockPanel>
                                                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <ComboBox SelectedIndex="{Binding ObsSelectedIndex}" SelectionChanged="ObsTargetSelectionChanged"><ComboBoxItem Content="メインOBS"/><ComboBoxItem Content="サブOBS"/></ComboBox>
                                                                        <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding SceneNames}" Text="{Binding SceneName, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="ObsSceneSelectionChanged"/>
                                                                        <ComboBox Grid.Column="4" IsEditable="True" ItemsSource="{Binding SourceNames}" Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </Grid>
                                                                    <TextBox MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="8,7" Background="#FF464646"
                                                    BorderBrush="#FF555555" BorderThickness="1" CornerRadius="0">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsChatSettingsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <Grid
                                                Margin="0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="チャット" Foreground="White" VerticalAlignment="Center"/>

                                                <TextBox
                                                    Grid.Column="1"
                                                    Height="20"
                                                    FontSize="12"
                                                    ToolTip="プレースホルダー: {chat_user} チャット表示名 / {chat_login} ログイン名 / {raid_user} レイド元の名前 / {raid_title} 直近の配信タイトル / {raid_category} 直近の配信カテゴリ"
                                                    Text="{Binding ChatContent, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            </Border>

                                            <Border
                                                Width="Auto" Height="2"
                                                Margin="0,4,0,4"
                                                Background="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                           </DockPanel>
                          </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Twitchコマンド" Visibility="Collapsed">
                        <StackPanel
                            Background="#FF404040">
                            
                            <Label 
                                Content="Twitchコマンド実行"
                                FontSize="20"
                                Foreground="White"/>

                            <StackPanel
                                Orientation="Horizontal"
                                Margin="16, 0, 0, 0">

                                <CheckBox 
                                    IsChecked="{Binding SelectedHeader.DoShoutout, Mode=TwoWay}" 
                                    VerticalAlignment="Center"/>
                                
                                <Label 
                                    Content="Shoutout（Raid時のみ対応）"
                                    Foreground="White" 
                                    VerticalAlignment="Center"/>
                                
                            </StackPanel>
                        </StackPanel>

                    </TabItem>

                    <TabItem Header="OBS実行" Visibility="Collapsed">
                        <Grid Background="#FF404040">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ItemFormList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#777" BorderThickness="1" CornerRadius="4" Margin="8" Padding="8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="＋ ソース変更" Width="112" Height="24"
                                                                Tag="{Binding}" Click="AddObsTextButton_Click"/>
                                                        <TextBlock Foreground="White" FontWeight="Bold"
                                                                   Text="{Binding ProbabilityText, StringFormat=抽選アイテム {0}}"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding ObsTextForms}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Expander Header="ソース変更" IsExpanded="False" Foreground="White" Margin="0,6,0,0">
                                                                    <Border Background="#FF505050" Padding="10" CornerRadius="3">
                                                                        <StackPanel>
                                                                            <DockPanel Margin="0,0,0,4">
                                                                                <Button Content="一覧取得" Width="72" Height="22" HorizontalAlignment="Left"
                                                                                        Click="ReloadObsCandidatesButton_Click"/>
                                                                                <Button DockPanel.Dock="Right" Content="削除" Width="52" Height="22" HorizontalAlignment="Right"
                                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        Click="DeleteObsTextButton_Click"/>
                                                                            </DockPanel>
                                                                            <Grid Margin="0,0,0,8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="8"/>
                                                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel>
                                                                                    <TextBlock Text="接続先OBS" Foreground="LightGray"/>
                                                                                    <ComboBox Height="24" Margin="0,2,0,0"
                                                                                              SelectedIndex="{Binding ObsSelectedIndex}"
                                                                                              SelectionChanged="ObsTargetSelectionChanged">
                                                                                        <ComboBoxItem Content="メインOBS"/><ComboBoxItem Content="サブOBS"/>
                                                                                    </ComboBox>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2">
                                                                                    <TextBlock Text="シーン" Foreground="LightGray"/>
                                                                                    <ComboBox Height="24" Margin="0,2,0,0" IsEditable="True" ItemsSource="{Binding SceneNames}"
                                                                                              Text="{Binding SceneName, UpdateSourceTrigger=PropertyChanged}"
                                                                                              SelectionChanged="ObsSceneSelectionChanged"/>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="4">
                                                                                    <TextBlock Text="テキストソース" Foreground="LightGray"/>
                                                                                    <ComboBox Height="24" Margin="0,2,0,0" IsEditable="True" ItemsSource="{Binding SourceNames}"
                                                                                              Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                            <TextBlock Text="設定するテキスト" Foreground="LightGray"/>
                                                                            <TextBox MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                                                                                     Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="PlaceholderHelpTab" Header="ヘルプ" Visibility="Collapsed">
                        <ScrollViewer Background="#FF404040" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="White"
                                           Text="チャット用プレースホルダー"/>
                                <TextBlock Margin="0,8,0,16" Foreground="LightGray" TextWrapping="Wrap"
                                           Text="チャットの本文に以下を入力すると、トリガー受信時の情報へ自動的に置き換わります。"/>

                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"
                                           Text="OBSテキストソース用プレースホルダー"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_user}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーの表示名（チャット・初回チャット時）"/>
                                    <TextBox Grid.Row="1" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{chat_login}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャットしたユーザーのログイン名（チャット・初回チャット時）"/>
                                    <TextBox Grid.Row="2" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_user}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの表示名（レイド時）"/>
                                    <TextBox Grid.Row="3" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_title}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信タイトル（レイド時）"/>
                                    <TextBox Grid.Row="4" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{raid_category}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="レイド元ユーザーの直近配信カテゴリ（レイド時）"/>
                                    <TextBox Grid.Row="5" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_type}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="発火したトリガーの種類"/>
                                    <TextBox Grid.Row="6" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_value}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="コメント本文、ユーザー名、報酬ID、Bits数などのトリガー値"/>
                                    <TextBox Grid.Row="7" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{trigger_obs}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信開始イベントの発火元OBS（main / sub）"/>
                                    <TextBox Grid.Row="8" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_title}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信タイトル"/>
                                    <TextBox Grid.Row="9" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ"/>
                                    <TextBox Grid.Row="10" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{channel_point_input}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="チャンネルポイントの入力文言、またはチャットのトリガーコメントより後ろの文言"/>
                                    <TextBox Grid.Row="11" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_category_ja}"/>
                                    <TextBlock Grid.Row="11" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="現在の配信カテゴリ名（日本語。未取得時はTwitchカテゴリ名）"/>
                                    <TextBox Grid.Row="12" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_bits_users}"/>
                                    <TextBlock Grid.Row="12" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のビッツユーザーと累計Bits（多い順・改行区切り）"/>
                                    <TextBox Grid.Row="13" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_subscribe_users}"/>
                                    <TextBlock Grid.Row="13" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のサブスク月数・Tier、またはサブギフ数・Tier（改行区切り）"/>
                                    <TextBox Grid.Row="14" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_raid_users}"/>
                                    <TextBlock Grid.Row="14" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のレイドユーザーと累計視聴者数（多い順・改行区切り）"/>
                                    <TextBox Grid.Row="15" FontFamily="Consolas" Foreground="LightSkyBlue" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="{}{stream_follow_users}"/>
                                    <TextBlock Grid.Row="15" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Text="配信内のフォローユーザー（新しい順・改行区切り）"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Foreground="LightSkyBlue"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsReadOnly="True" Cursor="IBeam" Text="{}{chat_user}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" Text="チャットしたユーザーの表示名（チャット・初回チャット時）"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Foreground="LightSkyBlue"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsReadOnly="True" Cursor="IBeam" Text="{}{chat_login}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" Text="チャットしたユーザーのログイン名（チャット・初回チャット時）"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Foreground="LightSkyBlue"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsReadOnly="True" Cursor="IBeam" Text="{}{raid_user}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" Text="レイド元ユーザーの表示名"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Foreground="LightSkyBlue"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsReadOnly="True" Cursor="IBeam" Text="{}{raid_title}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" Text="レイド元の直近の配信タイトル"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Foreground="LightSkyBlue"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsReadOnly="True" Cursor="IBeam" Text="{}{raid_category}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" Text="レイド元の直近の配信カテゴリ"/>
                                </Grid>

                                <TextBlock Foreground="LightGray" TextWrapping="Wrap"
                                           Text="※ レイド以外のトリガーでは置換されません。Twitchからタイトルやカテゴリを取得できなかった場合、その部分は空文字になります。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="JTSA.Panels.VtsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="VtsPanel_Loaded"
             Background="#FF404040">
  <UserControl.Resources>
    <Style x:Key="VtsNavigationTabStyle" TargetType="TabItem">
      <Setter Property="Width" Value="148"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Foreground" Value="#FFD0D0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="NavBackground" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0">
              <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF454B4B"/><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF344D4B"/><Setter TargetName="NavBackground" Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VtsSectionTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="VtsDescriptionStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFBDBDBD"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="VtsFieldLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFC8C8C8"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
    <Style x:Key="VtsCardStyle" TargetType="Border"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#FF474747"/><Setter Property="BorderBrush" Value="#FF666666"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/></Style>
    <Style x:Key="VtsPrimaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF285653"/><Setter Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="VtsSecondaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF565656"/><Setter Property="BorderBrush" Value="#FF777777"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>
  <Grid Margin="8,4,8,8" Background="#FF303030">
    <TabControl x:Name="VtsTabs" TabStripPlacement="Left" ItemContainerStyle="{StaticResource VtsNavigationTabStyle}" Background="#FF383838" BorderThickness="0" SelectionChanged="VtsTabs_SelectionChanged">
      <TabItem Header="接続設定">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF383838">
          <StackPanel Margin="14,12">
            <TextBlock Text="VTube Studio 連携" Style="{StaticResource VtsSectionTitleStyle}"/>
            <TextBlock Margin="0,3,0,10" Style="{StaticResource VtsDescriptionStyle}"
                       Text="VTS の設定で「Allow Plugin API access」をオンにしてください。初回接続時に VTS 側でプラグイン許可ダイアログが出ます。"/>
            <Border Style="{StaticResource VtsCardStyle}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Left" Content="保存/接続" Width="88" Style="{StaticResource VtsPrimaryButtonStyle}" Click="SaveAndConnectButton_Click"/>
                  <Button DockPanel.Dock="Left" Content="切断" Width="72" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="DisconnectButton_Click"/>
                  <Border Margin="12,0,0,0" Padding="7,2" Background="#FF363636" BorderBrush="#FF5E5E5E" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="VtsStatusIndicator" Width="7" Height="7" Margin="0,0,6,0" Fill="#FF9A9A9A"/>
                      <TextBlock x:Name="VtsConnectionStatusTextBlock" Foreground="#FFC8C8C8" FontSize="11" Text="未接続"/>
                    </StackPanel>
                  </Border>
                </DockPanel>
                <CheckBox x:Name="VtsAutoConnectCheckBox" Content="起動時に自動接続" Foreground="White" Margin="0,10,0,0" Click="VtsAutoConnectCheckBox_Click"/>
                <TextBlock Text="WebSocket URL" Style="{StaticResource VtsFieldLabelStyle}" Margin="0,10,0,3"/>
                <TextBox x:Name="VtsUrlTextBox" Height="25" Padding="5,2"/>
                <TextBlock x:Name="VtsVersionTextBlock" Style="{StaticResource VtsDescriptionStyle}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TriggerTab" Header="トリガー">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="トリガー" Style="{StaticResource VtsSectionTitleStyle}"/>
          <DockPanel Grid.Row="1" Margin="0,8,0,8">
            <Button DockPanel.Dock="Left" Content="＋ 追加" Style="{StaticResource VtsPrimaryButtonStyle}" Click="AddTriggerRuleButton_Click"/>
            <Button DockPanel.Dock="Left" Content="候補を再取得" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="RefreshTriggerCatalogButton_Click"/>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource VtsDescriptionStyle}"
                       Text="Twitch / 時刻 / OBS のイベントで VTS コマンドを送ります。変更は自動保存されます。"/>
          </DockPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <ItemsControl x:Name="TriggerRulesItemsControl">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Margin="0,0,0,24"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Style="{StaticResource VtsCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" Content="有効"/>
                        <ComboBox Grid.Column="1" Height="24" ItemsSource="{Binding TriggerTypes, ElementName=Root}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding TriggerType}" SelectionChanged="TriggerRuleField_Changed"/>
                        <Grid Grid.Column="3" MinHeight="24">
                          <ComboBox Height="24" ItemsSource="{Binding ChannelPoints, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding TriggerValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowChannelPointDetail, Converter={StaticResource BoolToVis}}"/>
                          <TextBox Height="24" Padding="4,2" Text="{Binding TriggerValue, UpdateSourceTrigger=PropertyChanged}"
                                   LostFocus="TriggerRuleField_Changed"
                                   Visibility="{Binding ShowChatDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding ScheduledTimes, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding TriggerValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowScheduledTimeDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding AdUpcomingMinutes, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding TriggerValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowAdUpcomingDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding ObsTargets, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding TriggerValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowObsDetail, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="—" Foreground="#FF9A9A9A" VerticalAlignment="Center"
                                     Visibility="{Binding ShowNoTriggerDetail, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <ComboBox Grid.Column="5" Height="24" ItemsSource="{Binding CommandTypes, ElementName=Root}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding CommandType}" SelectionChanged="TriggerRuleField_Changed"/>
                        <Grid Grid.Column="7" MinHeight="24">
                          <ComboBox Height="24" ItemsSource="{Binding CatalogModels, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowModelDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding CatalogHotkeys, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowHotkeyDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding CatalogExpressions, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowExpressionDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding CatalogItems, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowItemDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding CatalogArtMeshes, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowTintDetail, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox Height="24" ItemsSource="{Binding CatalogPostProcessing, ElementName=Root}"
                                    DisplayMemberPath="Name" SelectedValuePath="Id"
                                    SelectedValue="{Binding CommandValue}" SelectionChanged="TriggerRuleField_Changed"
                                    Visibility="{Binding ShowPostProcessingDetail, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="—" Foreground="#FF9A9A9A" VerticalAlignment="Center"
                                     Visibility="{Binding ShowMoveDetail, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Button Grid.Column="9" Content="削除" Style="{StaticResource VtsSecondaryButtonStyle}" Click="RemoveTriggerRuleButton_Click"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowMoveDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="秒" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="60" Height="24" Padding="4,2" Text="{Binding ExtraTime}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="X" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="60" Height="24" Padding="4,2" Text="{Binding ExtraX}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Y" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="60" Height="24" Padding="4,2" Text="{Binding ExtraY}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="回転" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="60" Height="24" Padding="4,2" Text="{Binding ExtraRotation}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="サイズ" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="60" Height="24" Padding="4,2" Text="{Binding ExtraSize}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <CheckBox Content="相対" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,4" IsChecked="{Binding ExtraRelative}" Click="TriggerRuleField_Changed"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowTintDetail, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="全体" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,8,4" IsChecked="{Binding ExtraTintAll}" Click="TriggerRuleField_Changed"/>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="R" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="50" Height="24" Padding="4,2" Text="{Binding ExtraR}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="G" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="50" Height="24" Padding="4,2" Text="{Binding ExtraG}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="B" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="50" Height="24" Padding="4,2" Text="{Binding ExtraB}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                        <StackPanel><TextBlock Text="A" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="50" Height="24" Padding="4,2" Text="{Binding ExtraA}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowPostProcessingDetail, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="後処理ON" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,8,4" IsChecked="{Binding ExtraPostProcessingOn}" Click="TriggerRuleField_Changed"/>
                        <StackPanel><TextBlock Text="値" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox Width="70" Height="24" Padding="4,2" Text="{Binding ExtraPostProcessingValue}" LostFocus="TriggerRuleField_Changed"/></StackPanel>
                      </StackPanel>
                      <TextBox Margin="0,8,0,0" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                               FontFamily="Consolas" Text="{Binding ExtraRawJson, UpdateSourceTrigger=PropertyChanged}"
                               LostFocus="TriggerRuleField_Changed"
                               Visibility="{Binding ShowRawJsonDetail, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="モデル">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF383838">
          <StackPanel Margin="14,12">
            <TextBlock Text="モデル" Style="{StaticResource VtsSectionTitleStyle}"/>
            <TextBlock x:Name="CurrentModelTextBlock" Style="{StaticResource VtsDescriptionStyle}" Margin="0,4,0,10" Text="未取得"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="一覧を取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshModelsButton_Click"/>
              <Button Content="読み込む" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="LoadModelButton_Click"/>
            </StackPanel>
            <ListBox x:Name="ModelsListBox" Height="180" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
            <TextBlock Text="移動（秒数・位置・回転・サイズ）" Style="{StaticResource VtsFieldLabelStyle}" Margin="0,12,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="秒" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="MoveTimeTextBox" Text="0.5" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="X" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="MoveXTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Y" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="MoveYTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="6"><TextBlock Text="回転" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="MoveRotationTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="8"><TextBlock Text="サイズ" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="MoveSizeTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
            </Grid>
            <CheckBox x:Name="MoveRelativeCheckBox" Content="現在位置からの相対移動" Foreground="White" Margin="0,8,0,8"/>
            <Button Content="移動する" HorizontalAlignment="Left" Style="{StaticResource VtsPrimaryButtonStyle}" Click="MoveModelButton_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="ホットキー">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="ホットキー" Style="{StaticResource VtsSectionTitleStyle}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="一覧を取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshHotkeysButton_Click"/>
            <Button Content="実行" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="TriggerHotkeyButton_Click"/>
          </StackPanel>
          <ListBox x:Name="HotkeysListBox" Grid.Row="2" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
        </Grid>
      </TabItem>
      <TabItem Header="表情">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="表情" Style="{StaticResource VtsSectionTitleStyle}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="一覧を取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshExpressionsButton_Click"/>
            <Button Content="ON" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="ActivateExpressionButton_Click"/>
            <Button Content="OFF" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="DeactivateExpressionButton_Click"/>
          </StackPanel>
          <ListBox x:Name="ExpressionsListBox" Grid.Row="2" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
        </Grid>
      </TabItem>
      <TabItem Header="アイテム">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF383838">
          <StackPanel Margin="14,12">
            <TextBlock Text="アイテム" Style="{StaticResource VtsSectionTitleStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
              <Button Content="一覧を取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshItemsButton_Click"/>
              <Button Content="読み込む" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="LoadItemButton_Click"/>
              <Button Content="削除" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="UnloadItemButton_Click"/>
            </StackPanel>
            <TextBlock Text="利用可能なファイル" Style="{StaticResource VtsFieldLabelStyle}"/>
            <ListBox x:Name="AvailableItemsListBox" Height="120" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
            <TextBlock Text="シーン内インスタンス" Style="{StaticResource VtsFieldLabelStyle}" Margin="0,10,0,3"/>
            <ListBox x:Name="SceneItemsListBox" Height="120" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
            <TextBlock Text="移動" Style="{StaticResource VtsFieldLabelStyle}" Margin="0,10,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="秒" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="ItemMoveTimeTextBox" Text="0.5" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="X" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="ItemMoveXTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Y" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="ItemMoveYTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="6"><TextBlock Text="回転" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="ItemMoveRotationTextBox" Text="0" Height="24" Padding="4,2"/></StackPanel>
              <StackPanel Grid.Column="8"><TextBlock Text="サイズ" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="ItemMoveSizeTextBox" Text="0.32" Height="24" Padding="4,2"/></StackPanel>
            </Grid>
            <Button Content="選択インスタンスを移動" HorizontalAlignment="Left" Margin="0,8,0,8" Style="{StaticResource VtsPrimaryButtonStyle}" Click="MoveItemButton_Click"/>
            <TextBlock Text="アニメ（フレームレート）" Style="{StaticResource VtsFieldLabelStyle}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="適用" Width="72" Style="{StaticResource VtsPrimaryButtonStyle}" Click="ControlItemAnimationButton_Click"/>
              <TextBox x:Name="ItemFrameRateTextBox" Text="15" Height="24" Padding="4,2" Margin="0,0,8,0"/>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="色調">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="色調" Style="{StaticResource VtsSectionTitleStyle}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="ArtMesh 取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshArtMeshesButton_Click"/>
            <Button Content="選択に適用" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="TintSelectedButton_Click"/>
            <Button Content="全体に適用" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="TintAllButton_Click"/>
            <Button Content="リセット" Margin="8,0,0,0" Style="{StaticResource VtsSecondaryButtonStyle}" Click="TintResetButton_Click"/>
          </StackPanel>
          <ListBox x:Name="ArtMeshesListBox" Grid.Row="2" SelectionMode="Extended" Background="#FF404040" Foreground="White"/>
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="R" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="TintRTextBox" Text="255" Height="24" Padding="4,2"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="G" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="TintGTextBox" Text="255" Height="24" Padding="4,2"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="B" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="TintBTextBox" Text="255" Height="24" Padding="4,2"/></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Text="A" Style="{StaticResource VtsFieldLabelStyle}"/><TextBox x:Name="TintATextBox" Text="255" Height="24" Padding="4,2"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="後処理">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="後処理" Style="{StaticResource VtsSectionTitleStyle}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="一覧を取得" Style="{StaticResource VtsPrimaryButtonStyle}" Click="RefreshPostProcessingButton_Click"/>
            <CheckBox x:Name="PostProcessingOnCheckBox" Content="後処理ON" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="適用" Margin="8,0,0,0" Style="{StaticResource VtsPrimaryButtonStyle}" Click="ApplyPostProcessingButton_Click"/>
          </StackPanel>
          <ListBox x:Name="PostProcessingListBox" Grid.Row="2" DisplayMemberPath="Display" Background="#FF404040" Foreground="White"/>
          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="選択エフェクトの値（任意）" Style="{StaticResource VtsFieldLabelStyle}"/>
            <TextBox x:Name="PostProcessingValueTextBox" Height="24" Padding="4,2" Text="1"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="任意JSON">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/>
          </Grid.RowDefinitions>
          <TextBlock Text="任意JSON" Style="{StaticResource VtsSectionTitleStyle}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource VtsDescriptionStyle}" Margin="0,4,0,8"
                     Text="messageType を含む JSON を送信します。apiName / apiVersion / requestID は空なら自動補完します。"/>
          <TextBox x:Name="RawJsonTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12" Padding="6"/>
          <Button Grid.Row="3" Content="送信" HorizontalAlignment="Left" Margin="0,8,0,8" Style="{StaticResource VtsPrimaryButtonStyle}" Click="SendRawJsonButton_Click"/>
          <TextBox x:Name="RawLogTextBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="6"
                   Background="#FF2A2A2A" Foreground="#FFD0D0D0"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

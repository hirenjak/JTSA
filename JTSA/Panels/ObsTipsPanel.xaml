<UserControl x:Class="JTSA.Panels.ObsTipsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF404040">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Tips" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <Border Margin="0,12,0,0" Padding="14"
                    Background="#FF4A4747" BorderBrush="#FF707070"
                    BorderThickness="1" CornerRadius="3">
                <TextBlock Foreground="LightGray" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://reactive.fugi.tech/library"
                               RequestNavigate="TipsLink_RequestNavigate"
                               Foreground="DeepSkyBlue">Reactive Library</Hyperlink>
                    <Run Text=" ：Discordの同室に居る人を自動的にOBSに表示するサービス"/>
                </TextBlock>
            </Border>
            <Border Margin="0,8,0,0" Padding="14"
                    Background="#FF4A4747" BorderBrush="#FF707070"
                    BorderThickness="1" CornerRadius="3">
                <TextBlock Foreground="LightGray" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://cedb.me/"
                               RequestNavigate="TipsLink_RequestNavigate"
                               Foreground="DeepSkyBlue">CEDB</Hyperlink>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

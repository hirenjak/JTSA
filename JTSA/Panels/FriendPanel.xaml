<UserControl x:Class="JTSA.Panels.FriendPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">

    <UserControl.Resources>
        <Style x:Key="FriendSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FriendDangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFF6F78"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Height="Auto" Grid.Row="2"
              Background="#FF3A3A3A">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Label Grid.Row="0" Content="フレンドテキストの前に置かれる文字指定" 
                   Foreground="White"/>

            <TextBox Grid.Row="1" Name="FriendPrefixWordTextBox" 
                     TextChanged="FriendPrefixWordTextBox_TextChanged">
            </TextBox>

            <Label Grid.Row="2" Content="※ここに表示されてるユーザーがタイトルに挿入される" 
                   Foreground="White"/>

            <ListBox Grid.Row="3" x:Name="SelectedFriendListBox" 
             d:ItemsSource="{d:SampleData ItemCount=3}"
             ItemsSource="{Binding SelectedFriendFormList}" 
             Background="#FF404040" 
             Height="Auto" Width="Auto" 
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
             ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Margin="8, 0, 8, 0">
                                <!-- アイテム上部ステータス部分 -->
                                <Grid Grid.Column="0"
                              Margin="8, 0, 0, 0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Grid.RowSpan="2"
                                          Width="36" Height="36" Margin="0,2,8,2"
                                          VerticalAlignment="Top">
                                        <Ellipse Fill="#FF555555"/>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#FFD0D0D0" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding ProfileImage}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- 表示名 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White" FontSize="16" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UserId, StringFormat=（{0}）}"
                                                   Foreground="LightGray" FontSize="12"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4,0,3">
                                        <TextBlock Text="{Binding StreamingPlatform, StringFormat=配信先：{0}}"
                                                   Foreground="LightGray" FontSize="10"/>
                                        <TextBlock Text="{Binding StreamingUrl}"
                                                   Foreground="#FF91D8CD" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StreamingUrl}"/>
                                    </StackPanel>

                                    <!-- 削除ボタン -->
                                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                                Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Width="22" Height="22" FontSize="14"
                                                Style="{StaticResource FriendDangerButtonStyle}"
                                                Click="SelectedFriendButton_Click">
                                            <TextBlock Text="×" Padding="0,0,0,2"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                            <Border Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <Grid Grid.Column="2" Background="#FF3A3A3A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="OpenFriendRegistrationButton"
                        Content="＋ フレンドを追加" Height="32"
                        Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                        Visibility="Collapsed" Click="OpenFriendRegistrationButton_Click"/>
            <StackPanel x:Name="InlineFriendRegistrationPanel">
                <Label Content="※追加したいユーザーIDを入れて追加ボタンを押す" Foreground="White"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0, 0, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Name="FriendAddTextBox" Grid.Column="0"></TextBox>
                    <Button Name="FriendAddButton" Grid.Column="1" Margin="8, 0, 0, 0" Click="FriendAddButton_Click" >追加</Button>
                </Grid>
            </StackPanel>
            </Grid>

            <Grid Height="Auto" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="※クリックすると左の選択ユーザーに追加される" Foreground="White"/>

                <ListBox Grid.Row="1" x:Name="FriendListBox"
                         d:ItemsSource="{d:SampleData ItemCount=3}"
                         ItemsSource="{Binding FriendFormList}" 
                         Background="#FF404040" 
                         Height="Auto" Width="Auto" 
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         SelectionChanged="FriendListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Margin="8, 0, 8, 0">
                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="0"
                                          Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Grid.RowSpan="2"
                                              Width="36" Height="36" Margin="0,2,8,2"
                                              VerticalAlignment="Top">
                                            <Ellipse Fill="#FF555555"/>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="#FFD0D0D0" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding ProfileImage}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>

                                        <!-- 表示名 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White" FontSize="16" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UserId, StringFormat=（{0}）}"
                                                       Foreground="LightGray" FontSize="12"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4,0,3">
                                            <TextBlock Text="{Binding StreamingPlatform, StringFormat=配信先：{0}}"
                                                       Foreground="LightGray" FontSize="10"/>
                                            <TextBlock Text="{Binding StreamingUrl}"
                                                       Foreground="#FF91D8CD" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StreamingUrl}"/>
                                        </StackPanel>

                                        <!-- 削除ボタン -->
                                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                                    Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="編集" Height="22" Margin="0,0,5,0"
                                                    Style="{StaticResource FriendSecondaryButtonStyle}"
                                                    Click="FriendEditButton_Click"/>
                                            <Button Width="22" Height="22" FontSize="14"
                                                    Style="{StaticResource FriendDangerButtonStyle}"
                                                    Click="FriendDeleteButton_Click">
                                                <TextBlock Text="×" Padding="0,0,0,2"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>

                                <Border Width="Auto" Height="2" Background="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

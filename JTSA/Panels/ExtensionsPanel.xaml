<UserControl x:Class="JTSA.Panels.ExtensionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF404040">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="プラグインフォルダ ↗" Width="150" Height="28" Margin="0,0,8,0"
                    Foreground="White" Background="#FF565656" BorderBrush="#FF777777"
                    Click="OpenPluginFolderButton_Click"/>
            <Button Content="再読み込み" Width="100" Height="28"
                    Foreground="White" Background="#FF565656" BorderBrush="#FF777777"
                    Click="ReloadButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Background="#FF353535" BorderBrush="#FF606060"
                      BorderThickness="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Plugins, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="7">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="245" MinHeight="150" Margin="5" Padding="12"
                            Background="#FF454545" BorderBrush="#FF696969"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding VersionText}" Foreground="#FF9FD8CF" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <TextBlock Text="{Binding Description}" Foreground="LightGray" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Status}" Foreground="#FF91D8CD" Margin="0,7,0,0" FontSize="11"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <CheckBox Content="自動起動" Foreground="White" VerticalAlignment="Center"
                                          IsChecked="{Binding IsAutoStart, Mode=TwoWay}"/>
                                <Button Content="開く" Width="90" Height="30" Tag="{Binding}"
                                        HorizontalAlignment="Right"
                                        Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                                        Click="OpenButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding LoadErrors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Foreground="#FFFF8A91" TextWrapping="Wrap"/></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

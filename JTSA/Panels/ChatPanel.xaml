<UserControl x:Class="JTSA.Panels.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListBox Grid.Row="2" x:Name="ChatListBox" 
                 ItemsSource="{Binding TwitchChatFormList}"
                 d:ItemsSource="{d:SampleData ItemCount = 3}"
                 Height="Auto" Width="Auto"
                 Background="#FF404040" 
                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Margin="8, 0, 8, 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                       Height="48"
                                       Stretch="UniformToFill"/>

                                <!-- アイテム上部ステータス部分 -->
                                <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- ユーザー名 -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="White" 
                                                   FontSize="14" >
                                        </TextBlock>

                                        <!-- ユーザー名 -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White" 
                                                   FontSize="14" >
                                        </TextBlock>
                                    </Grid>
                                    
                                    <!-- メッセージ -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="{Binding Message}"
                                               d:Text="Message"
                                               TextWrapping="Wrap"
                                               Width="Auto" 
                                               Foreground="White" 
                                               FontSize="20" >
                                    </TextBlock>

                                    <!-- 受信日時 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="{Binding LastUsedDate}"
                                               d:Text="9999/99/99"
                                               Width="Auto" 
                                               FontSize="12" Foreground="White"
                                               HorizontalAlignment="Right">
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="1" 
                                Orientation="Vertical">
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Width="Auto" Height="2" Background="White"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

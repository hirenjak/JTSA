<UserControl x:Class="JTSA.Panels.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="チャット通知音量"
                    Width="Auto" 
                           Foreground="White"
                           FontSize="14" />

                <Slider x:Name="ChatNotificationVolumeSlider"
                    Width="200"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="10"
                    IsSnapToTickEnabled="False"
                    ValueChanged="ChatNotificationVolumeSlider_ValueChanged"/>

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="チャット参加音量"
                    Width="Auto" 
                           Foreground="White"
                           FontSize="14" />
                <Slider x:Name="JoinChatVolumeSlider"
                        Width="200"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="False"
                        ValueChanged="JoinChatVolumeSlider_ValueChanged"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ChatListBox" 
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Height="Auto" Width="Auto" 
                      Background="#FF404040" >
            <ItemsControl ItemsSource="{Binding TwitchChatFormList}"
                          d:ItemsSource="{d:SampleData ItemCount = 3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Margin="8, 4, 8, 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="42" Height="42">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="{Binding ColorHex}"
                                                   FontSize="14" >
                                            </TextBlock>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White"
                                                   FontSize="14" >
                                            </TextBlock>
                                        </Grid>

                                        <!-- メッセージ -->
                                        <TextBox  Grid.Row="1" Grid.Column="0" 
                                              Text="{Binding Message}"
                                              IsReadOnly="True"
                                              BorderThickness="0"
                                              Background="Transparent" CaretBrush="Transparent"
                                              FocusVisualStyle="{x:Null}"
                                              AcceptsReturn="True"
                                              Padding="0" Margin="0"
                                              d:Text="Message"
                                              TextWrapping="Wrap"
                                              Width="Auto" 
                                              Foreground="{Binding MessageColor}" 
                                              FontSize="20" >
                                        </TextBox>

                                        <!-- 受信日時 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="{Binding CreatedDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                               d:Text="9999/99/99"
                                               Width="Auto" 
                                               FontSize="12" Foreground="White"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="1" 
                                                Orientation="Vertical">
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

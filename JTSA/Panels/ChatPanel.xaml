<UserControl x:Class="JTSA.Panels.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JTSA.Controls"
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ParticipationInputStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UserInput}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UserInput}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="OverlaySettingsVisibilityConverter"/>
        <Style x:Key="OverviewPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF285653"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="OverviewSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="OverviewDeleteButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFF6F78"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static local:ChatPanel.AddFriendCommand}"
                        Executed="AddChatUserToFriendCommand_Executed"/>
        <CommandBinding Command="{x:Static local:ChatPanel.AddParticipationCommand}"
                        Executed="AddChatUserToParticipation_Executed"/>
    </UserControl.CommandBindings>
    <Grid
        Margin="8, 4, 8, 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ParticipationManagementColumn" Width="0"/><ColumnDefinition x:Name="ChatUserListColumn" Width="210"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel 
            Grid.Row="0"
            Grid.Column="0">

<StackPanel>
<Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal"><ToggleButton x:Name="OverlaySettingsToggleButton"
                                      Content="オーバーレイ設定 ☰" IsChecked="False"
                                      Height="22" Padding="8,0" FontSize="11"
                                      HorizontalAlignment="Left" Cursor="Hand"
                                      Foreground="White" Background="#FF565656"
                                      BorderBrush="#FF777777" BorderThickness="1"
                                      ToolTip="オーバーレイ設定を表示／非表示にします">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0" SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FF464646"/>
                                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FF555555"/>
                                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1,1,1,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton><ToggleButton x:Name="NotificationSettingsToggleButton"
                                      Content="通知音設定 ☰" IsChecked="False"
                                      Height="22" Margin="8,0,0,0" Padding="8,0" FontSize="11"
                                      HorizontalAlignment="Left" Cursor="Hand"
                                      Foreground="White" Background="#FF565656"
                                      BorderBrush="#FF777777" BorderThickness="1"
                                      Template="{Binding Template, ElementName=OverlaySettingsToggleButton}"
                                      ToolTip="通知音量・参加音量の設定を表示／非表示にします"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ParticipationManagementToggleButton"
                                Content="参加型管理 ＞" Margin="8,0,0,0" Padding="8,0"
                                Height="22" VerticalAlignment="Top"
                                Style="{StaticResource OverviewSecondaryButtonStyle}"
                                ToolTip="参加管理エリアとOBSの参加一覧を表示／非表示にします"
                                Click="ParticipationManagementToggleButton_Click"/>
                        <Button Margin="8,0,0,0"
                        x:Name="ChatUserListToggleButton"
                        Visibility="Collapsed"
                        Content="ユーザー一覧 ＞"
                        ToolTip="ユーザー一覧を表示／非表示にします"
                        Padding="8,0"
                        Height="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource OverviewSecondaryButtonStyle}"
                        Click="ChatUserListToggleButton_Click"/></StackPanel>
</Grid>
<WrapPanel Margin="0,0,0,8"><Grid Width="380" Margin="0,6,0,0"
                              Visibility="{Binding IsChecked, ElementName=OverlaySettingsToggleButton, Converter={StaticResource OverlaySettingsVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Button x:Name="TransparentWindowOpenButton"
                                        Content="表示切替" Height="24"
                                        Style="{StaticResource OverviewSecondaryButtonStyle}"
                                        Click="TransparentWindowOpen_Click"/>
                                <Button x:Name="TransparentWindowSettingButton"
                                        Content="位置調整モード切替" Height="24" Margin="0,3,0,0"
                                        Style="{StaticResource OverviewSecondaryButtonStyle}"
                                        Click="TransparentWindowOpenSetting_Click"/>
                                <Button x:Name="TransparentWindowRecreateButton"
                                        Content="ウィンドウ再生成" Height="24" Margin="0,3,0,0"
                                        Style="{StaticResource OverviewSecondaryButtonStyle}"
                                        ToolTip="停止したチャットオーバーレイのウィンドウを作り直します"
                                        Click="TransparentWindowRecreate_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="文字サイズ" Foreground="White" FontSize="12"
                                               Width="58" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatOverlayFontSizeSlider" Width="130"
                                            Minimum="10" Maximum="36" TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="ChatOverlayFontSizeSlider_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="背景透過度" Foreground="White" FontSize="12"
                                               Width="58" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatOverlayBackgroundOpacitySlider" Width="130"
                                            Minimum="0" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ToolTip="右に動かすほど背景が濃くなります"
                                            ValueChanged="ChatOverlayBackgroundOpacitySlider_ValueChanged"/>
                                </StackPanel>
                                <CheckBox x:Name="ChatOverlayShowIconCheckBox"
                                          Content="アイコン表示" Foreground="White" Margin="0,5,0,0"
                                          Checked="ChatOverlayShowIconCheckBox_Changed"
                                          Unchecked="ChatOverlayShowIconCheckBox_Changed"/>
                                <CheckBox x:Name="IsStartShowChatOverlayDisp"
                                          Content="アプリ開始時表示" Foreground="White" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid><StackPanel Width="332" Margin="0,6,0,0"
                                    Visibility="{Binding IsChecked, ElementName=NotificationSettingsToggleButton, Converter={StaticResource OverlaySettingsVisibilityConverter}}">

                    <StackPanel 
                        Orientation="Horizontal">

                        <TextBlock 
                            Text="通知音量"
                            Width="58"
                            Foreground="White" FontSize="12"
                            VerticalAlignment="Center" />

                        <Slider 
                            x:Name="ChatNotificationVolumeSlider"
                            Width="130"
                            Minimum="0" Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ChatNotificationVolumeSlider_ValueChanged"/>
                        <Button Content="音源変更" Width="68" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource OverviewSecondaryButtonStyle}"
                                Click="ChatNotificationAudioChangeButton_Click"/>

                    </StackPanel>

                    <StackPanel 
                        Orientation="Horizontal">
                        <TextBlock 
                            Text="参加音量"
                            Width="58"
                            Foreground="White" FontSize="12"
                            VerticalAlignment="Center" />
                        <Slider 
                            x:Name="JoinChatVolumeSlider"
                            Width="130"
                            Minimum="0" Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="JoinChatVolumeSlider_ValueChanged"/>
                        <Button Content="音源変更" Width="68" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource OverviewSecondaryButtonStyle}"
                                Click="JoinChatAudioChangeButton_Click"/>
                    </StackPanel>

                </StackPanel></WrapPanel>
</StackPanel>
            
            <!-- チャット送信部 -->
            <Grid
                Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Grid.Column="0" x:Name="sendChatButton" Content="送信" 
                    Style="{StaticResource OverviewPrimaryButtonStyle}"
                    Margin="2, 0, 0, 0"/>
                
                <Button 
                    Grid.Column="1" x:Name="pinedChatButton" Content="ピン留め" 
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource OverviewPrimaryButtonStyle}"
                    Margin="4, 0, 0, 0"/>

                <TextBox 
                    Grid.Column="2"
                    x:Name="sendChatTextBox"
                    Margin="8, 0, 0, 0"
                    Foreground="Black" FontSize="14"
                    Background="White"
                    KeyDown="SendChatTextBox_KeyDown"/>
            </Grid>

            <Border Margin="0, 8, 0, 0" Width="Auto" Height="2" Background="White"/>
            
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="ChatListBox"
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Height="Auto" Width="Auto" 
                      Background="#FF404040" >
            <ItemsControl ItemsSource="{Binding TwitchChatFormList}"
                          d:ItemsSource="{d:SampleData ItemCount = 3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Margin="8, 4, 8, 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="42" Height="42">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="{Binding HexColor}"
                                                   FontSize="14" >
                                            </TextBlock>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White"
                                                   FontSize="14" >
                                            </TextBlock>
                                        </Grid>

                                        <!-- メッセージ -->
                                        <controls:TwitchMessageRichTextBox 
                                            Grid.Row="1" Grid.Column="0" 
                                            MessageParts="{Binding MessageParts}"
                                            Foreground="{Binding MessageColor}" 
                                            FontSize="16"
                                            IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            IsTabStop="False"
                                            IsUndoEnabled="False"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Hidden"/>

                                        <!-- 受信日時 -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                               Text="{Binding CreatedDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                               d:Text="9999/99/99"
                                               Width="Auto" 
                                               FontSize="12" Foreground="White"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <StackPanel
            Grid.Row="2"
            Grid.Column="0">
            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>

            <ScrollViewer Grid.Row="1" x:Name="PinedChatListBox" 
                  HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Height="Auto" Width="Auto" 
                  Background="#FF404040" >
                <ItemsControl ItemsSource="{Binding PinedTwitchChatFormList}"
                      d:ItemsSource="{d:SampleData ItemCount = 1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Margin="8, 4, 8, 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="42" Height="42">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- アイテム上部ステータス部分 -->
                                        <Grid Grid.Column="1"
                                  Margin="8, 0, 0, 0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ユーザー名 -->
                                                <TextBlock Grid.Column="0" 
                                                    Text="{Binding DisplayName}"
                                                    d:Text="GamePlayListName"
                                                    Width="Auto" 
                                                    Foreground="{Binding HexColor}"
                                                    FontSize="14" >
                                                </TextBlock>

                                                <!-- ユーザー名 -->
                                                <TextBlock Grid.Column="1" 
                                                    Text="{Binding UserName, StringFormat=({0})}"
                                                    d:Text="GamePlayListName"
                                                    Width="Auto" 
                                                    Margin="4, 0, 0, 0"
                                                    Foreground="White"
                                                    FontSize="14" >
                                                </TextBlock>
                                            </Grid>

                                            <!-- メッセージ -->
                                            <controls:TwitchMessageRichTextBox 
                                                Grid.Row="1" Grid.Column="0" 
                                                MessageParts="{Binding MessageParts}"
                                                Foreground="{Binding MessageColor}" 
                                                FontSize="16"
                                                IsReadOnly="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                IsTabStop="False"
                                                IsUndoEnabled="False"
                                                VerticalScrollBarVisibility="Hidden"
                                                HorizontalScrollBarVisibility="Hidden"/>

                                            <!-- 受信日時 -->
                                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                                Text="{Binding CreatedDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                                d:Text="9999/99/99"
                                                Width="Auto" 
                                                FontSize="12" Foreground="White"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                            </TextBlock>
                                        </Grid>
                
                <Button 
                    Grid.Column="2" x:Name="PinedChatPurgeButton" Content="解除"
                    Tag="{Binding MessageId}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="8, 0, 0, 0"
                    Style="{StaticResource OverviewDeleteButtonStyle}"
                    Click="PinedChatPurgeButton_Click"/>
                                    </Grid>
                                </StackPanel>
                                <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>

        <Border x:Name="ParticipationManagementPanel" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="8,0,0,0"
                Background="#FF303030" BorderBrush="#FF606060" BorderThickness="1">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="更新" Click="ReloadParticipationRewards" Width="44" Margin="5,0,0,0"
                                ToolTip="チャネポ一覧を更新" Style="{StaticResource OverviewSecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="×" Width="24" Height="22" Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="参加型管理を閉じる" AutomationProperties.Name="参加型管理を閉じる"
                                Style="{StaticResource OverviewDeleteButtonStyle}"
                                Click="ParticipationManagementToggleButton_Click"/>
                        <ComboBox Grid.Column="0" x:Name="ParticipationRewardComboBox" DisplayMemberPath="Title" SelectedValuePath="Id"
                                  SelectionChanged="ParticipationReward_Changed"/>
                    </Grid>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="試合－" Tag="-1" Click="AdjustParticipationCount_Click" Padding="4,0"
                                ToolTip="現在一緒にやっている人全員の試合数を1減らす" Style="{StaticResource OverviewSecondaryButtonStyle}"/>
                        <Button Grid.Column="1" Content="試合＋" Tag="1" Click="AdjustParticipationCount_Click" Margin="4,0" Padding="4,0"
                                ToolTip="現在一緒にやっている人全員の試合数を1増やす" Style="{StaticResource OverviewSecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="一覧リセット" ToolTip="参加者一覧と保存済みの参加回数を全員リセット" Click="ClearParticipation_Click" Style="{StaticResource OverviewSecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,4,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBox x:Name="ParticipationSlotCountTextBox" Width="36" MaxLength="3" VerticalContentAlignment="Center"
                                     TextAlignment="Right" ToolTip="枠数（0～999）。空欄は未設定" TextChanged="ParticipationSlotCount_Changed"/>
                            <TextBlock Text="枠" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlayingParticipationUsers.Count, RelativeSource={RelativeSource AncestorType={x:Type local:ChatPanel}}, StringFormat=プレイ中 ({0})}"
                                   Foreground="LightCoral" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                <ListBox AllowDrop="True" PreviewMouseLeftButtonDown="Participation_PreviewMouseLeftButtonDown" PreviewMouseMove="Participation_PreviewMouseMove" PreviewDragOver="Participation_DragOver" Drop="Participation_Drop" ToolTip="ドラッグで移動・並べ替え" Grid.Row="1" ItemsSource="{Binding PlayingParticipationUsers, RelativeSource={RelativeSource AncestorType={x:Type local:ChatPanel}}}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <DockPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="参加待ちに戻す" Click="ReturnParticipation_Click"/><Separator/>
                                        <MenuItem Header="試合数を1増やす" Tag="1" Click="AdjustIndividualParticipationCount_Click"/>
                                        <MenuItem Header="試合数を1減らす" Tag="-1" Click="AdjustIndividualParticipationCount_Click"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <Button DockPanel.Dock="Right" Content="×" ToolTip="参加者から外す" Click="RemoveParticipation_Click"
                                        Style="{StaticResource OverviewDeleteButtonStyle}" Width="24"/>
                                <Ellipse DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ProfileImageUrl}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RedeemedAt, StringFormat={}{0:HH:mm}}" Foreground="LightSeaGreen" FontSize="11"/>
                                        <TextBlock Text="{Binding MatchCount, StringFormat={}{0}試合参加済み}" Foreground="LightSeaGreen" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UserInput}" Style="{StaticResource ParticipationInputStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding ParticipationUsers.Count, RelativeSource={RelativeSource AncestorType={x:Type local:ChatPanel}}, StringFormat=参加待ち ({0})}"
                               Foreground="White" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <ListBox AllowDrop="True" PreviewMouseLeftButtonDown="Participation_PreviewMouseLeftButtonDown" PreviewMouseMove="Participation_PreviewMouseMove" PreviewDragOver="Participation_DragOver" Drop="Participation_Drop" ToolTip="ドラッグで移動・並べ替え" Grid.Row="3" ItemsSource="{Binding ParticipationUsers, RelativeSource={RelativeSource AncestorType={x:Type local:ChatPanel}}}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1"><DockPanel.ContextMenu>
<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
<MenuItem Header="一緒にプレイする" Click="StartParticipation_Click"/>
</ContextMenu>
</DockPanel.ContextMenu>
                                <Button DockPanel.Dock="Right" Content="×" ToolTip="参加者から外す" Click="RemoveParticipation_Click"
                                        Style="{StaticResource OverviewDeleteButtonStyle}" Width="24"/>
                                <Ellipse DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ProfileImageUrl}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RedeemedAt, StringFormat={}{0:HH:mm}}" Foreground="LightSeaGreen" FontSize="11"/>
                                        <TextBlock Text="{Binding ParticipationCount, StringFormat=参加 {0}回}" Foreground="LightSeaGreen" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UserInput}" Style="{StaticResource ParticipationInputStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- この配信中に発言したユーザー。最新発言者を先頭に表示する。 -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"
                x:Name="ChatUserListPanel"
                Margin="8,0,0,0"
                Background="#FF303030"
                BorderBrush="#FF606060"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="10,0,6,0">
                    <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                            VerticalAlignment="Center" Margin="4,0,0,0"
                            ToolTip="ユーザー一覧を閉じる" AutomationProperties.Name="ユーザー一覧を閉じる"
                            Style="{StaticResource OverviewDeleteButtonStyle}"
                            Click="ChatUserListToggleButton_Click"/>
                <TextBlock
                           Text="{Binding ChatUserFormList.Count, StringFormat=チャットユーザー ({0})}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ChatUserFormList}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel.ContextMenu>
                                    <ContextMenu Opened="ChatUserContextMenu_Opened">
                                        <MenuItem Header="参加待ちに追加"
                                                  Command="{x:Static local:ChatPanel.AddParticipationCommand}"/>
                                        <MenuItem Header="フレンドに追加"
                                                  Command="{x:Static local:ChatPanel.AddFriendCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="36" Height="36">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfileImageUrl}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                   Foreground="LightGray"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MessageCount, StringFormat={}{0}件}"
                                                   Foreground="LightSeaGreen"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding LastChatDateTime, StringFormat={}{0:HH:mm}}"
                                                   Foreground="LightGray"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#FF505050"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

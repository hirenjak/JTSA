<UserControl x:Class="JTSA.Panels.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JTSA.Controls"
             xmlns:local="clr-namespace:JTSA.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static local:ChatPanel.AddFriendCommand}"
                        Executed="AddChatUserToFriendCommand_Executed"/>
    </UserControl.CommandBindings>
    <Grid
        Margin="8, 4, 8, 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ChatUserListColumn" Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel 
            Grid.Row="0"
            Grid.ColumnSpan="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0" 
                    Margin="0, 0, 0, 0">

                    <StackPanel 
                        Orientation="Horizontal">

                        <TextBlock 
                            Text="チャット通知音量"
                            Width="Auto" 
                            Foreground="White" FontSize="14" />

                        <Slider 
                            x:Name="ChatNotificationVolumeSlider"
                            Width="200"
                            Minimum="0" Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ChatNotificationVolumeSlider_ValueChanged"/>

                    </StackPanel>

                    <StackPanel 
                        Orientation="Horizontal">
                        <TextBlock 
                            Text="チャット参加音量"
                            Width="Auto" 
                            Foreground="White" FontSize="14" />
                        <Slider 
                            x:Name="JoinChatVolumeSlider"
                            Width="200"
                            Minimum="0" Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="JoinChatVolumeSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Height="28">

                        <TextBlock 
                            Text="アプリ開始時表示"
                            Width="Auto" 
                            Foreground="White" FontSize="14" 
                            VerticalAlignment="Center"/>
                        <CheckBox 
                            x:Name="IsStartShowChatOverlayDisp" 
                            Margin="4, 2, 0, 0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1" 
                    Orientation="Vertical"
                    Margin="8, 0, 0, 0">

                    <Button 
                        x:Name="TransparentWindowOpenButton" 
                        Content="オーバーレイ切替" 
                        HorizontalAlignment="Stretch"
                        Height="28"
                        Click="TransparentWindowOpen_Click"/>

                    <Button x:Name="TransparentWindowSettingButton" 
                        Content="位置調整モード切替" 
                        HorizontalAlignment="Stretch"
                        Height="28"
                        Margin="0, 4, 0, 0"
                        Click="TransparentWindowOpenSetting_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="12,0,150,0">
                    <StackPanel>
                        <TextBlock Text="文字サイズ" Foreground="White" FontSize="12"/>
                        <Slider x:Name="ChatOverlayFontSizeSlider" Width="130"
                                Minimum="10" Maximum="36" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ChatOverlayFontSizeSlider_ValueChanged"/>
                    </StackPanel>
                    <CheckBox x:Name="ChatOverlayShowIconCheckBox"
                              Content="アイコン表示" Foreground="White"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              Checked="ChatOverlayShowIconCheckBox_Changed"
                              Unchecked="ChatOverlayShowIconCheckBox_Changed"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="ChatUserListToggleButton"
                        Content="ユーザー一覧を隠す"
                        Width="136"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="ChatUserListToggleButton_Click"/>

            </Grid>
            
            <!-- チャット送信部 -->
            <Grid
                Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Grid.Column="0" x:Name="sendChatButton" Content="送信" 
                    Margin="2, 0, 0, 0"/>
                
                <Button 
                    Grid.Column="1" x:Name="pinedChatButton" Content="ピン留め" 
                    HorizontalAlignment="Stretch"
                    Margin="4, 0, 0, 0"/>

                <TextBox 
                    Grid.Column="2"
                    x:Name="sendChatTextBox"
                    Margin="8, 0, 0, 0"
                    Foreground="Black" FontSize="14"
                    Background="LightGray"/>
            </Grid>

            <Border Margin="0, 8, 0, 0" Width="Auto" Height="2" Background="White"/>
            
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="ChatListBox"
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Height="Auto" Width="Auto" 
                      Background="#FF404040" >
            <ItemsControl ItemsSource="{Binding TwitchChatFormList}"
                          d:ItemsSource="{d:SampleData ItemCount = 3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Margin="8, 4, 8, 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="42" Height="42">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- アイテム上部ステータス部分 -->
                                    <Grid Grid.Column="1"
                                      Margin="8, 0, 0, 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="0" 
                                                   Text="{Binding DisplayName}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Foreground="{Binding HexColor}"
                                                   FontSize="14" >
                                            </TextBlock>

                                            <!-- ユーザー名 -->
                                            <TextBlock Grid.Column="1" 
                                                   Text="{Binding UserName, StringFormat=({0})}"
                                                   d:Text="GamePlayListName"
                                                   Width="Auto" 
                                                   Margin="4, 0, 0, 0"
                                                   Foreground="White"
                                                   FontSize="14" >
                                            </TextBlock>
                                        </Grid>

                                        <!-- メッセージ -->
                                        <controls:TwitchMessageRichTextBox 
                                            Grid.Row="1" Grid.Column="0" 
                                            MessageParts="{Binding MessageParts}"
                                            Foreground="{Binding MessageColor}" 
                                            FontSize="16"
                                            IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            IsTabStop="False"
                                            IsUndoEnabled="False"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Hidden"/>

                                        <!-- 受信日時 -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                               Text="{Binding CreatedDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                               d:Text="9999/99/99"
                                               Width="Auto" 
                                               FontSize="12" Foreground="White"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <StackPanel
            Grid.Row="2"
            Grid.Column="0">
            <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>

            <ScrollViewer Grid.Row="1" x:Name="PinedChatListBox" 
                  HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Height="Auto" Width="Auto" 
                  Background="#FF404040" >
                <ItemsControl ItemsSource="{Binding PinedTwitchChatFormList}"
                      d:ItemsSource="{d:SampleData ItemCount = 1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Margin="8, 4, 8, 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="42" Height="42">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding ProfielImageUrl}" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- アイテム上部ステータス部分 -->
                                        <Grid Grid.Column="1"
                                  Margin="8, 0, 0, 0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ユーザー名 -->
                                                <TextBlock Grid.Column="0" 
                                                    Text="{Binding DisplayName}"
                                                    d:Text="GamePlayListName"
                                                    Width="Auto" 
                                                    Foreground="{Binding HexColor}"
                                                    FontSize="14" >
                                                </TextBlock>

                                                <!-- ユーザー名 -->
                                                <TextBlock Grid.Column="1" 
                                                    Text="{Binding UserName, StringFormat=({0})}"
                                                    d:Text="GamePlayListName"
                                                    Width="Auto" 
                                                    Margin="4, 0, 0, 0"
                                                    Foreground="White"
                                                    FontSize="14" >
                                                </TextBlock>
                                            </Grid>

                                            <!-- メッセージ -->
                                            <controls:TwitchMessageRichTextBox 
                                                Grid.Row="1" Grid.Column="0" 
                                                MessageParts="{Binding MessageParts}"
                                                Foreground="{Binding MessageColor}" 
                                                FontSize="16"
                                                IsReadOnly="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                IsTabStop="False"
                                                IsUndoEnabled="False"
                                                VerticalScrollBarVisibility="Hidden"
                                                HorizontalScrollBarVisibility="Hidden"/>

                                            <!-- 受信日時 -->
                                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                                Text="{Binding CreatedDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                                d:Text="9999/99/99"
                                                Width="Auto" 
                                                FontSize="12" Foreground="White"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                            </TextBlock>
                                        </Grid>
                
                <Button 
                    Grid.Column="2" x:Name="PinedChatPurgeButton" Content="解除"
                    Tag="{Binding MessageId}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="8, 0, 0, 0"
                    Click="PinedChatPurgeButton_Click"/>
                                    </Grid>
                                </StackPanel>
                                <Border Margin="0, 4, 0, 0" Width="Auto" Height="2" Background="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>

        <!-- この配信中に発言したユーザー。最新発言者を先頭に表示する。 -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                x:Name="ChatUserListPanel"
                Margin="8,0,0,0"
                Background="#FF303030"
                BorderBrush="#FF606060"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding ChatUserFormList.Count, StringFormat=チャットユーザー ({0})}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="10,0"
                           VerticalAlignment="Center"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ChatUserFormList}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel.ContextMenu>
                                    <ContextMenu Opened="ChatUserContextMenu_Opened">
                                        <MenuItem Header="フレンドに追加"
                                                  Command="{x:Static local:ChatPanel.AddFriendCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="36" Height="36">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfileImageUrl}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                   Foreground="LightGray"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MessageCount, StringFormat={}{0}件}"
                                                   Foreground="LightSeaGreen"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding LastChatDateTime, StringFormat={}{0:HH:mm}}"
                                                   Foreground="LightGray"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#FF505050"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

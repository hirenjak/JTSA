<UserControl x:Class="JTSA.Panels.PlayingGamePanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0"
            Margin="16">

            <StackPanel DockPanel.Dock="Top">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="プレイリスト名"
                               Foreground="White">
                    </TextBlock>
                    <TextBox Grid.Column="1" x:Name="GamePlayListTitleEdit"
                                 Width="Auto">
                    </TextBox>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16">

                    <Button Content="OBS用HTMLを書き出し"
                            Width="160"
                            Click="ExportButton_Click"/>
                    <Button Content="新規保存"
                            Width="160"
                            Click="GamePlayListSaveButton_Click"/>
                    <Button Content="上書き"
                            Width="160"
                            Click="GamePlayListUpdateButton_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer>
                <ItemsControl x:Name="ImageItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230"
                                    Height="107"
                                    Margin="8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="ImageItem_Click"
                                    MouseRightButtonUp="ImageItem_RightClick">

                                <Grid>
                                    <Image Source="{Binding ImageUrl}"
                                           Stretch="UniformToFill"/>

                                    <Border Background="#88000000"
                                            Visibility="{Binding CompletedVisibility}">

                                        <TextBlock Text="完了"
                                           Foreground="#00FF80"
                                           FontSize="30" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Border 
                                        Background="#FF2196F3"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Margin="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding PlayingVisibility}">

                                        <TextBlock Text="プレイ中"
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                    </Border>

                                    <Button Content="×"
                                            Width="18"
                                            Height="18"
                                            FontSize="9"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="DeleteButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

        <ListBox Grid.Row="1" Grid.Column="1" 
                 x:Name="GamePlayListBox" 
                 d:ItemsSource="{d:SampleData ItemCount = 3}" 

                 Height="Auto" Width="Auto"
                 Background="#FF404040" 
                 
                 HorizontalAlignment="Stretch" 
                 HorizontalContentAlignment="Stretch"
                 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Margin="8, 0, 8, 0">
                            <TextBlock Text="{Binding GamePlayListName}"
                                   d:Text="aaaa"
                                   Width="Auto" 
                                   Foreground="White" 
                                   FontSize="16"
                                   Visibility="{Binding IsLoaded, 
                                       Converter={StaticResource BooleanToVisibilityConverter}}">
                            </TextBlock>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"  Source="{Binding ImageUrl}"
                                       Stretch="UniformToFill"/>

                                <StackPanel Grid.Column="1" 
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding GamePlayListName}"
                                               d:Text="GamePlayListName"
                                               Width="Auto" 
                                               Foreground="White" 
                                               FontSize="16" >
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding GamePlayListName}"
                                   d:Text="9999/99/99"
                                   Width="Auto" 
                                   Foreground="White" 
                                   FontSize="16" >
                        </TextBlock>

                        <Border Width="Auto" Height="2" Background="White"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

<Window x:Class="JTSA.Panels.FriendSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:JTSA.Panels"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="フレンド選択" Width="760" Height="620"
        MinWidth="620" MinHeight="460" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF404040">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF404040">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <controls:CategoryStyleTitleBar/>
 <DockPanel Grid.Row="1" Margin="10">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
   <Button Content="選択を確定" Width="100" Height="30" IsDefault="True" Click="ConfirmButton_Click"/>
  </StackPanel>
  <panels:FriendPanel x:Name="SelectionPanel"/>
 </DockPanel>
 </Grid>
 </Border>
</Window>

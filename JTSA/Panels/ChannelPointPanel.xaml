<UserControl x:Class="JTSA.Panels.ChannelPointPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">

    <UserControl.Resources>
        <Style x:Key="CpNavigationTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#FF454B4B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#FF344D4B"/>
                                <Setter TargetName="NavBackground" Property="BorderBrush" Value="LightSeaGreen"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CpSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CpPaneTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CpFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC8C8C8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="CpDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBDBDBD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CpSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF565656"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CpOverviewTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </Style>
        <Style x:Key="CpCardListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CpCardListStyle" TargetType="ListView">
            <Setter Property="Background" Value="#FF383838"/>
            <Setter Property="BorderBrush" Value="#FF5E5E5E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CpCardListItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RewardList_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="MouseMove" Handler="RewardList_MouseMove"/>
            <EventSetter Event="PreviewDragOver" Handler="RewardList_DragOver"/>
            <EventSetter Event="Drop" Handler="RewardList_Drop"/>
        </Style>

        <DataTemplate x:Key="CpRewardCardTemplate">
            <Border BorderThickness="1" CornerRadius="3" Padding="8" Margin="3" Cursor="SizeAll">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF505050"/>
                        <Setter Property="BorderBrush" Value="#FF686868"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManageable}" Value="False">
                                <Setter Property="Background" Value="#FF353535"/>
                                <Setter Property="BorderBrush" Value="#FF464646"/>
                                <Setter Property="Opacity" Value="0.68"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ImageUrl}" Width="34" Height="34"
                           Stretch="Uniform" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding ManageableMark}" ToolTip="{Binding ManageableToolTip}"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource CpDescriptionStyle}" Margin="0,3,0,0">
                            <Run Text="コスト "/><Run Text="{Binding Cost}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Width="20" Height="20" Margin="0,0,0,0" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0"
                            FontSize="16" Content="×" ToolTip="この報酬を削除"
                            Visibility="{Binding DeleteButtonVisibility}" Tag="{Binding}"
                            Click="DeleteRewardButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8" Background="#FF303030">
      <TabControl TabStripPlacement="Left" ItemContainerStyle="{StaticResource CpNavigationTabStyle}"
                  Background="#FF383838" BorderThickness="0"
                  SelectionChanged="CpNavigationTabControl_SelectionChanged">
       <TabItem x:Name="CpSettingsTab" Header="CP設定"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <Grid Background="#FF404040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,4,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CP一覧" Style="{StaticResource CpSectionTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CpManagementReloadButton" Grid.Column="1" Content="更新"
                            Width="44" Margin="5,0,0,0" HorizontalAlignment="Right"
                            Style="{StaticResource CpSecondaryButtonStyle}"
                            Click="ReloadButton_Click"/>
                </Grid>
                <Border Grid.Row="1" BorderBrush="#FF606060" BorderThickness="1">
                 <DockPanel LastChildFill="True">
                  <Grid DockPanel.Dock="Top" Margin="4">
                    <Button Content="＋ CPを追加" Height="30" Padding="8,0"
                            HorizontalContentAlignment="Left" Foreground="White"
                            Background="#FF285653" BorderBrush="LightSeaGreen"
                            Click="CreateRewardButton_Click"/>
                  </Grid>
            <ListView x:Name="CpManagementListView"
                      ItemsSource="{Binding ChannelPointRewardFormList}"
                      Background="#FF404040" BorderThickness="0"
                      HorizontalContentAlignment="Stretch"
                      SelectionChanged="CpManagementListView_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding ImageUrl}" Width="42" Height="42"
                                   Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ManageableMark}" ToolTip="{Binding ManageableToolTip}"
                                               Foreground="White" FontSize="15" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="White"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CpDescriptionStyle}" Margin="0,3,0,0">
                                    <Run Text="{Binding Cost}"/><Run Text=" CP"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="複製" Width="44" Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CpSecondaryButtonStyle}"
                                    Visibility="{Binding CopyButtonVisibility}" Tag="{Binding}"
                                    ToolTip="このCPをアプリ側で操作可能なCPとして複製"
                                    Click="CopyRewardButton_Click"/>
                        </Grid>
                        <Border Height="2" Background="White"/>
                      </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
                 </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="0,4,8,8"
                  DataContext="{Binding SelectedItem, ElementName=CpManagementListView}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ManageableMark}" ToolTip="{Binding ManageableToolTip}"
                                   Foreground="White" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CpDetailTitleTextBlock" Text="{Binding Title}"
                                   Style="{StaticResource CpSectionTitleStyle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="CpDetailNameTextBox" Visibility="Collapsed"
                                 Width="300" Height="28" Padding="5,0"
                                 Text="{Binding Title, Mode=OneWay}" VerticalContentAlignment="Center"/>
                        <Button x:Name="CpNameEditButton" Content="✎" Width="30" Height="28" Margin="4,0,0,0"
                                Foreground="White" ToolTip="CP名を編集"
                                Visibility="{Binding EditButtonVisibility}" Click="CpNameEditButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=CpDetailNameTextBox, Path=Visibility}" Value="Visible">
                                            <Setter Property="Background" Value="#FF285653"/>
                                            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Image Grid.Column="1" Source="{Binding ImageUrl}" Width="28" Height="28"
                           Margin="8,0,0,0" Stretch="Uniform"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="コスト" Style="{StaticResource CpFieldLabelStyle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CpManagementCostTextBox" Grid.Column="1" Height="28"
                             Style="{StaticResource CpOverviewTextBoxStyle}"
                             Text="{Binding Cost, Mode=OneWay}" IsEnabled="{Binding IsManageable}"/>
                    <TextBlock Grid.Column="2" Text="CP" Style="{StaticResource CpFieldLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="説明" Style="{StaticResource CpFieldLabelStyle}" VerticalAlignment="Top"/>
                    <TextBox x:Name="CpManagementPromptTextBox" Grid.Column="1" Height="110"
                             Style="{StaticResource CpOverviewTextBoxStyle}"
                             Text="{Binding Prompt, Mode=OneWay}" IsEnabled="{Binding IsManageable}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="200"/>
                </Grid>
                <TextBlock Grid.Row="3"
                           Text="✔ はこのアプリから編集できるCPです。&#10;🔒 は Twitch の Web 画面から作成されたCPです。複製するとこのアプリから操作できます。&#10;※画像追加はTwitch公式UIのみ対応です。（画像サイズツールについてはTipsを参照）"
                           Style="{StaticResource CpDescriptionStyle}" Margin="80,6,0,0"/>
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Width="90" Height="30"
                            Visibility="{Binding EditButtonVisibility}" Tag="{Binding}"
                            Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                            Click="SaveManagedRewardButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
       </TabItem>

       <TabItem Header="有効無効設定"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <Grid Margin="0" Background="#FF404040">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状態別のCPカード。ペイン間のドラッグ＆ドロップで状態を変更する -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CpPaneTitleStyle}" Margin="2,0,0,8">
                        <Run Text="有効中のCP  "/><Run Text="{Binding EnabledChannelPointRewardFormList.Count, Mode=OneWay}"/>
                    </TextBlock>
                    <ListView x:Name="EnabledChannelPointListView" Grid.Row="1" Tag="Enabled"
                              Style="{StaticResource CpCardListStyle}"
                              BorderBrush="#FF35A887"
                              ItemTemplate="{StaticResource CpRewardCardTemplate}"
                              ItemsSource="{Binding EnabledChannelPointRewardFormList}"/>
            </Grid>

            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CpPaneTitleStyle}" Margin="2,0,0,8">
                        <Run Text="一時停止中のCP  "/><Run Text="{Binding PausedChannelPointRewardFormList.Count, Mode=OneWay}"/>
                    </TextBlock>
                    <ListView x:Name="PausedChannelPointListView" Grid.Row="1" Tag="Paused"
                              Style="{StaticResource CpCardListStyle}"
                              BorderBrush="#FFD6A33A"
                              ItemTemplate="{StaticResource CpRewardCardTemplate}"
                              ItemsSource="{Binding PausedChannelPointRewardFormList}"/>
            </Grid>

            <Grid Grid.Column="2" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CpPaneTitleStyle}" VerticalAlignment="Center">
                            <Run Text="無効のCP  "/><Run Text="{Binding DisabledChannelPointRewardFormList.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <Button x:Name="ReloadButton" Grid.Column="1" Content="更新" Width="44"
                                Margin="5,0,0,0" HorizontalAlignment="Right"
                                Style="{StaticResource CpSecondaryButtonStyle}"
                                Click="ReloadButton_Click"/>
                    </Grid>
                    <ListView x:Name="DisabledChannelPointListView" Grid.Row="1" Tag="Disabled"
                              Style="{StaticResource CpCardListStyle}"
                              BorderBrush="#FF777777"
                              ItemTemplate="{StaticResource CpRewardCardTemplate}"
                              ItemsSource="{Binding DisabledChannelPointRewardFormList}"/>
            </Grid>
        </Grid>
        </Grid>
       </TabItem>

       <TabItem Header="プリセット管理"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <Grid Background="#FF404040">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>

         <Grid Grid.Column="0" Margin="8,4,0,8">
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
           </Grid.RowDefinitions>
                <TextBlock Text="プリセット一覧" Style="{StaticResource CpSectionTitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="※ダブルクリックで適用"
                           Style="{StaticResource CpDescriptionStyle}" Margin="0,0,0,6"/>
                <Border Grid.Row="2" MinHeight="160"
                        BorderBrush="#FF606060" BorderThickness="1">
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Bottom"
                            Content="＋ プリセットを追加" Height="30" Margin="4"
                            Padding="8,0" HorizontalContentAlignment="Left"
                            Foreground="White" Background="#FF285653"
                            BorderBrush="LightSeaGreen" BorderThickness="1"
                            Click="SavePresetButton_Click"
                            ToolTip="現在の報酬状態から新しいプリセットを追加します。"/>
                <ListBox x:Name="PresetComboBox"
                         Background="#FF404040" Foreground="White"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         Cursor="Arrow"
                         ItemsSource="{Binding ChannelPointPresetFormList}"
                         MouseDoubleClick="PresetComboBox_MouseDoubleClick"
                         SelectionChanged="PresetComboBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             GroupName="AppliedChannelPointPreset"
                                             IsChecked="{Binding IsApplied, Mode=OneWay}"
                                             IsHitTestVisible="False"
                                             ToolTip="現在適用されているプリセット"/>
                                <TextBlock Grid.Column="1" Text="{Binding PresetName}" Foreground="White"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Width="20" Height="20" Margin="5,0,0,0" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" Foreground="#FFFF6F78" BorderThickness="0"
                                        FontSize="16" Content="×" ToolTip="このプリセットを削除"
                                        Tag="{Binding}" Click="DeletePresetButton_Click"
                                        PreviewMouseDoubleClick="PresetDeleteButton_PreviewMouseDoubleClick"/>
                            </Grid>
                            <Border Height="2" Background="White"/>
                          </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                  </DockPanel>
                </Border>
         </Grid>

         <Grid Grid.Column="2" Margin="0,4,8,8">
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
           </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PresetDetailTitleTextBlock"
                                   Text="プリセットを選択してください"
                                   Style="{StaticResource CpSectionTitleStyle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="PresetDetailNameTextBox"
                                 Visibility="Collapsed" Width="300" Height="28" Padding="5,0"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="PresetNameEditButton"
                                Content="✎" Width="30" Height="28" Margin="4,0,0,0"
                                IsEnabled="False"
                                Foreground="White"
                                ToolTip="プリセット名を編集"
                                Click="PresetNameEditButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="Content" Value="✓">
                                            <Setter Property="Background" Value="#FF565656"/>
                                            <Setter Property="BorderBrush" Value="#FF777777"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="カテゴリ管理" Width="90" Height="26" Margin="8,0,0,0"
                                Style="{StaticResource CpSecondaryButtonStyle}"
                                ToolTip="カテゴリの追加・編集・削除"
                                Click="OpenCategoryManagementButton_Click"/>
                        <Button x:Name="UpdatePresetContentButton"
                                Content="更新" Width="44" Margin="5,0,0,0"
                                Style="{StaticResource CpSecondaryButtonStyle}"
                                IsEnabled="False"
                                ToolTip="現在の操作可能なCPをプリセット内容に反映"
                                Click="UpdatePresetContentButton_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="※ プリセット内容には、アプリ側で複製したCPのみ表示されます。"
                           Style="{StaticResource CpDescriptionStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PresetDetailStatus" Grid.Row="1"
                       Style="{StaticResource CpDescriptionStyle}" Margin="0,0,0,6"
                       VerticalAlignment="Center"
                       Text="プリセットを選択すると内容が表示されます。"/>
            <ListView x:Name="PresetItemListView" Grid.Row="2"
                      Background="#FF404040" Foreground="White"
                      ItemsSource="{Binding ChannelPointPresetItemFormList}"
                      Visibility="Collapsed"
                      SizeChanged="PresetItemListView_SizeChanged">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#FF565656"/>
                        <Setter Property="BorderBrush" Value="#FF777777"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="Click" Handler="PresetItemColumnHeader_Click"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border x:Name="HeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FF626262"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FF344D4B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBackground"
                                            Background="#FF474747"
                                            BorderBrush="#FF606060"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                              Content="{TemplateBinding Content}"
                                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBackground" Property="Background" Value="#FF505656"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBackground" Property="Background" Value="#FF344D4B"/>
                                            <Setter TargetName="ItemBackground" Property="BorderBrush" Value="LightSeaGreen"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="44">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="有効" Tag="IsActiveState"
                                                      ToolTip="クリックで並べ替え"
                                                      HorizontalContentAlignment="Center"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="44">
                                        <RadioButton GroupName="{Binding RewardId}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsActiveState, Mode=TwoWay}"
                                                     Click="PresetItemStateRadioButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="44">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="停止" Tag="IsPausedState"
                                                      ToolTip="クリックで並べ替え"
                                                      HorizontalContentAlignment="Center"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="44">
                                        <RadioButton GroupName="{Binding RewardId}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsPausedState, Mode=TwoWay}"
                                                     Click="PresetItemStateRadioButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="44">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="無効" Tag="IsDisabledState"
                                                      ToolTip="クリックで並べ替え"
                                                      HorizontalContentAlignment="Center"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="44">
                                        <RadioButton GroupName="{Binding RewardId}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsDisabledState, Mode=TwoWay}"
                                                     Click="PresetItemStateRadioButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="PresetRewardNameColumn" Width="320"
                                        DisplayMemberBinding="{Binding RewardTitle}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="報酬名" Tag="RewardTitle"
                                                      ToolTip="クリックで並べ替え"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="82">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="CPコスト" Tag="Cost"
                                                      ToolTip="クリックで並べ替え"
                                                      HorizontalContentAlignment="Center"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Width="70" Margin="0,0,8,0"
                                               Text="{Binding Cost, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Right" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
         </Grid>
        </Grid>
       </TabItem>
      </TabControl>
    </Grid>
</UserControl>

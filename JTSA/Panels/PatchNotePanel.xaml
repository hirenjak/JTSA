<UserControl x:Class="JTSA.Panels.PatchNotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF404040">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="パッチノート"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
                <TextBlock Text="JTSAの追加機能と変更内容"
                           Foreground="LightGray"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#FF2B2B2B"
                    BorderBrush="LightSeaGreen"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentVersion, StringFormat=現在のバージョン  v{0}}"
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding PatchNotes}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF303030"
                            BorderBrush="#FF606060"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,12"
                            Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="LightSeaGreen" CornerRadius="3" Padding="8,3">
                                    <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ReleaseDate}"
                                           Foreground="LightGray"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Changes}" Margin="4,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0}}"
                                                   Foreground="#FFE8E8E8"
                                                   FontSize="13"
                                                   Margin="0,3,0,3"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

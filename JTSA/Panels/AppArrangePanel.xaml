<UserControl x:Class="JTSA.Panels.AppArrangePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF404040">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="一括起動" Width="88" Margin="0,0,6,0" Click="StartAllButton_Click"/>
            <Button Content="一括配置" Width="88" Margin="0,0,6,0" Click="MoveAllButton_Click"/>
            <Button Content="一括停止" Width="88" Margin="0,0,12,0" Click="StopAllButton_Click"/>
            <CheckBox x:Name="AutoStartCheckBox"
                      Content="JTSA起動時に登録済みアプリを自動起動"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      Checked="AutoStartCheckBox_Changed"
                      Unchecked="AutoStartCheckBox_Changed"/>
            <TextBlock Text="起動中のウィンドウを右側から登録できます" Foreground="LightGray" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="登録済みアプリ" Foreground="White" FontSize="15" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding RegisteredApps}" Background="#FF404040"
                         BorderBrush="DimGray" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status, StringFormat=  [{0}]}" Foreground="LightGreen" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding WindowTitle}" Foreground="LightGray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppExePath, StringFormat=Path: {0}}"
                                               Foreground="Silver"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding AppExePath}"/>
                                    <TextBlock Foreground="DarkGray" FontSize="11">
                                        <Run Text="位置: "/><Run Text="{Binding X}"/><Run Text=", "/><Run Text="{Binding Y}"/>
                                        <Run Text="  サイズ: "/><Run Text="{Binding Width}"/><Run Text=" × "/><Run Text="{Binding Height}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="起動/配置" Margin="4,0" Padding="7,3" Click="StartOrMoveButton_Click"/>
                                    <Button Content="位置保存" Margin="4,0" Padding="7,3" Click="SavePositionButton_Click"/>
                                    <Button Content="Path" Margin="4,0" Padding="7,3" Click="SetPathButton_Click"/>
                                    <Button Content="停止" Margin="4,0" Padding="7,3" Click="StopButton_Click"/>
                                    <Button Content="削除" Margin="4,0" Padding="7,3" Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button Content="再読込" DockPanel.Dock="Right" Padding="10,2" Click="ReloadRunningButton_Click"/>
                    <TextBlock Text="起動中アプリ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding RunningApps}" Background="#FF404040"
                         BorderBrush="DimGray" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding WindowTitle}" Foreground="LightGray" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="登録" Padding="10,3" Margin="6,0,0,0" Click="RegisterButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

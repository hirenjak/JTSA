<UserControl x:Class="JTSA.Panels.SettingPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        
        <!--Twitchアカウント管理-->
        <StackPanel
            Margin="8, 0, 8, 0">

            <Label 
                Content="Twitchアカウント"
                FontSize="20"
                Foreground="White"/>
            
            <StackPanel Margin="8,10,0,4" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock x:Name="NoRegisteredAccountTextBlock"
                           Text="登録済みアカウントはありません"
                           Foreground="Gray"/>
                <ItemsControl x:Name="RegisteredAccountItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF4A4747" BorderBrush="#FF666666"
                                    BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="8,5">
                                <Grid Width="520">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="サブ垢"/>
                                                <Setter Property="Foreground" Value="LightSkyBlue"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                        <Setter Property="Text" Value="メイン"/>
                                                        <Setter Property="Foreground" Value="LightGreen"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding UserName}"
                                               Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ID: " Foreground="DarkGray"/>
                                        <TextBlock Text="{Binding BroadcasterId}" Foreground="LightGray"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="再認証" Width="64" Height="22"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding Id}"
                                            Click="ReauthenticateAccountButton_Click"/>
                                    <Button Grid.Column="4" Content="削除" Width="64" Height="22"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding Id}"
                                            Click="DeleteAccountButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="AddSubAccountButton" Content="サブ垢を追加"
                        Width="96" Height="22" Margin="0,6,0,0"
                        HorizontalAlignment="Left"
                        Click="AddSubAccountButton_Click"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="認証コード" Foreground="LightGray"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SettingOAuthCodeBox"
                             Width="200" Height="24"
                             Foreground="White" FontSize="16"
                             Background="#FF4A4747" BorderBrush="White"
                             TextAlignment="Center" IsReadOnly="True"/>
                    <Button x:Name="SettingOAuthCodeCopyButton"
                            Width="64" Height="22" Margin="8,0,0,0"
                            FontSize="12" Content="Copy"/>
                </StackPanel>
            </StackPanel>

            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>

            <StackPanel Margin="0,8,0,0">
                <Label Content="X投稿文"
                       Padding="4,0"
                       FontSize="20"
                       Foreground="White"/>
                <TextBlock Margin="4,4,0,8"
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           Text="利用可能なプレースホルダー： {title} 配信タイトル / {category} 配信カテゴリ / {url} Twitch URL"/>
                <TextBox x:Name="XPostTemplateTextBox"
                         Margin="8,0,0,0"
                         MinHeight="96"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <Button x:Name="SaveXPostTemplateButton"
                            Content="保存"
                            Width="64" Height="22"
                            Click="SaveXPostTemplateButton_Click"/>
                    <Button Content="初期値に戻す"
                            Width="96" Height="22"
                            Margin="8,0,0,0"
                            Click="ResetXPostTemplateButton_Click"/>
                </StackPanel>
            </StackPanel>

            <Border
                Margin="0, 12, 0, 0"
                Width="Auto" Height="2"
                Background="White"/>

            <StackPanel x:Name="ObsConnectionSettingsHost" Margin="0,8,0,0"/>

            <Border
                Margin="0, 12, 0, 0"
                Width="Auto" Height="2"
                Background="White"/>

            <StackPanel Margin="0,8,0,0">
                <Label Content="チャット読み上げ連携"
                       Padding="4,0"
                       FontSize="20"
                       Foreground="White"/>
                <RadioButton x:Name="SpeechDisabledRadioButton"
                          Content="読み上げない"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <RadioButton x:Name="BouyomiEnabledRadioButton"
                          Content="棒読みちゃん"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <RadioButton x:Name="VoiceVoxEnabledRadioButton"
                          Content="VOICEVOX"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <TextBlock Text="棒読みちゃん HTTP URL"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <TextBox x:Name="BouyomiEndpointTextBox"
                         Margin="8,0,0,0"
                         Padding="4"
                         Text="http://localhost:50080/"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <TextBlock Text="VOICEVOX Engine URL"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <TextBox x:Name="VoiceVoxEndpointTextBox"
                         Margin="8,0,0,0"
                         Padding="4"
                         Text="http://localhost:50021/"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <TextBlock Text="VOICEVOX 話者"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <ComboBox x:Name="VoiceVoxSpeakerComboBox"
                              Width="240"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"/>
                    <Button Content="一覧を更新"
                            Width="80" Height="22"
                            Margin="8,0,0,0"
                            Click="RefreshVoiceVoxSpeakersButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <Button Content="保存"
                            Width="64" Height="22"
                            Click="SaveSpeechButton_Click"/>
                    <Button Content="テスト"
                            Width="64" Height="22"
                            Margin="8,0,0,0"
                            Click="TestSpeechButton_Click"/>
                </StackPanel>
            </StackPanel>

            <Border
                Margin="0, 12, 0, 0"
                Width="Auto" Height="2"
                Background="White"/>

                <StackPanel
                Margin="0, 8, 0, 0">

                <Label 
                    Content="DBファイル位置"
                    FontSize="20"
                    Foreground="White"/>
                
                <Button
                    Content="DBフォルダを開く" 
                    Margin="8, 0, 0, 0" 
                    Width="100" Height="20" 
                    HorizontalAlignment="Left"
                    Click="DBFolderOpen"/>
            </StackPanel>

            <Border Margin="0,24,0,12"
                    Padding="0,12,0,0"
                    BorderBrush="#FF666666"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Credits"
                               HorizontalAlignment="Center"
                               Foreground="LightGray"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <!-- 表示名と配信URLは、以下の各Hyperlinkを直接編集してください。 -->
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="DarkGray"
                               FontSize="12"
                               Margin="0,2">
                        【メイン制作者】緋蓮じゃく - hirenjak
                        <Hyperlink NavigateUri="https://www.twitch.tv/hiren_jak"
                                   RequestNavigate="CreditLink_RequestNavigate">Twitchリンク</Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                            Foreground="DarkGray"
                            FontSize="12"
                            Margin="0,2">
                        【共同制作者】さいふ - Xiphelier
                        <Hyperlink NavigateUri="https://www.twitch.tv/xiphelier"
                                   RequestNavigate="CreditLink_RequestNavigate">Twitchリンク</Hyperlink>
                        </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                            Foreground="DarkGray"
                            FontSize="12"
                            Margin="0,2">
                        【アイコン制作】波乱 - haran
                    </TextBlock>

                    <TextBlock Text="JTSA © 2026 緋蓮じゃく"
                            HorizontalAlignment="Center"
                            Foreground="DarkGray"
                            FontSize="12"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>

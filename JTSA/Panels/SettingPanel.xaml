<UserControl x:Class="JTSA.Panels.SettingPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        
        <!--OAuth再認証-->
        <StackPanel
            Margin="8, 0, 8, 0">

            <Label 
                Content="OAuth再認証"
                FontSize="20"
                Foreground="White"/>

            <Grid Margin="8,0,0,8" MaxWidth="560" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Twitch名" Foreground="LightGray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="UserNameTextBlock" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="アクセストークン" Foreground="LightGray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="AccessTokenStatusTextBlock" Text="NG" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="ブロードキャスターID" Foreground="LightGray" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="BroadcasterIdStatusTextBlock" Text="NG" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
            
            <StackPanel Orientation="Horizontal">

                <Button 
                    x:Name="ReOAuthButton" Content="認証" 
                    Width="64" Height="20" 
                    Margin="8, 0, 0, 0" 
                    HorizontalAlignment="Left"/>

                <TextBox 
                    x:Name="SettingOAuthCodeBox"
                    Margin="8, 0, 0, 0"
                    Width="200" Height="Auto"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True"/>

                <Button 
                    x:Name="SettingOAuthCodeCopyButton"
                    Width="64" Height="20" 
                    Margin="8, 0, 0, 0"
                    FontSize="12" 
                    Content="Copy"/>
            </StackPanel>

            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>

            <StackPanel Margin="0,8,0,0">
                <Label Content="X投稿文"
                       Padding="4,0"
                       FontSize="20"
                       Foreground="White"/>
                <TextBlock Margin="4,4,0,8"
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           Text="利用可能なプレースホルダー： {title} 配信タイトル / {category} 配信カテゴリ / {url} Twitch URL"/>
                <TextBox x:Name="XPostTemplateTextBox"
                         Margin="8,0,0,0"
                         MinHeight="96"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <Button x:Name="SaveXPostTemplateButton"
                            Content="保存"
                            Width="64" Height="22"
                            Click="SaveXPostTemplateButton_Click"/>
                    <Button Content="初期値に戻す"
                            Width="96" Height="22"
                            Margin="8,0,0,0"
                            Click="ResetXPostTemplateButton_Click"/>
                </StackPanel>
            </StackPanel>

            <Border
                Margin="0, 12, 0, 0"
                Width="Auto" Height="2"
                Background="White"/>

            <StackPanel Margin="0,8,0,0">
                <Label Content="チャット読み上げ連携"
                       Padding="4,0"
                       FontSize="20"
                       Foreground="White"/>
                <RadioButton x:Name="SpeechDisabledRadioButton"
                          Content="読み上げない"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <RadioButton x:Name="BouyomiEnabledRadioButton"
                          Content="棒読みちゃん"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <RadioButton x:Name="VoiceVoxEnabledRadioButton"
                          Content="VOICEVOX"
                          Margin="8,4,0,0"
                          Foreground="White"/>
                <TextBlock Text="棒読みちゃん HTTP URL"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <TextBox x:Name="BouyomiEndpointTextBox"
                         Margin="8,0,0,0"
                         Padding="4"
                         Text="http://localhost:50080/"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <TextBlock Text="VOICEVOX Engine URL"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <TextBox x:Name="VoiceVoxEndpointTextBox"
                         Margin="8,0,0,0"
                         Padding="4"
                         Text="http://localhost:50021/"
                         Foreground="White"
                         Background="#FF4A4747"
                         BorderBrush="White"/>
                <TextBlock Text="VOICEVOX 話者"
                           Margin="8,8,0,2"
                           Foreground="LightGray"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <ComboBox x:Name="VoiceVoxSpeakerComboBox"
                              Width="240"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"/>
                    <Button Content="一覧を更新"
                            Width="80" Height="22"
                            Margin="8,0,0,0"
                            Click="RefreshVoiceVoxSpeakersButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <Button Content="保存"
                            Width="64" Height="22"
                            Click="SaveSpeechButton_Click"/>
                    <Button Content="テスト"
                            Width="64" Height="22"
                            Margin="8,0,0,0"
                            Click="TestSpeechButton_Click"/>
                </StackPanel>
            </StackPanel>

            <Border
                Margin="0,12,0,0"
                Width="Auto" Height="2"
                Background="White"/>

            <StackPanel
                Margin="0, 8, 0, 0">

                <Label 
                    Content="DBファイル位置"
                    FontSize="20"
                    Foreground="White"/>
                
                <Button
                    Content="DBフォルダを開く" 
                    Margin="8, 0, 0, 0" 
                    Width="100" Height="20" 
                    HorizontalAlignment="Left"
                    Click="DBFolderOpen"/>
            </StackPanel>

            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>

            <StackPanel>

                <Label 
                    Content="OBS側ソース連携設定"
                    FontSize="20"
                    Foreground="White"/>
                
                <Label 
                    Content="OBSのブラウザソースに以下のURLを設定してください。"
                    Foreground="White"/>
                <Label 
                    Content="チャット表示"
                    Margin="4, -8, 0, -4"
                    FontSize="14"
                    Foreground="White"/>

                <TextBox 
                    Text="http://localhost:8026/chat"
                    Width="Auto" 
                    Margin="8, 0, 0, 0"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True" 
                    Height="Auto"/>

                <Label 
                    Content="ゲームプレイリスト表示"
                    Margin="4, 0, 0, -4"
                    FontSize="14"
                    Foreground="White"/>

                <TextBox 
                    Text="http://localhost:8026/obs"
                    Width="Auto" 
                    Margin="8, 0, 0, 0"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True" 
                    Height="Auto"/>

                <Label 
                    Content="配信拡張画像出力"
                    Margin="4, 0, 0, -4"
                    FontSize="14"
                    Foreground="White"/>

                <TextBox 
                    Text="http://localhost:8026/expansion"
                    Width="Auto" 
                    Margin="8, 0, 0, 0"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True" 
                    Height="Auto"/>
                <Label 
                    Content="背景は透明です。画像はトリガー実行時に5秒間表示されます。"
                    Foreground="White"/>
            </StackPanel>


            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>

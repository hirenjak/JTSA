<UserControl x:Class="JTSA.Panels.SettingPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            Background="#FF404040">
    <StackPanel>
        
        <!--OAuth再認証-->
        <StackPanel
            Margin="8, 0, 8, 0">

            <Label 
                Content="OAuth再認証"
                FontSize="20"
                Foreground="White"/>
            
            <StackPanel Orientation="Horizontal">

                <Button 
                    x:Name="ReOAuthButton" Content="認証" 
                    Width="64" Height="20" 
                    Margin="8, 0, 0, 0" 
                    HorizontalAlignment="Left"/>

                <TextBox 
                    x:Name="SettingOAuthCodeBox"
                    Margin="8, 0, 0, 0"
                    Width="200" Height="Auto"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True"/>

                <Button 
                    x:Name="SettingOAuthCodeCopyButton"
                    Width="64" Height="20" 
                    Margin="8, 0, 0, 0"
                    FontSize="12" 
                    Content="Copy"/>
            </StackPanel>

            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>

            <StackPanel
                Margin="0, 8, 0, 0">

                <Label 
                    Content="DBファイル位置"
                    FontSize="20"
                    Foreground="White"/>
                
                <Button
                    Content="DBフォルダを開く" 
                    Margin="8, 0, 0, 0" 
                    Width="100" Height="20" 
                    HorizontalAlignment="Left"
                    Click="DBFolderOpen"/>
            </StackPanel>

            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>

            <StackPanel>

                <Label 
                    Content="OBS側ソース連携設定"
                    FontSize="20"
                    Foreground="White"/>
                
                <Label 
                    Content="配信拡張画像出力ブラウザソース"
                    Margin="4, -8, 0, -4"
                    FontSize="14"
                    Foreground="White"/>

                <Label 
                    Content="OBSのブラウザソースに以下のURLを設定してください。"
                    Foreground="White"/>
                <TextBox 
                    Text="http://localhost:8026/expansion"
                    Width="Auto" 
                    Margin="8, 0, 0, 0"
                    Foreground="White" FontSize="16" 
                    Background="#FF4A4747" BorderBrush="White" 
                    TextAlignment="Center" 
                    IsReadOnly="True" 
                    Height="Auto"/>
                <Label 
                    Content="背景は透明です。画像はトリガー実行時に5秒間表示されます。"
                    Foreground="White"/>
            </StackPanel>


            <Border 
                Margin="0, 4, 0, 0"
                Width="Auto" Height="2" 
                Background="White"/>
        </StackPanel>
    </StackPanel>
</UserControl>

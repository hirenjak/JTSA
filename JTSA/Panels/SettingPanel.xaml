<UserControl x:Class="JTSA.Panels.SettingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FF404040">
 <UserControl.Resources>
  <Style x:Key="SettingNavigationTabStyle" TargetType="TabItem">
   <Setter Property="Width" Value="148"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Foreground" Value="#FFD0D0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavBackground" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF454B4B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#FF344D4B"/><Setter TargetName="NavBackground" Property="BorderBrush" Value="LightSeaGreen"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="SettingCardStyle" TargetType="Border"><Setter Property="Background" Value="#FF474747"/><Setter Property="BorderBrush" Value="#FF666666"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="12"/></Style>
 </UserControl.Resources>
 <Grid Margin="8,4,8,8" Background="#FF303030">
  <TabControl TabStripPlacement="Left" ItemContainerStyle="{StaticResource SettingNavigationTabStyle}" Background="#FF383838" BorderBrush="#FF5E5E5E" BorderThickness="1">
   <TabItem Header="Twitchアカウント"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12">
    <TextBlock Text="Twitchアカウント" Style="{StaticResource SettingTitleStyle}"/>
    <Border Style="{StaticResource SettingCardStyle}" MaxWidth="590" HorizontalAlignment="Left"><StackPanel>
     <TextBlock x:Name="NoRegisteredAccountTextBlock" Text="登録済みアカウントはありません" Foreground="Gray"/>
     <ItemsControl x:Name="RegisteredAccountItemsControl"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FF4A4747" BorderBrush="#FF666666" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="8,5"><Grid Width="520"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="サブ垢"/><Setter Property="Foreground" Value="LightSkyBlue"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Text" Value="メイン"/><Setter Property="Foreground" Value="LightGreen"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Grid.Column="1" Text="{Binding UserName}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ID: " Foreground="DarkGray"/><TextBlock Text="{Binding BroadcasterId}" Foreground="LightGray"/></StackPanel>
      <Button Grid.Column="3" Content="再認証" Width="64" Height="22" Tag="{Binding Id}" Click="ReauthenticateAccountButton_Click"/><Button Grid.Column="4" Content="削除" Width="64" Height="22" Tag="{Binding Id}" Click="DeleteAccountButton_Click"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button x:Name="AddSubAccountButton" Content="サブ垢を追加" Width="96" Height="22" Margin="0,6,0,0" HorizontalAlignment="Left" Click="AddSubAccountButton_Click"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="認証コード" Foreground="LightGray" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="SettingOAuthCodeBox" Width="200" Height="24" Foreground="White" FontSize="16" Background="#FF4A4747" BorderBrush="White" TextAlignment="Center" IsReadOnly="True"/><Button x:Name="SettingOAuthCodeCopyButton" Width="64" Height="22" Margin="8,0,0,0" Content="Copy"/></StackPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>

   <TabItem Header="投稿設定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12"><TextBlock Text="X投稿文" Style="{StaticResource SettingTitleStyle}"/><Border Style="{StaticResource SettingCardStyle}"><StackPanel>
    <TextBlock Foreground="LightGray" TextWrapping="Wrap" Margin="0,0,0,8" Text="利用可能なプレースホルダー： {title} 配信タイトル / {category} 配信カテゴリ / {category_ja} カテゴリ名（日本語） / {url} Twitch URL"/>
    <TextBox x:Name="XPostTemplateTextBox" MinHeight="110" Padding="6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="White" Background="#FF4A4747" BorderBrush="White"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="SaveXPostTemplateButton" Content="保存" Width="64" Height="22" Click="SaveXPostTemplateButton_Click"/><Button Content="初期値に戻す" Width="96" Height="22" Margin="8,0,0,0" Click="ResetXPostTemplateButton_Click"/></StackPanel>
   </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

   <TabItem Header="読み上げ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12"><TextBlock Text="チャット読み上げ連携" Style="{StaticResource SettingTitleStyle}"/><Border Style="{StaticResource SettingCardStyle}" MaxWidth="650" HorizontalAlignment="Left"><StackPanel>
    <RadioButton x:Name="SpeechDisabledRadioButton" Content="読み上げない" Margin="0,4,0,0" Foreground="White"/><RadioButton x:Name="BouyomiEnabledRadioButton" Content="棒読みちゃん" Margin="0,6,0,0" Foreground="White"/><RadioButton x:Name="VoiceVoxEnabledRadioButton" Content="VOICEVOX" Margin="0,6,0,0" Foreground="White"/>
    <TextBlock Text="棒読みちゃん HTTP URL" Margin="0,12,0,2" Foreground="LightGray"/><TextBox x:Name="BouyomiEndpointTextBox" Padding="4" Text="http://localhost:50080/" Foreground="White" Background="#FF4A4747" BorderBrush="White"/>
    <TextBlock Text="VOICEVOX Engine URL" Margin="0,10,0,2" Foreground="LightGray"/><TextBox x:Name="VoiceVoxEndpointTextBox" Padding="4" Text="http://localhost:50021/" Foreground="White" Background="#FF4A4747" BorderBrush="White"/>
    <TextBlock Text="VOICEVOX 話者" Margin="0,10,0,2" Foreground="LightGray"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="VoiceVoxSpeakerComboBox" Width="240" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/><Button Content="一覧を更新" Width="80" Height="22" Margin="8,0,0,0" Click="RefreshVoiceVoxSpeakersButton_Click"/></StackPanel>
    <TextBlock Text="読み上げないアカウント" Margin="0,12,0,2" Foreground="LightGray"/>
    <TextBlock Text="Twitchのログイン名を1行に1つ。チャットタブの参加者リストからも切り替えできます。" Foreground="DarkGray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBox x:Name="SpeechMutedUserLoginsTextBox" MinHeight="90" Padding="4" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="White" Background="#FF4A4747" BorderBrush="White"/>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="保存" Width="64" Height="22" Click="SaveSpeechButton_Click"/><Button Content="テスト" Width="64" Height="22" Margin="8,0,0,0" Click="TestSpeechButton_Click"/></StackPanel>
   </StackPanel></Border></StackPanel></ScrollViewer></TabItem>

   <TabItem Header="その他"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12"><TextBlock Text="その他" Style="{StaticResource SettingTitleStyle}"/>
    <Border Style="{StaticResource SettingCardStyle}"><StackPanel><TextBlock Text="DBファイル位置" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><Button Content="DBフォルダを開く" Width="112" Height="24" HorizontalAlignment="Left" Click="DBFolderOpen"/></StackPanel></Border>
    <Border Margin="0,18,0,0" Padding="12" BorderBrush="#FF666666" BorderThickness="1" CornerRadius="3"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Credits" Foreground="LightGray" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/><TextBlock Foreground="DarkGray" FontSize="12" Margin="0,2">【メイン制作者】緋蓮じゃく - hirenjak <Hyperlink NavigateUri="https://www.twitch.tv/hiren_jak" RequestNavigate="CreditLink_RequestNavigate">Twitchリンク</Hyperlink></TextBlock><TextBlock Foreground="DarkGray" FontSize="12" Margin="0,2">【共同制作者】さいふ - Xiphelier <Hyperlink NavigateUri="https://www.twitch.tv/xiphelier" RequestNavigate="CreditLink_RequestNavigate">Twitchリンク</Hyperlink></TextBlock><TextBlock Text="【アイコン制作】波乱 - haran" Foreground="DarkGray" FontSize="12" Margin="0,2"/><TextBlock Text="JTSA © 2026 緋蓮じゃく" Foreground="DarkGray" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>

<Window x:Class="JTSA.CustomPlaylistGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ゲームを追加" Icon="Resources/jtsa.ico"
        Width="470" Height="282" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#FF303030">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:CategoryStyleTitleBar/>
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="カテゴリに存在しないゲームをプレイリストへ追加します。"
                           Foreground="White" Margin="0,0,0,14"/>
                <TextBlock Grid.Row="1" Text="ゲーム名（必須）" Foreground="White"/>
                <TextBox x:Name="GameNameTextBox" Grid.Row="2" Height="28" Margin="0,4,0,12"
                         MaxLength="200" PreviewKeyDown="InputTextBox_PreviewKeyDown">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="切り取り" Command="ApplicationCommands.Cut"/>
                            <MenuItem Header="コピー" Command="ApplicationCommands.Copy"/>
                            <MenuItem Header="貼り付け" Click="PasteMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="すべて選択" Command="ApplicationCommands.SelectAll"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="Steam URL（任意）" Foreground="White"/>
                    <TextBox x:Name="SteamUrlTextBox" Height="28" Margin="0,4,0,0" MaxLength="2000"
                             PreviewKeyDown="InputTextBox_PreviewKeyDown">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="切り取り" Command="ApplicationCommands.Cut"/>
                                <MenuItem Header="コピー" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="貼り付け" Click="PasteMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="すべて選択" Command="ApplicationCommands.SelectAll"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                    <TextBlock Text="Steamストアの商品ページURLから画像を取得します。"
                               Foreground="LightGray" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="追加" Width="90" Height="30" IsDefault="True"
                            Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen"
                            BorderThickness="1" Click="AddButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="JTSA.StreamExpansionTriggerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JTSA.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="実行タイミング設定" Icon="Resources/jtsa.ico"
        Width="760" Height="520" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF303030">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#FF666666" BorderThickness="1" Background="#FF303030">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <controls:CategoryStyleTitleBar/>
   <DockPanel Grid.Row="1" Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
     <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"
             Foreground="White" Background="#FF565656" BorderBrush="#FF777777" BorderThickness="1"/>
     <Button Content="反映" Width="90" Height="30" IsDefault="True"
             Foreground="White" Background="#FF285653" BorderBrush="LightSeaGreen" BorderThickness="1"
             Click="ApplyButton_Click"/>
    </StackPanel>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="実行遅延（秒）" Foreground="White" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Height="24" Padding="5,2" Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"/>
     </Grid>
     <TextBlock Grid.Row="1" Text="実行するタイミング" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
     <WrapPanel Grid.Row="2" Margin="8,0,0,10">
      <CheckBox Content="レイド起動" Foreground="White" Margin="0,0,20,0" IsChecked="{Binding IsRaid}"/>
      <CheckBox Content="サブスク起動" Foreground="White" Margin="0,0,20,0" IsChecked="{Binding IsSubscribe}"/>
      <CheckBox Content="ビッツ起動" Foreground="White" Margin="0,0,20,0" IsChecked="{Binding IsBits}"/>
      <CheckBox Content="チャット入室時" Foreground="White" Margin="0,0,20,0" IsChecked="{Binding IsFirstChat}"/>
      <CheckBox Content="時報（毎時00分）" Foreground="White" Margin="0,0,20,8" IsChecked="{Binding IsHourly}" ToolTip="PCの時刻を基準に、JTSA起動中は配信状態にかかわらず毎時00分に実行します。"/>
      <CheckBox Content="フォロー時" Foreground="White" IsChecked="{Binding IsFollow}"/>
     </WrapPanel>
     <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="配信開始時" Foreground="White" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <CheckBox Content="メインOBS" Foreground="White" IsChecked="{Binding IsObsStreamStartMain}"/>
       <CheckBox Content="サブOBS" Foreground="White" Margin="18,0,0,0" IsChecked="{Binding IsObsStreamStartSub}"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="4" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="チャンネルポイント" Foreground="White" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" Height="24"
                ItemsSource="{Binding ChannelPoints}" DisplayMemberPath="DisplayName" SelectedValuePath="RewardId"
                SelectedValue="{Binding TriggerChannelPointId, Mode=TwoWay}"/>
     </Grid>
     <StackPanel Grid.Row="5">
      <WrapPanel Margin="0,0,0,12">
       <CheckBox Content="CM開始" Foreground="White" Margin="0,0,16,0" IsChecked="{Binding IsAdStart}"/>
       <CheckBox Content="CM終了予定" Foreground="White" Margin="0,0,16,0" IsChecked="{Binding IsAdEnd}"/>
       <CheckBox x:Name="AdUpcomingCheck" Content="CM開始前" Foreground="White" Margin="0,0,8,0" IsChecked="{Binding IsAdUpcoming}"/>
       <ComboBox Width="55" ItemsSource="{Binding AdAdvanceOptions}" SelectedItem="{Binding AdAdvanceMinutes}" IsEnabled="{Binding IsChecked, ElementName=AdUpcomingCheck}"/>
       <TextBlock Text=" 分前" Foreground="White"/>
      </WrapPanel>
      <TextBlock Text="CM通知はTwitch再認証が必要です。終了は推定、予告は自動CMの予定に基づきます。" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <CheckBox x:Name="ScheduledTimeCheckBox" Content="指定時刻（毎日）" Width="145" Foreground="White" VerticalAlignment="Center" IsChecked="{Binding IsScheduledTime}"/>
       <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ScheduledTimeCheckBox}">
        <ComboBox Width="65" Height="26" ItemsSource="{Binding Hours}" SelectedItem="{Binding ScheduledHour, Mode=TwoWay}" ItemStringFormat="{}{0:00}"/>
        <TextBlock Text="時" Foreground="White" Margin="6,0,12,0" VerticalAlignment="Center"/>
        <ComboBox Width="65" Height="26" ItemsSource="{Binding Minutes}" SelectedItem="{Binding ScheduledMinute, Mode=TwoWay}" ItemStringFormat="{}{0:00}"/>
        <TextBlock Text="分" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="トリガーコメント" Foreground="White" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Height="28" Padding="5,2" Text="{Binding TriggerComment, UpdateSourceTrigger=PropertyChanged}"/>
     </Grid>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </Border>
</Window>
